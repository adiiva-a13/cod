//@version=5
strategy("AdiivaMSS", overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=2,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     calc_on_every_tick=false)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
grp1 = "Range Settings"
minRangeBars    = input.int(5,    "Minim candele range (MSS valid)", minval=2, maxval=50, group=grp1,
     tooltip="Prima lumanare face MSS. Range-ul trebuie sa aiba minim acest numar de candele in spate.")
minSwingBars    = input.int(3,    "Minim candele bullish/bearish la swing high/low", minval=1, maxval=10, group=grp1,
     tooltip="HIGH valid: minim N candele bullish consecutive inainte de high. LOW valid: minim N bearish.")
zoneBuffer      = input.float(0.1,"Buffer zona retest (%)",        minval=0.0, step=0.05, group=grp1)
maxWaitBars     = input.int(100,  "Max bare asteptare retest",     minval=10,  maxval=500, group=grp1,
     tooltip="Daca retestul nu vine in acest numar de bare, MSS-ul se reseteaza si se cauta urmatorul.")
showBoxes       = input.bool(true, "Afiseaza Range Boxes",         group=grp1)

grp2 = "Trade Management"
tp1Ratio        = input.float(1.0, "TP1 RR (runner la BE)",        minval=0.5, step=0.5, group=grp2)
tp1ClosePct     = input.float(80,  "% pozitie inchisa la TP1",     minval=50, maxval=95, group=grp2)
slBufferPct     = input.float(0.05,"SL buffer deasupra High (%)",  minval=0.0, step=0.05, group=grp2)

grp3 = "Filters"
tradeShorts     = input.bool(true,  "Trade SHORT",  group=grp3)
tradeLongs      = input.bool(true,  "Trade LONG",   group=grp3)
// ── Filtru 1: VWAP Weekly ──────────────────────────────────────────────────
useVWAP         = input.bool(false, "Filtru VWAP Weekly (trend bias)", group=grp3,
     tooltip="ON: SHORT doar sub VWAP weekly, LONG doar deasupra VWAP weekly.")
showVWAP        = input.bool(true,  "Afiseaza VWAP Weekly pe grafic",  group=grp3)
// ── Filtru 2: HTF MSS Bias ─────────────────────────────────────────────────
useHTF          = input.bool(false, "Filtru HTF MSS Bias",             group=grp3,
     tooltip="ON: SHORT doar daca ultimul BOS pe HTF e bearish, LONG doar daca e bullish. Nu activa ambele filtre simultan.")
htfTimeframe    = input.timeframe("60", "HTF Timeframe (ex: 60=1H)",   group=grp3)
htfLookback     = input.int(20, "HTF Lookback bare swing",             minval=5, maxval=100, group=grp3,
     tooltip="Numarul de bare HTF folosit pentru a detecta swing high/low pe timeframe-ul superior.")

grp4 = "Fereastra Orara  (ora Romaniei, DST automat)"
useTimeWindow   = input.bool(true,  "Filtru fereastra orara activ",      group=grp4)
twStart         = input.string("0800", "Start (ora Romaniei)",           group=grp4)
twEnd           = input.string("2100", "End   (ora Romaniei)",           group=grp4)
maxTradesPerDay = input.int(2,      "Max trade-uri pe zi",               minval=1, maxval=10, group=grp4)
showSessionBg   = input.bool(true,  "Afiseaza fond fereastra orara",     group=grp4)

// ─────────────────────────────────────────────
// FILTRU 1: VWAP WEEKLY
// ─────────────────────────────────────────────
weeklyVWAP   = ta.vwap(hlc3, timeframe.change("W"))
aboveVWAP    = close > weeklyVWAP
belowVWAP    = close < weeklyVWAP

vwapOkShort  = not useVWAP or belowVWAP
vwapOkLong   = not useVWAP or aboveVWAP

plot(showVWAP ? weeklyVWAP : na, title="VWAP Weekly",
     color=aboveVWAP ? color.new(#00CC88, 20) : color.new(#FF4444, 20),
     linewidth=2, style=plot.style_line)

// ─────────────────────────────────────────────
// FILTRU 2: HTF MSS BIAS
// Detecteaza BOS (Break of Structure) pe timeframe superior
// Bullish BOS: HTF close rupe deasupra swing high-ului din ultimele N bare
// Bearish BOS: HTF close rupe sub swing low-ul din ultimele N bare
// ─────────────────────────────────────────────
htfSwH      = request.security("", htfTimeframe, ta.highest(high, htfLookback)[1], lookahead=barmerge.lookahead_off)
htfSwL      = request.security("", htfTimeframe, ta.lowest(low,  htfLookback)[1], lookahead=barmerge.lookahead_off)
htfClose    = request.security("", htfTimeframe, close, lookahead=barmerge.lookahead_off)

htfBullish  = htfClose > htfSwH   // HTF a spart swing high → bias LONG
htfBearish  = htfClose < htfSwL   // HTF a spart swing low  → bias SHORT

htfOkShort  = not useHTF or htfBearish
htfOkLong   = not useHTF or htfBullish

// ─────────────────────────────────────────────
// FEREASTRA ORARA  (Europa/Bucharest = DST automat)
// ─────────────────────────────────────────────
inTimeWindow = not na(time(timeframe.period, twStart + "-" + twEnd, "Europe/Bucharest"))

inSession = not useTimeWindow or inTimeWindow

// Contor trade-uri pe zi
var int  dailyTradeCount = 0
var int  lastTradeDay    = na

currentDay = dayofmonth + month * 100 + year * 10000
if na(lastTradeDay) or currentDay != lastTradeDay
    dailyTradeCount := 0
    lastTradeDay    := currentDay

tradeLimitOk = dailyTradeCount < maxTradesPerDay

// Fond colorat fereastra orara
bgcolor(showSessionBg and inTimeWindow ? color.new(color.blue, 92) : na, title="Fereastra orara bg")

// ─────────────────────────────────────────────
// STARE GLOBALA
// ─────────────────────────────────────────────
// SHORT state machine
var int   shortState     = 0
var float sRangeHigh     = na
var float sRangeLow      = na
var float sHighBeforeMSS = na
var float sEntry         = na
var float sSL            = na
var float sTP1           = na
var bool  sTP1Hit        = false
// Tracking dinamic range SHORT (se acumuleaza bar cu bar)
var float sTrackHigh     = na
var float sTrackLow      = na
var int   sTrackCount    = 0   // numar candele acumulate in range
var int   sTrackHighBull = 0   // candele bullish consecutive la momentul high-ului
var int   sWaitCount     = 0   // bare scurse de la MSS, pentru timeout

// LONG state machine
var int   longState      = 0
var float lRangeHigh     = na
var float lRangeLow      = na
var float lLowBeforeMSS  = na
var float lEntry         = na
var float lSL            = na
var float lTP1           = na
var bool  lTP1Hit        = false
// Tracking dinamic range LONG
var float lTrackHigh     = na
var float lTrackLow      = na
var int   lTrackCount    = 0
var int   lTrackLowBear  = 0   // candele bearish consecutive la momentul low-ului
var int   lWaitCount     = 0   // bare scurse de la MSS, pentru timeout

// ─────────────────────────────────────────────
// HELPER FUNCTIONS
// ─────────────────────────────────────────────
isBearish(i) => close[i] < open[i]
isBullish(i) => close[i] > open[i]

bufferVal(price, pct) => price * pct / 100

// ─────────────────────────────────────────────
// SHORT LOGIC
// ─────────────────────────────────────────────
if tradeShorts

    // STATE 0: Construieste range dinamic + detectie MSS SHORT
    if shortState == 0
        // Daca bar[2] face un nou HIGH deasupra range-ului curent → range nou incepe de acolo
        // (pastreaza doar ULTIMUL swing inainte de MSS, nu toata istoria)
        if na(sTrackHigh) or high[2] > sTrackHigh
            sTrackHigh  := high[2]
            sTrackLow   := low[2]
            sTrackCount := 1
            // Numara candele bullish consecutive care au dus la acest high
            cntBull = 0
            for j = 2 to 60
                if isBullish(j)
                    cntBull += 1
                else
                    break
            sTrackHighBull := cntBull
        else
            // high[2] <= sTrackHigh → suntem in range, extinde doar lowul
            sTrackLow   := math.min(sTrackLow, low[2])
            sTrackCount := sTrackCount + 1

        // MSS valid: prima lumanare (bar[1]) rupe sTrackLow
        //            + range are minim minRangeBars candele in spate
        //            + high-ul range-ului a fost format de minim minSwingBars candele bullish
        firstBarBreaks  = isBearish(1) and close[1] < sTrackLow
        secondBarBelow  = isBearish(0) and close[0] < sTrackLow
        rangeValid      = sTrackCount >= minRangeBars and sTrackHighBull >= minSwingBars

        if firstBarBreaks and secondBarBelow and rangeValid
            sRangeHigh     := sTrackHigh
            sRangeLow      := sTrackLow
            sHighBeforeMSS := sTrackHigh
            shortState     := 1
            sWaitCount     := 0
            sTrackHigh     := na
            sTrackLow      := na
            sTrackCount    := 0

    // STATE 1: Asteapta retest la sRangeLow
    // Retest = high-ul candelei ATINGE nivelul sRangeLow (cu mic buffer) + candela inchide bearish
    if shortState == 1 and strategy.position_size == 0
        sWaitCount := sWaitCount + 1
        // Timeout: daca nu vine retestul in maxWaitBars bare, reset
        if sWaitCount > maxWaitBars
            shortState  := 0
            sRangeHigh  := na
            sRangeLow   := na
            sWaitCount  := 0
            sTrackHigh  := na
            sTrackLow   := na
            sTrackCount := 0

    if shortState == 1 and strategy.position_size == 0 and inSession and tradeLimitOk and vwapOkShort and htfOkShort
        touchedLevel = high >= sRangeLow * (1 - zoneBuffer / 100)

        if touchedLevel
            sEntry  := close
            sSL     := sHighBeforeMSS * (1 + slBufferPct / 100)
            risk    = sSL - sEntry
            sTP1    := sEntry - risk * tp1Ratio
            sTP1Hit := false

            strategy.entry("Short", strategy.short, comment="MSS Short")
            strategy.exit("Short_TP1", "Short",
                 qty_percent = tp1ClosePct,
                 limit       = sTP1,
                 stop        = sSL,
                 comment     = "TP1 80%")
            strategy.exit("Short_Runner", "Short",
                 qty_percent = 100,
                 stop        = sEntry,
                 comment     = "Runner BE")

            dailyTradeCount := dailyTradeCount + 1
            shortState := 2

    // STATE 2: In trade - verifica daca TP1 a fost atins
    if shortState == 2
        // TP1 hit = 80% din pozitie inchisa → ramane ~20% runner
        posNow = math.abs(strategy.position_size)
        posMax = strategy.opentrades.size(0) > 0 ? math.abs(strategy.opentrades.entry_price(0)) : na

        // Detectam reducerea pozitiei (TP1 hit)
        if not sTP1Hit and strategy.position_size < 0
            if close <= sTP1
                sTP1Hit := true

        // Daca pozitia e inchisa complet → reset
        if strategy.position_size == 0
            shortState := 0
            sRangeHigh := na
            sRangeLow  := na
            sTP1Hit    := false

    // Invalidare MSS daca pretul inchide DEASUPRA sRangeHigh
    if shortState == 1 and close > sRangeHigh
        shortState  := 0
        sRangeHigh  := na
        sRangeLow   := na
        sWaitCount  := 0
        sTrackHigh  := na
        sTrackLow   := na
        sTrackCount := 0

// ─────────────────────────────────────────────
// LONG LOGIC
// ─────────────────────────────────────────────
if tradeLongs

    // STATE 0: Construieste range dinamic + detectie MSS LONG
    if longState == 0
        // Daca bar[2] face un nou LOW sub range-ul curent → range nou incepe de acolo
        if na(lTrackLow) or low[2] < lTrackLow
            lTrackHigh  := high[2]
            lTrackLow   := low[2]
            lTrackCount := 1
            // Numara candele bearish consecutive care au dus la acest low
            cntBear = 0
            for j = 2 to 60
                if isBearish(j)
                    cntBear += 1
                else
                    break
            lTrackLowBear := cntBear
        else
            // low[2] >= lTrackLow → suntem in range, extinde doar highul
            lTrackHigh  := math.max(lTrackHigh, high[2])
            lTrackCount := lTrackCount + 1

        // MSS valid: prima lumanare (bar[1]) rupe lTrackHigh
        //            + range are minim minRangeBars candele in spate
        //            + low-ul range-ului a fost format de minim minSwingBars candele bearish
        firstBarBreaks = isBullish(1) and close[1] > lTrackHigh
        secondBarAbove = isBullish(0) and close[0] > lTrackHigh
        rangeValidL    = lTrackCount >= minRangeBars and lTrackLowBear >= minSwingBars

        if firstBarBreaks and secondBarAbove and rangeValidL
            lRangeHigh    := lTrackHigh
            lRangeLow     := lTrackLow
            lLowBeforeMSS := lTrackLow
            longState     := 1
            lWaitCount    := 0
            lTrackHigh    := na
            lTrackLow     := na
            lTrackCount   := 0

    // STATE 1: Asteapta retest la lRangeHigh
    // Retest = low-ul candelei ATINGE nivelul lRangeHigh (cu mic buffer) + candela inchide bullish
    if longState == 1 and strategy.position_size == 0
        lWaitCount := lWaitCount + 1
        // Timeout: daca nu vine retestul in maxWaitBars bare, reset
        if lWaitCount > maxWaitBars
            longState   := 0
            lRangeHigh  := na
            lRangeLow   := na
            lWaitCount  := 0
            lTrackHigh  := na
            lTrackLow   := na
            lTrackCount := 0

    if longState == 1 and strategy.position_size == 0 and inSession and tradeLimitOk and vwapOkLong and htfOkLong
        touchedLevel = low <= lRangeHigh * (1 + zoneBuffer / 100)

        if touchedLevel
            lEntry  := close
            lSL     := lLowBeforeMSS * (1 - slBufferPct / 100)
            risk    = lEntry - lSL
            lTP1    := lEntry + risk * tp1Ratio
            lTP1Hit := false

            strategy.entry("Long", strategy.long, comment="MSS Long")
            strategy.exit("Long_TP1", "Long",
                 qty_percent = tp1ClosePct,
                 limit       = lTP1,
                 stop        = lSL,
                 comment     = "TP1 80%")
            strategy.exit("Long_Runner", "Long",
                 qty_percent = 100,
                 stop        = lEntry,
                 comment     = "Runner BE")

            dailyTradeCount := dailyTradeCount + 1
            longState := 2

    // STATE 2: In trade
    if longState == 2
        if not lTP1Hit and strategy.position_size > 0
            if close >= lTP1
                lTP1Hit := true

        if strategy.position_size == 0
            longState := 0
            lRangeHigh := na
            lRangeLow  := na
            lTP1Hit    := false

    // Invalidare daca pretul inchide SUB lRangeLow
    if longState == 1 and close < lRangeLow
        longState   := 0
        lRangeHigh  := na
        lRangeLow   := na
        lWaitCount  := 0
        lTrackHigh  := na
        lTrackLow   := na
        lTrackCount := 0

// ─────────────────────────────────────────────
// INVALIDARE INCRUCISATA
// Daca e deschis un LONG → anuleaza SHORT-ul care asteapta retest (si invers)
// Pretul a confirmat directia opusa → MSS-ul vechi nu mai e valabil
// ─────────────────────────────────────────────
if longState == 2 and shortState == 1
    shortState  := 0
    sRangeHigh  := na
    sRangeLow   := na
    sWaitCount  := 0
    sTrackHigh  := na
    sTrackLow   := na
    sTrackCount := 0

if shortState == 2 and longState == 1
    longState   := 0
    lRangeHigh  := na
    lRangeLow   := na
    lWaitCount  := 0
    lTrackHigh  := na
    lTrackLow   := na
    lTrackCount := 0

// ─────────────────────────────────────────────
// VIZUALIZARE
// ─────────────────────────────────────────────
C_MAROON   = color.new(#5C1A1A, 55)   // rosu inchis - zona supply/range short
C_MAROON_B = color.new(#8B2020, 20)   // border rosu
C_TEAL     = color.new(#0D3B38, 55)   // teal inchis - zona demand/range long
C_TEAL_B   = color.new(#1A6B65, 20)   // border teal
C_TARGET_S = color.new(#0D3B38, 60)   // target box short (teal jos)
C_TARGET_L = color.new(#5C1A1A, 60)   // target box long  (rosu jos = SL zone)
EXTEND     = 8                         // bare cat se extinde linia la dreapta

// ── HANDLES persistente ──────────────────────
var box   sRangeBox  = na   // range box rosu (short)
var box   sTargetBox = na   // target box teal (short - zona miscarii)
var line  sRetestLn  = na   // linie punctata la rangeLow (retest level)
var line  sSLLn      = na
var line  sTP1Ln     = na
var line  sBELn      = na
var label sSLLbl     = na
var label sTP1Lbl    = na
var label sBELbl     = na
var int   sMSSBar    = na   // bara la care s-a confirmat MSS short

var box   lRangeBox  = na
var box   lTargetBox = na
var line  lRetestLn  = na
var line  lSLLn      = na
var line  lTP1Ln     = na
var line  lBELn      = na
var label lSLLbl     = na
var label lTP1Lbl    = na
var label lBELbl     = na
var int   lMSSBar    = na

// ── Tranzitie SHORT 0 → 1 : MSS confirmat ────
if shortState == 1 and shortState[1] == 0 and showBoxes
    sMSSBar    := bar_index
    // Box range (rosu inchis) - zona care a fost sparta
    sRangeBox  := box.new(bar_index - minRangeBars, sRangeHigh, bar_index + EXTEND, sRangeLow,
         border_color=C_MAROON_B, bgcolor=C_MAROON, border_width=1,
         text=" mss ", text_color=color.new(color.white, 20), text_halign=text.align_left,
         text_valign=text.align_bottom, text_size=size.normal)
    sRetestLn  := line.new(bar_index - minRangeBars, sRangeLow, bar_index + EXTEND * 3, sRangeLow,
         color=color.new(color.white, 40), style=line.style_dashed, width=1)
    label.new(bar_index, na, "mss",
         color=color.new(#8B2020, 10), textcolor=color.new(color.white, 0),
         style=label.style_label_up, size=size.normal, yloc=yloc.belowbar)
    label.new(bar_index,     na, "●", color=color.new(color.black, 100),
         textcolor=color.new(#FF4444, 0), style=label.style_none,
         size=size.normal, yloc=yloc.belowbar)
    label.new(bar_index - 1, na, "●", color=color.new(color.black, 100),
         textcolor=color.new(#FF4444, 0), style=label.style_none,
         size=size.normal, yloc=yloc.belowbar)

// ── Extinde boxul short cat timp asteptam retest ──
if shortState == 1 and not na(sRangeBox) and showBoxes
    box.set_right(sRangeBox, bar_index + EXTEND)
    if not na(sRetestLn)
        line.set_x2(sRetestLn, bar_index + EXTEND * 3)

// ── Tranzitie SHORT 1 → 2 : Entry ────────────
if shortState == 2 and shortState[1] == 1 and showBoxes
    // Target box teal (de la entry la TP1 = zona miscarii)
    sTargetBox := box.new(bar_index, sEntry, bar_index + EXTEND * 6, sTP1,
         border_color=C_TEAL_B, bgcolor=C_TARGET_S, border_width=1)
    // Linii SL / TP1 / BE
    sSLLn  := line.new(bar_index, sSL,    bar_index + EXTEND * 5, sSL,
         color=color.new(color.red,   10), style=line.style_dashed, width=1)
    sTP1Ln := line.new(bar_index, sTP1,   bar_index + EXTEND * 5, sTP1,
         color=color.new(color.green, 10), style=line.style_dashed, width=1)
    sBELn  := line.new(bar_index, sEntry, bar_index + EXTEND * 5, sEntry,
         color=color.new(color.orange,10), style=line.style_dashed, width=1)
    // Labels la dreapta
    sSLLbl  := label.new(bar_index + EXTEND * 5, sSL,
         "SL  " + str.tostring(sSL, "#.##"),
         color=color.new(color.red,   20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)
    sTP1Lbl := label.new(bar_index + EXTEND * 5, sTP1,
         "TP1 80%  " + str.tostring(sTP1, "#.##"),
         color=color.new(color.green, 20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)
    sBELbl  := label.new(bar_index + EXTEND * 5, sEntry,
         "BE  " + str.tostring(sEntry, "#.##"),
         color=color.new(color.orange,20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)

// ── Extinde liniile short in trade ───────────
if shortState == 2 and showBoxes
    if not na(sTargetBox)
        box.set_right(sTargetBox, bar_index)
    if not na(sSLLn)
        line.set_x2(sSLLn,   bar_index + EXTEND * 5)
    if not na(sTP1Ln)
        line.set_x2(sTP1Ln,  bar_index + EXTEND * 5)
    if not na(sBELn)
        line.set_x2(sBELn,   bar_index + EXTEND * 5)
    if not na(sSLLbl)
        label.set_x(sSLLbl,  bar_index + EXTEND * 5)
    if not na(sTP1Lbl)
        label.set_x(sTP1Lbl, bar_index + EXTEND * 5)
    if not na(sBELbl)
        label.set_x(sBELbl,  bar_index + EXTEND * 5)
    // TP1 hit → eticheta runner
    if sTP1Hit and not sTP1Hit[1]
        label.new(bar_index, sTP1,
             "TP1 ✓  80% inchis\nSL → BE  |  runner 20%",
             color=color.new(color.green, 20), textcolor=color.white,
             style=label.style_label_right, size=size.tiny)

// ── Reset grafic short ────────────────────────
if shortState == 0 and shortState[1] != 0
    sRangeBox  := na
    sTargetBox := na
    sRetestLn  := na
    sSLLn   := na
    sTP1Ln  := na
    sBELn   := na
    sSLLbl  := na
    sTP1Lbl := na
    sBELbl  := na

// ════════════════════════════════════════════
// ── Tranzitie LONG 0 → 1 : MSS confirmat ───
if longState == 1 and longState[1] == 0 and showBoxes
    lMSSBar    := bar_index
    lRangeBox  := box.new(bar_index - minRangeBars, lRangeHigh, bar_index + EXTEND, lRangeLow,
         border_color=C_TEAL_B, bgcolor=C_TEAL, border_width=1,
         text=" mss ", text_color=color.new(color.white, 20), text_halign=text.align_left,
         text_valign=text.align_top, text_size=size.normal)
    lRetestLn  := line.new(bar_index - minRangeBars, lRangeHigh, bar_index + EXTEND * 3, lRangeHigh,
         color=color.new(color.white, 40), style=line.style_dashed, width=1)
    label.new(bar_index, na, "mss",
         color=color.new(#1A6B65, 10), textcolor=color.new(color.white, 0),
         style=label.style_label_down, size=size.normal, yloc=yloc.abovebar)
    label.new(bar_index,     na, "●", color=color.new(color.black, 100),
         textcolor=color.new(#00CC88, 0), style=label.style_none,
         size=size.normal, yloc=yloc.abovebar)
    label.new(bar_index - 1, na, "●", color=color.new(color.black, 100),
         textcolor=color.new(#00CC88, 0), style=label.style_none,
         size=size.normal, yloc=yloc.abovebar)

if longState == 1 and not na(lRangeBox) and showBoxes
    box.set_right(lRangeBox, bar_index + EXTEND)
    if not na(lRetestLn)
        line.set_x2(lRetestLn, bar_index + EXTEND * 3)

// ── Tranzitie LONG 1 → 2 : Entry ─────────────
if longState == 2 and longState[1] == 1 and showBoxes
    lTargetBox := box.new(bar_index, lEntry, bar_index + EXTEND * 6, lTP1,
         border_color=C_TEAL_B, bgcolor=C_TEAL, border_width=1)
    lSLLn  := line.new(bar_index, lSL,    bar_index + EXTEND * 5, lSL,
         color=color.new(color.red,   10), style=line.style_dashed, width=1)
    lTP1Ln := line.new(bar_index, lTP1,   bar_index + EXTEND * 5, lTP1,
         color=color.new(color.green, 10), style=line.style_dashed, width=1)
    lBELn  := line.new(bar_index, lEntry, bar_index + EXTEND * 5, lEntry,
         color=color.new(color.orange,10), style=line.style_dashed, width=1)
    lSLLbl  := label.new(bar_index + EXTEND * 5, lSL,
         "SL  " + str.tostring(lSL, "#.##"),
         color=color.new(color.red,   20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)
    lTP1Lbl := label.new(bar_index + EXTEND * 5, lTP1,
         "TP1 80%  " + str.tostring(lTP1, "#.##"),
         color=color.new(color.green, 20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)
    lBELbl  := label.new(bar_index + EXTEND * 5, lEntry,
         "BE  " + str.tostring(lEntry, "#.##"),
         color=color.new(color.orange,20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)

if longState == 2 and showBoxes
    if not na(lTargetBox)
        box.set_right(lTargetBox, bar_index)
    if not na(lSLLn)
        line.set_x2(lSLLn,   bar_index + EXTEND * 5)
    if not na(lTP1Ln)
        line.set_x2(lTP1Ln,  bar_index + EXTEND * 5)
    if not na(lBELn)
        line.set_x2(lBELn,   bar_index + EXTEND * 5)
    if not na(lSLLbl)
        label.set_x(lSLLbl,  bar_index + EXTEND * 5)
    if not na(lTP1Lbl)
        label.set_x(lTP1Lbl, bar_index + EXTEND * 5)
    if not na(lBELbl)
        label.set_x(lBELbl,  bar_index + EXTEND * 5)
    if lTP1Hit and not lTP1Hit[1]
        label.new(bar_index, lTP1,
             "TP1 ✓  80% inchis\nSL → BE  |  runner 20%",
             color=color.new(color.green, 20), textcolor=color.white,
             style=label.style_label_right, size=size.tiny)

if longState == 0 and longState[1] != 0
    lRangeBox  := na
    lTargetBox := na
    lRetestLn  := na
    lSLLn   := na
    lTP1Ln  := na
    lBELn   := na
    lSLLbl  := na
    lTP1Lbl := na
    lBELbl  := na

// ─────────────────────────────────────────────
// SAGETI ENTRY / EXIT
// ─────────────────────────────────────────────
// Entry
shortEntrySignal = shortState == 2 and shortState[1] == 1
longEntrySignal  = longState  == 2 and longState[1]  == 1

// TP1 partial close: pozitia scade in marime dar ramane in aceeasi directie
shortTP1Signal   = strategy.position_size < 0 and strategy.position_size[1] < 0 and strategy.position_size > strategy.position_size[1]
longTP1Signal    = strategy.position_size > 0 and strategy.position_size[1] > 0 and strategy.position_size < strategy.position_size[1]

// Exit complet: pozitia trece la 0
shortCloseSignal = strategy.position_size == 0 and strategy.position_size[1] < 0
longCloseSignal  = strategy.position_size == 0 and strategy.position_size[1] > 0

// ── ENTRY ─────────────────────────────────────
plotshape(shortEntrySignal, title="Short Entry", style=shape.triangledown,
     location=location.abovebar, color=color.new(#FF4444, 0), size=size.normal,
     text="RT ↓\n-1", textcolor=color.new(#FF4444, 0))
plotshape(longEntrySignal, title="Long Entry", style=shape.triangleup,
     location=location.belowbar, color=color.new(#00CC88, 0), size=size.normal,
     text="RT ↑\n+1", textcolor=color.new(#00CC88, 0))

// ── TP1 (inchidere partiala 80%) ──────────────
plotshape(shortTP1Signal, title="TP1 Short", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.green, 0), size=size.normal,
     text="TP1\n+1", textcolor=color.new(color.green, 0))
plotshape(longTP1Signal, title="TP1 Long", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.green, 0), size=size.normal,
     text="TP1\n-1", textcolor=color.new(color.green, 0))

// ── EXIT complet (runner BE/SL) ───────────────
plotshape(shortCloseSignal, title="Exit Short", style=shape.triangleup,
     location=location.belowbar, color=color.new(#CC44FF, 0), size=size.normal,
     text="Exit S\n+1", textcolor=color.new(#CC44FF, 0))
plotshape(longCloseSignal, title="Exit Long", style=shape.triangledown,
     location=location.abovebar, color=color.new(#CC44FF, 0), size=size.normal,
     text="Exit L\n-1", textcolor=color.new(#CC44FF, 0))

// ─────────────────────────────────────────────
// INFO TABLE
// ─────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 11,
     bgcolor=color.new(color.black, 65), border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    table.cell(t, 0, 0, "AdiivaMSS",    text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 30))
    table.cell(t, 1, 0, "v4.0",         text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 30))
    table.cell(t, 0, 1, "SHORT state",  text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 1, shortState == 0 ? "Watching" : shortState == 1 ? "MSS ✓ Wait Retest" : "IN TRADE",
         text_color=shortState == 0 ? color.gray : shortState == 1 ? color.orange : color.red, text_size=size.tiny)
    table.cell(t, 0, 2, "LONG state",   text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 2, longState == 0 ? "Watching" : longState == 1 ? "MSS ✓ Wait Retest" : "IN TRADE",
         text_color=longState == 0 ? color.gray : longState == 1 ? color.orange : color.teal, text_size=size.tiny)
    table.cell(t, 0, 3, "TP1 hit Short",text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 3, sTP1Hit ? "DA → Runner BE" : "NU",
         text_color=sTP1Hit ? color.green : color.gray, text_size=size.tiny)
    table.cell(t, 0, 4, "TP1 hit Long", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 4, lTP1Hit ? "DA → Runner BE" : "NU",
         text_color=lTP1Hit ? color.green : color.gray, text_size=size.tiny)
    table.cell(t, 0, 5, "Min range bars", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 5, str.tostring(minRangeBars), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 6, "TP1 close %",  text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 6, str.tostring(tp1ClosePct) + "%", text_color=color.white, text_size=size.tiny)
    // Fereastra orara
    twLabel = not useTimeWindow ? "OFF" : inTimeWindow ? "✓ " + twStart + "-" + twEnd + " RO" : "-- In afara ferestrei --"
    twColor = not useTimeWindow ? color.gray : inTimeWindow ? color.new(#00CC88, 0) : color.red
    table.cell(t, 0, 7, "Fereastra orara", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 7, twLabel,           text_color=twColor,      text_size=size.tiny)
    // Trade-uri azi
    tradeCountColor = dailyTradeCount >= maxTradesPerDay ? color.red : color.new(#00CC88, 0)
    table.cell(t, 0, 8, "Trade-uri azi",   text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 8, str.tostring(dailyTradeCount) + " / " + str.tostring(maxTradesPerDay),
         text_color=tradeCountColor, text_size=size.tiny)
    // VWAP Weekly bias
    vwapLabel = not useVWAP ? "OFF" : aboveVWAP ? "▲ Bullish (LONG only)" : "▼ Bearish (SHORT only)"
    vwapColor = not useVWAP ? color.gray : aboveVWAP ? color.new(#00CC88, 0) : color.new(#FF4444, 0)
    table.cell(t, 0, 9,  "VWAP Weekly",  text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 9,  vwapLabel,      text_color=vwapColor,    text_size=size.tiny)
    // HTF MSS Bias
    htfLabel = not useHTF ? "OFF" : htfBullish ? "▲ Bullish (LONG only)" : htfBearish ? "▼ Bearish (SHORT only)" : "-- Neutru --"
    htfColor = not useHTF ? color.gray : htfBullish ? color.new(#00CC88, 0) : htfBearish ? color.new(#FF4444, 0) : color.orange
    table.cell(t, 0, 10, "HTF " + htfTimeframe + "m Bias", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 10, htfLabel,        text_color=htfColor,     text_size=size.tiny)
