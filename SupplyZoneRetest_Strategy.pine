//@version=5
strategy("MSS Range Retest Strategy", overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=2,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     calc_on_every_tick=false)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
grp1 = "Range Settings"
rangeLookback   = input.int(10,   "Range lookback (bars)",         minval=3, maxval=50, group=grp1)
zoneBuffer      = input.float(0.1,"Buffer zona (%)",               minval=0.0, step=0.05, group=grp1)
showBoxes       = input.bool(true, "Afiseaza Range Boxes",         group=grp1)

grp2 = "Trade Management"
tp1Ratio        = input.float(1.0, "TP1 RR (runner la BE)",        minval=0.5, step=0.5, group=grp2)
tp1ClosePct     = input.float(80,  "% pozitie inchisa la TP1",     minval=50, maxval=95, group=grp2)
slBufferPct     = input.float(0.05,"SL buffer deasupra High (%)",  minval=0.0, step=0.05, group=grp2)

grp3 = "Filters"
tradeShorts     = input.bool(true,  "Trade SHORT",  group=grp3)
tradeLongs      = input.bool(true,  "Trade LONG",   group=grp3)

grp4 = "Session Filter  (DST automat)"
useSessions     = input.bool(true,  "Filtru sesiuni activ",              group=grp4)
// London – ora locala Europa/Londra (GMT iarna, BST vara → DST automat)
londonOn        = input.bool(true,  "London Session",                    group=grp4)
londonStart     = input.string("0800", "London start (ora locala)",      group=grp4)
londonEnd       = input.string("1700", "London end   (ora locala)",      group=grp4)
// New York – ora locala America/New_York (EST iarna, EDT vara → DST automat)
nyOn            = input.bool(true,  "New York Session",                  group=grp4)
nyStart         = input.string("0930", "New York start (ora locala)",    group=grp4)
nyEnd           = input.string("1600", "New York end   (ora locala)",    group=grp4)
showSessionBg   = input.bool(true,  "Afiseaza fond sesiuni",             group=grp4)

// ─────────────────────────────────────────────
// SESIUNI  (time() cu timezone = DST automat)
// ─────────────────────────────────────────────
londonSession = londonOn and not na(time(timeframe.period, londonStart + "-" + londonEnd, "Europe/London"))
nySession     = nyOn     and not na(time(timeframe.period, nyStart     + "-" + nyEnd,     "America/New_York"))

inSession = not useSessions or londonSession or nySession

// Fond colorat per sesiune
bgcolor(showSessionBg and londonSession and not nySession ? color.new(color.blue,   92) : na, title="London bg")
bgcolor(showSessionBg and nySession     and not londonSession ? color.new(color.orange, 92) : na, title="NY bg")
bgcolor(showSessionBg and londonSession and nySession         ? color.new(color.purple, 88) : na, title="Overlap bg")

// ─────────────────────────────────────────────
// STARE GLOBALA
// ─────────────────────────────────────────────
// SHORT state machine
var int   shortState    = 0   // 0=wait  1=mss_confirmed  2=in_trade  3=runner_BE
var float sRangeHigh    = na
var float sRangeLow     = na
var float sHighBeforeMSS = na  // SL reference
var float sEntry        = na
var float sSL           = na
var float sTP1          = na
var bool  sTP1Hit       = false

// LONG state machine
var int   longState     = 0
var float lRangeHigh    = na
var float lRangeLow     = na
var float lLowBeforeMSS = na
var float lEntry        = na
var float lSL           = na
var float lTP1          = na
var bool  lTP1Hit       = false

// ─────────────────────────────────────────────
// HELPER FUNCTIONS
// ─────────────────────────────────────────────
isBearish(i) => close[i] < open[i]
isBullish(i) => close[i] > open[i]

bufferVal(price, pct) => price * pct / 100

// ─────────────────────────────────────────────
// SHORT LOGIC
// ─────────────────────────────────────────────
if tradeShorts

    // STATE 0: Detectie range + MSS SHORT
    // MSS = 2 consecutive bearish candles closing BELOW range low
    if shortState == 0
        rHigh = ta.highest(high, rangeLookback)
        rLow  = ta.lowest(low,   rangeLookback)
        // Verifica daca ultimele 2 lumanari sunt bearish si inchid sub rangeLow
        twoBearsBelow = isBearish(0) and isBearish(1) and close[0] < rLow and close[1] < rLow
        if twoBearsBelow
            sRangeHigh     := rHigh
            sRangeLow      := rLow
            // SL = high-ul de dinainte de MSS (cel mai mare high din ultimele rangeLookback bars)
            sHighBeforeMSS := rHigh
            shortState     := 1

    // STATE 1: Asteapta retest la sRangeLow
    // Retest = pretul revine la nivelul sRangeLow (zona de sus a range-ului spart)
    if shortState == 1 and strategy.position_size == 0 and inSession
        retestZoneTop    = sRangeLow + bufferVal(sRangeLow, zoneBuffer)
        retestZoneBottom = sRangeLow - bufferVal(sRangeLow, zoneBuffer * 2)

        inRetestZone = high >= retestZoneBottom and close <= retestZoneTop

        // Confirmare: candela bearish in zona de retest
        if inRetestZone and isBearish(0)
            sEntry  := close
            sSL     := sHighBeforeMSS * (1 + slBufferPct / 100)
            risk    = sSL - sEntry
            sTP1    := sEntry - risk * tp1Ratio
            sTP1Hit := false

            strategy.entry("Short", strategy.short, comment="MSS Short")
            // 80% la TP1
            strategy.exit("Short_TP1", "Short",
                 qty_percent = tp1ClosePct,
                 limit       = sTP1,
                 stop        = sSL,
                 comment     = "TP1 80%")
            // 20% runner cu SL la BE (entry)
            strategy.exit("Short_Runner", "Short",
                 qty_percent = 100,
                 stop        = sEntry,
                 comment     = "Runner BE")

            shortState := 2

    // STATE 2: In trade - verifica daca TP1 a fost atins
    if shortState == 2
        // TP1 hit = 80% din pozitie inchisa → ramane ~20% runner
        posNow = math.abs(strategy.position_size)
        posMax = strategy.opentrades.size(0) > 0 ? math.abs(strategy.opentrades.entry_price(0)) : na

        // Detectam reducerea pozitiei (TP1 hit)
        if not sTP1Hit and strategy.position_size < 0
            if close <= sTP1
                sTP1Hit := true

        // Daca pozitia e inchisa complet → reset
        if strategy.position_size == 0
            shortState := 0
            sRangeHigh := na
            sRangeLow  := na
            sTP1Hit    := false

    // Invalidare MSS daca pretul inchide DEASUPRA sRangeHigh (zona invalidata)
    if shortState == 1 and close > sRangeHigh
        shortState := 0
        sRangeHigh := na
        sRangeLow  := na

// ─────────────────────────────────────────────
// LONG LOGIC
// ─────────────────────────────────────────────
if tradeLongs

    // STATE 0: Detectie range + MSS LONG
    if longState == 0
        rHigh = ta.highest(high, rangeLookback)
        rLow  = ta.lowest(low,   rangeLookback)
        // 2 lumanari bullish inchid DEASUPRA rangeHigh
        twoBullsAbove = isBullish(0) and isBullish(1) and close[0] > rHigh and close[1] > rHigh
        if twoBullsAbove
            lRangeHigh     := rHigh
            lRangeLow      := rLow
            lLowBeforeMSS  := rLow
            longState      := 1

    // STATE 1: Asteapta retest la lRangeHigh
    if longState == 1 and strategy.position_size == 0 and inSession
        retestZoneBottom = lRangeHigh - bufferVal(lRangeHigh, zoneBuffer)
        retestZoneTop    = lRangeHigh + bufferVal(lRangeHigh, zoneBuffer * 2)

        inRetestZone = low <= retestZoneTop and close >= retestZoneBottom

        // Confirmare: candela bullish in zona de retest
        if inRetestZone and isBullish(0)
            lEntry  := close
            lSL     := lLowBeforeMSS * (1 - slBufferPct / 100)
            risk    = lEntry - lSL
            lTP1    := lEntry + risk * tp1Ratio
            lTP1Hit := false

            strategy.entry("Long", strategy.long, comment="MSS Long")
            // 80% la TP1
            strategy.exit("Long_TP1", "Long",
                 qty_percent = tp1ClosePct,
                 limit       = lTP1,
                 stop        = lSL,
                 comment     = "TP1 80%")
            // 20% runner cu SL la BE
            strategy.exit("Long_Runner", "Long",
                 qty_percent = 100,
                 stop        = lEntry,
                 comment     = "Runner BE")

            longState := 2

    // STATE 2: In trade
    if longState == 2
        if not lTP1Hit and strategy.position_size > 0
            if close >= lTP1
                lTP1Hit := true

        if strategy.position_size == 0
            longState := 0
            lRangeHigh := na
            lRangeLow  := na
            lTP1Hit    := false

    // Invalidare daca pretul inchide SUB lRangeLow
    if longState == 1 and close < lRangeLow
        longState := 0
        lRangeHigh := na
        lRangeLow  := na

// ─────────────────────────────────────────────
// VIZUALIZARE
// ─────────────────────────────────────────────
C_MAROON   = color.new(#5C1A1A, 55)   // rosu inchis - zona supply/range short
C_MAROON_B = color.new(#8B2020, 20)   // border rosu
C_TEAL     = color.new(#0D3B38, 55)   // teal inchis - zona demand/range long
C_TEAL_B   = color.new(#1A6B65, 20)   // border teal
C_TARGET_S = color.new(#0D3B38, 60)   // target box short (teal jos)
C_TARGET_L = color.new(#5C1A1A, 60)   // target box long  (rosu jos = SL zone)
EXTEND     = 8                         // bare cat se extinde linia la dreapta

// ── HANDLES persistente ──────────────────────
var box   sRangeBox  = na   // range box rosu (short)
var box   sTargetBox = na   // target box teal (short - zona miscarii)
var line  sRetestLn  = na   // linie punctata la rangeLow (retest level)
var line  sSLLn      = na
var line  sTP1Ln     = na
var line  sBELn      = na
var label sSLLbl     = na
var label sTP1Lbl    = na
var label sBELbl     = na
var int   sMSSBar    = na   // bara la care s-a confirmat MSS short

var box   lRangeBox  = na
var box   lTargetBox = na
var line  lRetestLn  = na
var line  lSLLn      = na
var line  lTP1Ln     = na
var line  lBELn      = na
var label lSLLbl     = na
var label lTP1Lbl    = na
var label lBELbl     = na
var int   lMSSBar    = na

// ── Tranzitie SHORT 0 → 1 : MSS confirmat ────
if shortState == 1 and shortState[1] == 0 and showBoxes
    sMSSBar    := bar_index
    // Box range (rosu inchis) - zona care a fost sparta
    sRangeBox  := box.new(bar_index - rangeLookback, sRangeHigh, bar_index + EXTEND, sRangeLow,
         border_color=C_MAROON_B, bgcolor=C_MAROON, border_width=1,
         text=" mss ", text_color=color.new(color.white, 20), text_halign=text.align_left,
         text_valign=text.align_bottom, text_size=size.small)
    // Linie punctata la nivelul de retest (baza range-ului)
    sRetestLn  := line.new(bar_index - rangeLookback, sRangeLow, bar_index + EXTEND * 3, sRangeLow,
         color=color.new(color.white, 40), style=line.style_dashed, width=1)
    // Eticheta "mss" la bara de confirmare
    label.new(bar_index, low - bufferVal(low, 0.05), "mss",
         color=color.new(color.black, 100), textcolor=color.new(color.white, 10),
         style=label.style_none, size=size.small, yloc=yloc.belowbar)
    // Cerc mic rosu sub fiecare din cele 2 lumanari bearish de confirmare
    label.new(bar_index,     low[0],  "●", color=color.new(color.black, 100),
         textcolor=color.new(#FF4444, 0), style=label.style_none,
         size=size.small, yloc=yloc.belowbar)
    label.new(bar_index - 1, low[1],  "●", color=color.new(color.black, 100),
         textcolor=color.new(#FF4444, 0), style=label.style_none,
         size=size.small, yloc=yloc.belowbar)

// ── Extinde boxul short cat timp asteptam retest ──
if shortState == 1 and not na(sRangeBox) and showBoxes
    box.set_right(sRangeBox, bar_index + EXTEND)
    if not na(sRetestLn)
        line.set_x2(sRetestLn, bar_index + EXTEND * 3)

// ── Tranzitie SHORT 1 → 2 : Entry ────────────
if shortState == 2 and shortState[1] == 1 and showBoxes
    risk = sSL - sEntry
    // Sageata entry
    label.new(bar_index, high + bufferVal(high, 0.08),
         "▼  SHORT\nintra la retest",
         color=color.new(#8B2020, 10), textcolor=color.white,
         style=label.style_label_down, size=size.small)
    // Target box teal (de la entry la TP1 = zona miscarii)
    sTargetBox := box.new(bar_index, sEntry, bar_index + EXTEND * 6, sTP1,
         border_color=C_TEAL_B, bgcolor=C_TARGET_S, border_width=1)
    // Linii SL / TP1 / BE
    sSLLn  := line.new(bar_index, sSL,    bar_index + EXTEND * 5, sSL,
         color=color.new(color.red,   10), style=line.style_dashed, width=1)
    sTP1Ln := line.new(bar_index, sTP1,   bar_index + EXTEND * 5, sTP1,
         color=color.new(color.green, 10), style=line.style_dashed, width=1)
    sBELn  := line.new(bar_index, sEntry, bar_index + EXTEND * 5, sEntry,
         color=color.new(color.orange,10), style=line.style_dashed, width=1)
    // Labels la dreapta
    sSLLbl  := label.new(bar_index + EXTEND * 5, sSL,
         "SL  " + str.tostring(sSL, "#.##"),
         color=color.new(color.red,   20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)
    sTP1Lbl := label.new(bar_index + EXTEND * 5, sTP1,
         "TP1 80%  " + str.tostring(sTP1, "#.##"),
         color=color.new(color.green, 20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)
    sBELbl  := label.new(bar_index + EXTEND * 5, sEntry,
         "BE  " + str.tostring(sEntry, "#.##"),
         color=color.new(color.orange,20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)

// ── Extinde liniile short in trade ───────────
if shortState == 2 and showBoxes
    if not na(sTargetBox) : box.set_right(sTargetBox,  bar_index)
    if not na(sSLLn)      : line.set_x2(sSLLn,   bar_index + EXTEND * 5)
    if not na(sTP1Ln)     : line.set_x2(sTP1Ln,  bar_index + EXTEND * 5)
    if not na(sBELn)      : line.set_x2(sBELn,   bar_index + EXTEND * 5)
    if not na(sSLLbl)     : label.set_x(sSLLbl,  bar_index + EXTEND * 5)
    if not na(sTP1Lbl)    : label.set_x(sTP1Lbl, bar_index + EXTEND * 5)
    if not na(sBELbl)     : label.set_x(sBELbl,  bar_index + EXTEND * 5)
    // TP1 hit → eticheta runner
    if sTP1Hit and not sTP1Hit[1]
        label.new(bar_index, sTP1,
             "TP1 ✓  80% inchis\nSL → BE  |  runner 20%",
             color=color.new(color.green, 20), textcolor=color.white,
             style=label.style_label_right, size=size.tiny)

// ── Reset grafic short ────────────────────────
if shortState == 0 and shortState[1] != 0
    sRangeBox  := na
    sTargetBox := na
    sRetestLn  := na
    sSLLn := na  ;  sTP1Ln := na  ;  sBELn := na
    sSLLbl := na ;  sTP1Lbl := na ;  sBELbl := na

// ════════════════════════════════════════════
// ── Tranzitie LONG 0 → 1 : MSS confirmat ───
if longState == 1 and longState[1] == 0 and showBoxes
    lMSSBar    := bar_index
    lRangeBox  := box.new(bar_index - rangeLookback, lRangeHigh, bar_index + EXTEND, lRangeLow,
         border_color=C_TEAL_B, bgcolor=C_TEAL, border_width=1,
         text=" mss ", text_color=color.new(color.white, 20), text_halign=text.align_left,
         text_valign=text.align_top, text_size=size.small)
    lRetestLn  := line.new(bar_index - rangeLookback, lRangeHigh, bar_index + EXTEND * 3, lRangeHigh,
         color=color.new(color.white, 40), style=line.style_dashed, width=1)
    label.new(bar_index, high + bufferVal(high, 0.05), "mss",
         color=color.new(color.black, 100), textcolor=color.new(color.white, 10),
         style=label.style_none, size=size.small, yloc=yloc.abovebar)
    // Cerc mic verde deasupra fiecareia din cele 2 lumanari bullish de confirmare
    label.new(bar_index,     high[0], "●", color=color.new(color.black, 100),
         textcolor=color.new(#00CC88, 0), style=label.style_none,
         size=size.small, yloc=yloc.abovebar)
    label.new(bar_index - 1, high[1], "●", color=color.new(color.black, 100),
         textcolor=color.new(#00CC88, 0), style=label.style_none,
         size=size.small, yloc=yloc.abovebar)

if longState == 1 and not na(lRangeBox) and showBoxes
    box.set_right(lRangeBox, bar_index + EXTEND)
    if not na(lRetestLn)
        line.set_x2(lRetestLn, bar_index + EXTEND * 3)

// ── Tranzitie LONG 1 → 2 : Entry ─────────────
if longState == 2 and longState[1] == 1 and showBoxes
    risk = lEntry - lSL
    label.new(bar_index, low - bufferVal(low, 0.08),
         "▲  LONG\nintra la retest",
         color=color.new(#0D3B38, 10), textcolor=color.white,
         style=label.style_label_up, size=size.small)
    lTargetBox := box.new(bar_index, lEntry, bar_index + EXTEND * 6, lTP1,
         border_color=C_TEAL_B, bgcolor=C_TEAL, border_width=1)
    lSLLn  := line.new(bar_index, lSL,    bar_index + EXTEND * 5, lSL,
         color=color.new(color.red,   10), style=line.style_dashed, width=1)
    lTP1Ln := line.new(bar_index, lTP1,   bar_index + EXTEND * 5, lTP1,
         color=color.new(color.green, 10), style=line.style_dashed, width=1)
    lBELn  := line.new(bar_index, lEntry, bar_index + EXTEND * 5, lEntry,
         color=color.new(color.orange,10), style=line.style_dashed, width=1)
    lSLLbl  := label.new(bar_index + EXTEND * 5, lSL,
         "SL  " + str.tostring(lSL, "#.##"),
         color=color.new(color.red,   20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)
    lTP1Lbl := label.new(bar_index + EXTEND * 5, lTP1,
         "TP1 80%  " + str.tostring(lTP1, "#.##"),
         color=color.new(color.green, 20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)
    lBELbl  := label.new(bar_index + EXTEND * 5, lEntry,
         "BE  " + str.tostring(lEntry, "#.##"),
         color=color.new(color.orange,20), textcolor=color.white,
         style=label.style_label_left, size=size.tiny)

if longState == 2 and showBoxes
    if not na(lTargetBox) : box.set_right(lTargetBox,  bar_index)
    if not na(lSLLn)      : line.set_x2(lSLLn,   bar_index + EXTEND * 5)
    if not na(lTP1Ln)     : line.set_x2(lTP1Ln,  bar_index + EXTEND * 5)
    if not na(lBELn)      : line.set_x2(lBELn,   bar_index + EXTEND * 5)
    if not na(lSLLbl)     : label.set_x(lSLLbl,  bar_index + EXTEND * 5)
    if not na(lTP1Lbl)    : label.set_x(lTP1Lbl, bar_index + EXTEND * 5)
    if not na(lBELbl)     : label.set_x(lBELbl,  bar_index + EXTEND * 5)
    if lTP1Hit and not lTP1Hit[1]
        label.new(bar_index, lTP1,
             "TP1 ✓  80% inchis\nSL → BE  |  runner 20%",
             color=color.new(color.green, 20), textcolor=color.white,
             style=label.style_label_right, size=size.tiny)

if longState == 0 and longState[1] != 0
    lRangeBox  := na
    lTargetBox := na
    lRetestLn  := na
    lSLLn := na  ;  lTP1Ln := na  ;  lBELn := na
    lSLLbl := na ;  lTP1Lbl := na ;  lBELbl := na

// ─────────────────────────────────────────────
// INFO TABLE
// ─────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 8,
     bgcolor=color.new(color.black, 65), border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    table.cell(t, 0, 0, "MSS RETEST",   text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 30))
    table.cell(t, 1, 0, "v2.0",         text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 30))
    table.cell(t, 0, 1, "SHORT state",  text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 1, shortState == 0 ? "Watching" : shortState == 1 ? "MSS ✓ Wait Retest" : "IN TRADE",
         text_color=shortState == 0 ? color.gray : shortState == 1 ? color.orange : color.red, text_size=size.tiny)
    table.cell(t, 0, 2, "LONG state",   text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 2, longState == 0 ? "Watching" : longState == 1 ? "MSS ✓ Wait Retest" : "IN TRADE",
         text_color=longState == 0 ? color.gray : longState == 1 ? color.orange : color.teal, text_size=size.tiny)
    table.cell(t, 0, 3, "TP1 hit Short",text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 3, sTP1Hit ? "DA → Runner BE" : "NU",
         text_color=sTP1Hit ? color.green : color.gray, text_size=size.tiny)
    table.cell(t, 0, 4, "TP1 hit Long", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 4, lTP1Hit ? "DA → Runner BE" : "NU",
         text_color=lTP1Hit ? color.green : color.gray, text_size=size.tiny)
    table.cell(t, 0, 5, "Range bars",   text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 5, str.tostring(rangeLookback), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 6, "TP1 close %",  text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 6, str.tostring(tp1ClosePct) + "%", text_color=color.white, text_size=size.tiny)
    // Sesiune activa
    sessionLabel = not useSessions ? "OFF" :
         londonSession and nySession ? "London + NY (Overlap)" :
         londonSession               ? "London" :
         nySession                   ? "New York" : "-- In afara sesiunii --"
    sessionColor = not useSessions ? color.gray :
         londonSession and nySession ? color.purple :
         londonSession               ? color.blue :
         nySession                   ? color.orange : color.red
    table.cell(t, 0, 7, "Sesiune",      text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 7, sessionLabel,   text_color=sessionColor, text_size=size.tiny)
