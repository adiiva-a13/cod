//@version=5
strategy("AdiivaTwezer",
         overlay                 = true,
         process_orders_on_close = true,
         default_qty_type        = strategy.percent_of_equity,
         default_qty_value       = 2,
         commission_type         = strategy.commission.percent,
         commission_value        = 0.02,
         slippage                = 2,
         max_bars_back           = 500,
         max_labels_count        = 500,
         max_lines_count         = 500,
         max_boxes_count         = 500)

// ════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════

// ── MTF ───────────────────────────────────────────────────────────────
grpMTF = "=== MULTI-TIMEFRAME LIQUIDITY ==="
tf4H      = input.timeframe("240", "Timeframe major (liq externa)",    group=grpMTF)
tf1H      = input.timeframe("60",  "Timeframe intern (liq interna)",   group=grpMTF)
// Sonarlab Liquidity Levels style: Left bars 40, Right bars 5 pe 4H
pivot4H_L = input.int(40, "Pivot Left bars 4H  (Sonarlab style)",      group=grpMTF, minval=1, maxval=200)
pivot4H_R = input.int(5,  "Pivot Right bars 4H (Sonarlab style)",      group=grpMTF, minval=1, maxval=50)
pivot1H_L = input.int(10, "Pivot Left bars 1H",                        group=grpMTF, minval=1, maxval=200)
pivot1H_R = input.int(5,  "Pivot Right bars 1H",                       group=grpMTF, minval=1, maxval=50)
maxLvl    = input.int(5,  "Niveluri max stocate per TF",               group=grpMTF, minval=1, maxval=10)
liqTol    = input.float(50.0, "Toleranta sweep → nivel MTF (puncte)",   group=grpMTF, minval=0.0, step=0.5,
                         tooltip="Wick-ul sweep trebuie sa ajunga in aceasta distanta fata de nivelul 4H/1H")
localLookback = input.int(3, "Bare stanga pt local High/Low (filtru structura)", group=grpMTF, minval=1, maxval=20,
                         tooltip="Cate bare la stanga lui L1 trebuie sa fie sub high-ul L1 (TT) sau deasupra low-ului L1 (TB). Ex: 3 = L1 e cel mai inalt din ultimele 3 bare la stanga lui")
require4H = input.bool(true,  "Obliga sweep pe nivel 4H (liq majora)", group=grpMTF)
require1H = input.bool(true,  "Sau pe nivel 1H (liq interna)",         group=grpMTF)

// ── FILTRU CONTEXT STRUCTURAL ────────────────────────────────────────
grpStruct    = "=== FILTRU CONTEXT STRUCTURAL ==="
useStructCtx = input.bool(true, "Activ: SHORT doar langa BSL (HH), LONG doar langa SSL (LL)", group=grpStruct,
                           tooltip="SHORT valid doar cand pretul e in zona unui nivel BSL (4H/1H). LONG valid doar langa SSL. Previne semnale false in mijlocul range-ului.")
zoneProxPrice= input.float(100.0, "Latime zona langa nivel MTF (puncte pret)", group=grpStruct, minval=5.0, maxval=1000.0, step=5.0,
                           tooltip="Cat de aproape (in puncte de pret) trebuie sa fie pretul de un nivel BSL/SSL pentru a fi in zona valida. Ex: 100 = pretul +/-100 puncte fata de nivelul 4H/1H.")

// ── PATTERN TYPE A  (L1 → L2 sweep → L3 confirmare) ──────────────────
grp1 = "=== PATTERN TYPE A  (3-candle consecutive, entry pe L3) ==="
// L1=bar[2], L2=bar[1], L3=bar[0] — mereu consecutive, fara bare intre ele

// ── PATTERN TYPE B  (L1 ≈ L2 twin → L3 sweep ambele, entry pe L3) ────
grp2 = "=== PATTERN TYPE B  (twin candle, entry pe L3) ==="
minSweepB = input.float(0.0, "Sweep minim L3 peste ambele (puncte)",   group=grp2, minval=0.0, step=0.5)
twinTol   = input.float(3.0, "Toleranta twin L1≈L2 (max dif high/low, puncte)", group=grp2, minval=0.0, step=0.5)

// ── ENTRY / EXIT ──────────────────────────────────────────────────────
grp3 = "=== ENTRY / EXIT ==="
rrRatio   = input.float(2.0, "Risk : Reward",                          group=grp3, minval=0.5, step=0.5)
slBuf     = input.float(2.0, "SL Buffer (puncte dupa wick extrem)",    group=grp3, minval=0.0, step=0.5)

// ── FILTRU ORE + LIMITE ZILNICE ───────────────────────────────────────
grp4 = "=== FILTRU ORE (ora Romaniei) ==="
useTime        = input.bool (true, "Filtru ore activ",                  group=grp4)
startH         = input.int  (10,  "Ora start (Romania)",               group=grp4, minval=0,  maxval=23)
endH           = input.int  (20,  "Ora end (Romania)",                 group=grp4, minval=1,  maxval=24)
maxDailyTrades = input.int  (3,   "Max trades / zi",                   group=grp4, minval=1,  maxval=50)
cooldownBars   = input.int  (10,  "Cooldown bare dupa exit (anti-re-entry)", group=grp4, minval=0, maxval=200,
                              tooltip="Cate bare sa astepte dupa inchiderea unui trade inainte de urmatorul semnal. Pe 5min: 12 bare = 1H, 48 bare = 4H")

// ── VIZUALIZARE ───────────────────────────────────────────────────────
grp5 = "=== VIZUALIZARE ==="
showLabels = input.bool(true,  "Etichete TT / TB",       group=grp5)
showZone   = input.bool(true,  "Box zona sweep (5min)",   group=grp5)
showSLLine = input.bool(true,  "Linie SL",                group=grp5)
show4H     = input.bool(true,  "Niveluri 4H pe chart",    group=grp5)
show1H     = input.bool(true,  "Niveluri 1H pe chart",    group=grp5)
colorSell  = input.color(color.purple, "Culoare semnale SELL",  group=grp5)
colorBuy   = input.color(color.purple, "Culoare semnale BUY",   group=grp5)

// ════════════════════════════════════════════════════════════════════
// HELPERS
// ════════════════════════════════════════════════════════════════════
pts(x) => x * syminfo.mintick

// Ora curenta in fusul orar Romania (EET = UTC+2 iarna / UTC+3 vara)
roHour    = hour(time, "Europe/Bucharest")
inSession = not useTime or (roHour >= startH and roHour < endH)

// Contor trades zilnic (resetat la ora Romania)
var int tradesToday  = 0
var int lastDay_ro   = -1
roDay = dayofmonth(time, "Europe/Bucharest")
if roDay != lastDay_ro
    tradesToday := 0
    lastDay_ro  := roDay

canTradeDaily = tradesToday < maxDailyTrades

var int lastExitBar = 0
if strategy.closedtrades > 0
    if strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1) > lastExitBar
        lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

inCooldown = bar_index - lastExitBar < cooldownBars
noTrade    = strategy.position_size == 0 and canTradeDaily and not inCooldown

// ════════════════════════════════════════════════════════════════════
// MULTI-TIMEFRAME  — identificare niveluri de lichiditate
//
//  4H pivot HIGH  = Buy-Side Liquidity  (BSL) majora
//       → validare pentru pattern SELL (TT): sweep-ul trebuie sa atinga un pivot 4H high
//  4H pivot LOW   = Sell-Side Liquidity (SSL) majora
//       → validare pentru pattern BUY  (TB): sweep-ul trebuie sa atinga un pivot 4H low
//  1H pivot HIGH  = BSL interna
//  1H pivot LOW   = SSL interna
// ════════════════════════════════════════════════════════════════════

// ── Requesturi higher TF ──────────────────────────────────────────────
ph4H_raw = request.security(syminfo.tickerid, tf4H, ta.pivothigh(pivot4H_L, pivot4H_R), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pl4H_raw = request.security(syminfo.tickerid, tf4H, ta.pivotlow (pivot4H_L, pivot4H_R), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ph1H_raw = request.security(syminfo.tickerid, tf1H, ta.pivothigh(pivot1H_L, pivot1H_R), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pl1H_raw = request.security(syminfo.tickerid, tf1H, ta.pivotlow (pivot1H_L, pivot1H_R), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ── Stocare niveluri in array-uri ─────────────────────────────────────
var array<float> bsl4H = array.new_float(0)  // 4H pivot highs (BSL major)
var array<float> ssl4H = array.new_float(0)  // 4H pivot lows  (SSL major)
var array<float> bsl1H = array.new_float(0)  // 1H pivot highs (BSL intern)
var array<float> ssl1H = array.new_float(0)  // 1H pivot lows  (SSL intern)

addLevel(arr, val, maxSize) =>
    if not na(val)
        isDup = false
        if array.size(arr) > 0
            for k = 0 to array.size(arr) - 1
                if math.abs(array.get(arr, k) - val) < pts(0.5)
                    isDup := true
                    break
        if not isDup
            array.unshift(arr, val)
            if array.size(arr) > maxSize
                array.pop(arr)

addLevel(bsl4H, ph4H_raw, maxLvl)
addLevel(ssl4H, pl4H_raw, maxLvl)
addLevel(bsl1H, ph1H_raw, maxLvl)
addLevel(ssl1H, pl1H_raw, maxLvl)


// ── Zone filter: SHORT doar langa BSL (HH 4H/1H), LONG doar langa SSL (LL 4H/1H) ──
// Previne semnale false din mijlocul range-ului unde nu exista lichiditate importanta
_nearBSL = false
_nearSSL = false
if useStructCtx
    if array.size(bsl4H) > 0
        for k = 0 to array.size(bsl4H) - 1
            if math.abs(close - array.get(bsl4H, k)) <= zoneProxPrice
                _nearBSL := true
    if array.size(bsl1H) > 0
        for k = 0 to array.size(bsl1H) - 1
            if math.abs(close - array.get(bsl1H, k)) <= zoneProxPrice
                _nearBSL := true
    if array.size(ssl4H) > 0
        for k = 0 to array.size(ssl4H) - 1
            if math.abs(close - array.get(ssl4H, k)) <= zoneProxPrice
                _nearSSL := true
    if array.size(ssl1H) > 0
        for k = 0 to array.size(ssl1H) - 1
            if math.abs(close - array.get(ssl1H, k)) <= zoneProxPrice
                _nearSSL := true

inHighZone = not useStructCtx or _nearBSL
inLowZone  = not useStructCtx or _nearSSL

// ── Validare: sweep-ul a atins un nivel MTF? ──────────────────────────
// REGULA: nivelul MTF trebuie sa fie IN WICK-UL barei de sweep
//   Pentru TT (SELL): nivelul BSL trebuie sa fie intre close si high al barei sweep
//     → sweepWick (high) >= nivel - tol   (wick-ul a atins nivelul)
//     → nivel >= sweepClose - tol          (nivelul e deasupra/langa close = in wick)
//   Pentru TB (BUY): nivelul SSL trebuie sa fie intre low si close al barei sweep
//     → sweepWick (low) <= nivel + tol    (wick-ul a atins nivelul)
//     → nivel <= sweepClose + tol          (nivelul e sub/langa close = in wick)
// REGULA DE SWEEP: wick-ul TREBUIE sa atinga sau sa depaseasca nivelul (fara toleranta pe crossing)
// Toleranta (liqTol) se aplica DOAR la conditia „nivelul e in wick" (intre wick si close)
// Astfel prevenim semnale unde wick-ul se apropie de nivel dar nu il ia efectiv
sweepsHighLiq(sweepWick, sweepClose) =>
    tol   = pts(liqTol)
    hit4H = false
    hit1H = false
    if require4H and array.size(bsl4H) > 0
        for k = 0 to array.size(bsl4H) - 1
            lvl = array.get(bsl4H, k)
            if sweepWick >= lvl and lvl >= sweepClose - tol   // wick atinge/depaseste nivelul
                hit4H := true
                break
    if require1H and array.size(bsl1H) > 0
        for k = 0 to array.size(bsl1H) - 1
            lvl = array.get(bsl1H, k)
            if sweepWick >= lvl and lvl >= sweepClose - tol   // wick atinge/depaseste nivelul
                hit1H := true
                break
    (require4H and hit4H) or (require1H and hit1H) or (not require4H and not require1H)

sweepsLowLiq(sweepWick, sweepClose) =>
    tol   = pts(liqTol)
    hit4H = false
    hit1H = false
    if require4H and array.size(ssl4H) > 0
        for k = 0 to array.size(ssl4H) - 1
            lvl = array.get(ssl4H, k)
            if sweepWick <= lvl and lvl <= sweepClose + tol   // wick atinge/depaseste nivelul
                hit4H := true
                break
    if require1H and array.size(ssl1H) > 0
        for k = 0 to array.size(ssl1H) - 1
            lvl = array.get(ssl1H, k)
            if sweepWick <= lvl and lvl <= sweepClose + tol   // wick atinge/depaseste nivelul
                hit1H := true
                break
    (require4H and hit4H) or (require1H and hit1H) or (not require4H and not require1H)

// ════════════════════════════════════════════════════════════════════
// PATTERN TYPE B  (calculat PRIMUL pentru excluderea Pattern A)
//   bar[0]=L3(sweep+entry)  bar[1]=L2(twin)  bar[2]=L1(twin)
//   CONDITIE TWIN: high[1] ≈ high[2] (TT-B) sau low[1] ≈ low[2] (TB-B)
// ════════════════════════════════════════════════════════════════════
twinHi    = math.max(high[1], high[2])
twinLoRef = math.min(high[1], high[2])
twinLo    = math.min(low[1],  low[2])
twinHiRef = math.max(low[1],  low[2])

// TT-B: L1 si L2 trebuie sa aiba HIGHS APROPIATE (twin tops reale)
ttb_twins  = math.abs(high[1] - high[2]) <= pts(twinTol)
ttb_sweep  = high[0] > twinHi + pts(minSweepB)
ttb_close  = close   < twinLo      // MSS: close sub twin lows (nu doar sub twin highs)
// Filtru structura TT-B: bara din stanga twin-ului stang (bar[3]) NU trebuie sa aiba HH sau LL spike
// low[3] >= low[2]: bar[3] nu a spart in jos inainte de L1 (nu spike bullish inainte de TT)
ttb_signal = ttb_twins and ta.highest(high, localLookback)[3] < twinLoRef and low[3] >= low[2] and ttb_sweep and ttb_close and (close[1] < open[1]) and (close < open) and sweepsHighLiq(high[0], close[0]) and inSession and noTrade and inHighZone

// TB-B: L1 si L2 trebuie sa aiba LOWS APROPIATE (twin bottoms reale)
tbb_twins  = math.abs(low[1] - low[2]) <= pts(twinTol)
tbb_sweep  = low[0]  < twinLo - pts(minSweepB)
tbb_close  = close   > twinHi      // MSS: close peste twin highs (nu doar peste twin lows)
// Filtru structura TB-B: bara din stanga twin-ului stang (bar[3]) NU trebuie sa aiba LL sau HH spike
// high[3] <= high[2]: bar[3] nu a spart in sus inainte de L1 (nu spike bearish inainte de TB)
tbb_signal = tbb_twins and ta.lowest(low, localLookback)[3] > twinHiRef and high[3] <= high[2] and tbb_sweep and tbb_close and (close[1] > open[1]) and (close > open) and sweepsLowLiq(low[0], close[0]) and inSession and noTrade and inLowZone

// ════════════════════════════════════════════════════════════════════
// PATTERN TYPE A  (exclus daca Pattern B a aparut pe bara anterioara)
//   bar[2]=L1  bar[1]=L2(sweep)  bar[0]=L3(confirmare+entry)
//   Bare CONSECUTIVE — fara gap intre ele
// ════════════════════════════════════════════════════════════════════
var bool lastBarB = false

// TT-A: L2(bar[1]) sweepuieste high-ul L1(bar[2]) si inchide sub el
float l1hi_A = high[2]
tta_sweep    = high[1] > high[2] and close[1] < high[2]

// TB-A: L2(bar[1]) sweepuieste low-ul L1(bar[2]) si inchide deasupra lui
float l1lo_A = low[2]
tba_sweep    = low[1] < low[2] and close[1] > low[2]

// Filtru structura: bara din stanga L1 (bar[3]) NU trebuie sa aiba HH spike (TB) sau LL spike (TT)
// high[3] <= high[2]: bar[3] nu a spart in sus inainte de L1 (nu spike bearish → L1 nu e bottom dupa distributie)
// low[3]  >= low[2] : bar[3] nu a spart in jos inainte de L1 (nu spike bullish → L1 nu e top dupa acumulare)
// MSS (Market Structure Shift): L3 trebuie sa inchida DINCOLO de extrema L1
// TT-A MSS: close < low[2]  → bara L3 inchide sub low-ul lui L1 = shift bearish
// TB-A MSS: close > high[2] → bara L3 inchide peste high-ul lui L1 = shift bullish
tta_signal = tta_sweep and ta.highest(high, localLookback)[3] < high[2] and low[3] >= low[2] and (close[1] < open[1]) and (close < open) and close < low[2] and sweepsHighLiq(high[1], close[1]) and inSession and noTrade and not lastBarB and not ttb_signal and inHighZone
tba_signal = tba_sweep and ta.lowest (low,  localLookback)[3] > low[2]  and high[3] <= high[2] and (close[1] > open[1]) and (close > open) and close > high[2] and sweepsLowLiq (low[1],  close[1]) and inSession and noTrade and not lastBarB and not tbb_signal and inLowZone

// Actualizeaza lastBarB pentru bara urmatoare
lastBarB := ttb_signal or tbb_signal

// ════════════════════════════════════════════════════════════════════
// ENTRY LA INCHIDEREA L3
// ════════════════════════════════════════════════════════════════════
var float trSL       = na   // SL curent (se actualizeaza la BE)
var float trTP       = na   // TP al tradului curent
var float trEntry    = na   // entry price
var float trOrigRisk = na   // riscul original in puncte (pentru calcul R)
var int   trDir      = 0    // -1 short / +1 long
var bool  beMoved    = false
var bool  visExited  = true  // true = eticheta exit deja creata (sau niciun trade deschis)

if tta_signal
    float sl = high[1] + pts(slBuf)
    float rk = sl - close
    float tp = close - rk * rrRatio
    if rk > 0 and tp < close
        strategy.entry("SELL A", strategy.short, comment="TT-A 4H/1H")
        strategy.exit("EX A",    "SELL A", stop=sl, limit=tp)
        tradesToday += 1
        trSL       := sl
        trTP       := tp
        trEntry    := close
        trOrigRisk := rk
        trDir      := -1
        beMoved    := false
        visExited  := false

if tba_signal
    float sl = low[1] - pts(slBuf)
    float rk = close - sl
    float tp = close + rk * rrRatio
    if rk > 0 and tp > close
        strategy.entry("BUY A", strategy.long, comment="TB-A 4H/1H")
        strategy.exit("EX A2",  "BUY A", stop=sl, limit=tp)
        tradesToday += 1
        trSL       := sl
        trTP       := tp
        trEntry    := close
        trOrigRisk := rk
        trDir      := 1
        beMoved    := false
        visExited  := false

if ttb_signal
    float sl = high[0] + pts(slBuf)
    float rk = sl - close
    float tp = close - rk * rrRatio
    if rk > 0 and tp < close
        strategy.entry("SELL B", strategy.short, comment="TT-B 4H/1H")
        strategy.exit("EX B",    "SELL B", stop=sl, limit=tp)
        tradesToday += 1
        trSL       := sl
        trTP       := tp
        trEntry    := close
        trOrigRisk := rk
        trDir      := -1
        beMoved    := false
        visExited  := false

if tbb_signal
    float sl = low[0] - pts(slBuf)
    float rk = close - sl
    float tp = close + rk * rrRatio
    if rk > 0 and tp > close
        strategy.entry("BUY B", strategy.long, comment="TB-B 4H/1H")
        strategy.exit("EX B2",  "BUY B", stop=sl, limit=tp)
        tradesToday += 1
        trSL       := sl
        trTP       := tp
        trEntry    := close
        trOrigRisk := rk
        trDir      := 1
        beMoved    := false
        visExited  := false

// ── BE: muta SL la entry cand pretul atinge 1:1 ──────────────────────
if strategy.position_size != 0 and not beMoved and not na(trEntry) and not na(trSL)
    riskPts = math.abs(trEntry - trSL)
    if trDir < 0 and close <= trEntry - riskPts
        // short: bara s-a inchis la sau sub 1R → muta SL la entry (BE)
        // folosim close (nu low) pentru consistenta cu process_orders_on_close=true
        strategy.exit("EX A", "SELL A", stop=trEntry, limit=trEntry - riskPts * rrRatio)
        strategy.exit("EX B", "SELL B", stop=trEntry, limit=trEntry - riskPts * rrRatio)
        trSL    := trEntry   // actualizeaza SL vizual la BE
        beMoved := true
    else if trDir > 0 and close >= trEntry + riskPts
        // long: bara s-a inchis la sau peste 1R → muta SL la entry (BE)
        strategy.exit("EX A2", "BUY A", stop=trEntry, limit=trEntry + riskPts * rrRatio)
        strategy.exit("EX B2", "BUY B", stop=trEntry, limit=trEntry + riskPts * rrRatio)
        trSL    := trEntry   // actualizeaza SL vizual la BE
        beMoved := true

// ── Exit labels: detectie din miscarea pretului (SL/TP hit) ──────────
// Folosim close pentru consistenta cu process_orders_on_close=true
// (strategy executa la close, nu la high/low intrabar)
if not visExited and trDir != 0 and not na(trSL) and not na(trTP) and not na(trEntry) and not na(trOrigRisk)
    _hitSL = (trDir == -1 and close >= trSL) or (trDir == 1 and close <= trSL)
    _hitTP = (trDir == -1 and close <= trTP) or (trDir == 1 and close >= trTP)
    if _hitSL or _hitTP
        _ep   = _hitSL ? trSL : trTP
        _pnl  = trDir == -1 ? trEntry - _ep : _ep - trEntry
        _rMul = trOrigRisk > 0 ? _pnl / trOrigRisk : 0.0
        _rStr = (_rMul >= 0 ? "+" : "") + str.tostring(math.round(_rMul, 1), "#.#") + "R"
        label.new(bar_index, _ep,
                  (trDir == -1 ? "Exit S\n" : "Exit L\n") + _rStr,
                  style     = trDir == -1 ? label.style_arrowup : label.style_arrowdown,
                  color     = _rMul >= 0 ? color.new(color.purple, 20) : color.gray,
                  textcolor = color.white,
                  size      = size.small)
        visExited := true

// ════════════════════════════════════════════════════════════════════
// CONSUM NIVELURI MTF — se sterge nivelul DOAR dupa un semnal valid
//
// Regula noua: nivelul este consumat NUMAI cand un pattern s-a format
// pe el (nu la orice bara care se apropie).
// Asta previne golirea prematura a array-urilor pe TF mici (5min),
// unde 48 bare/4H ar sterge instantaneu orice nivel nou adaugat.
// ════════════════════════════════════════════════════════════════════
liqTolPts = pts(liqTol)
if tta_signal or ttb_signal
    if array.size(bsl4H) > 0
        for k = array.size(bsl4H) - 1 to 0
            if high[1] >= array.get(bsl4H, k) - liqTolPts or high[0] >= array.get(bsl4H, k) - liqTolPts
                array.remove(bsl4H, k)
    if array.size(bsl1H) > 0
        for k = array.size(bsl1H) - 1 to 0
            if high[1] >= array.get(bsl1H, k) - liqTolPts or high[0] >= array.get(bsl1H, k) - liqTolPts
                array.remove(bsl1H, k)
if tba_signal or tbb_signal
    if array.size(ssl4H) > 0
        for k = array.size(ssl4H) - 1 to 0
            if low[1] <= array.get(ssl4H, k) + liqTolPts or low[0] <= array.get(ssl4H, k) + liqTolPts
                array.remove(ssl4H, k)
    if array.size(ssl1H) > 0
        for k = array.size(ssl1H) - 1 to 0
            if low[1] <= array.get(ssl1H, k) + liqTolPts or low[0] <= array.get(ssl1H, k) + liqTolPts
                array.remove(ssl1H, k)

// ════════════════════════════════════════════════════════════════════
// VIZUALIZARE  —  niveluri MTF
//   4H BSL (highs) = linii rosii orizontale           → potential SELL
//   4H SSL (lows)  = linii verzi orizontale           → potential BUY
//   1H BSL (highs) = linii portocalii subtiri         → potential SELL intern
//   1H SSL (lows)  = linii albastre subtiri           → potential BUY intern
// ════════════════════════════════════════════════════════════════════
var array<line>  lines4H  = array.new_line(0)
var array<line>  lines1H  = array.new_line(0)
var array<label> labels4H = array.new_label(0)
var array<label> labels1H = array.new_label(0)

if barstate.islast
    while array.size(lines4H) > 0
        line.delete(array.pop(lines4H))
    while array.size(lines1H) > 0
        line.delete(array.pop(lines1H))
    while array.size(labels4H) > 0
        label.delete(array.pop(labels4H))
    while array.size(labels1H) > 0
        label.delete(array.pop(labels1H))

    if show4H
        if array.size(bsl4H) > 0
            for k = 0 to array.size(bsl4H) - 1
                lvl = array.get(bsl4H, k)
                array.push(lines4H,  line.new(bar_index, lvl, bar_index + 1, lvl, extend=extend.both, color=color.new(color.red, 20), style=line.style_dashed, width=2))
                array.push(labels4H, label.new(bar_index + 2, lvl, "4H BSL", color=color.new(color.red, 50), textcolor=color.red, style=label.style_label_left, size=size.tiny))
        if array.size(ssl4H) > 0
            for k = 0 to array.size(ssl4H) - 1
                lvl = array.get(ssl4H, k)
                array.push(lines4H,  line.new(bar_index, lvl, bar_index + 1, lvl, extend=extend.both, color=color.new(color.teal, 20), style=line.style_dashed, width=2))
                array.push(labels4H, label.new(bar_index + 2, lvl, "4H SSL", color=color.new(color.teal, 50), textcolor=color.teal, style=label.style_label_left, size=size.tiny))

    if show1H
        if array.size(bsl1H) > 0
            for k = 0 to array.size(bsl1H) - 1
                lvl = array.get(bsl1H, k)
                array.push(lines1H,  line.new(bar_index, lvl, bar_index + 1, lvl, extend=extend.both, color=color.new(color.orange, 40), style=line.style_dotted, width=1))
                array.push(labels1H, label.new(bar_index + 2, lvl, "1H BSL", color=color.new(color.orange, 60), textcolor=color.orange, style=label.style_label_left, size=size.tiny))
        if array.size(ssl1H) > 0
            for k = 0 to array.size(ssl1H) - 1
                lvl = array.get(ssl1H, k)
                array.push(lines1H,  line.new(bar_index, lvl, bar_index + 1, lvl, extend=extend.both, color=color.new(color.blue, 40), style=line.style_dotted, width=1))
                array.push(labels1H, label.new(bar_index + 2, lvl, "1H SSL", color=color.new(color.blue, 60), textcolor=color.blue, style=label.style_label_left, size=size.tiny))

// ════════════════════════════════════════════════════════════════════
// VIZUALIZARE  —  semnale 5min
// ════════════════════════════════════════════════════════════════════

// plotshape nu are limita de 500 — elibereaza toate label-slot-urile pentru Exit labels
plotshape(showLabels and tta_signal, title="TT-A", style=shape.triangledown, location=location.abovebar, color=colorSell, text="TT-A", textcolor=color.white, size=size.tiny)
plotshape(showLabels and tba_signal, title="TB-A", style=shape.triangleup,   location=location.belowbar, color=colorBuy,  text="TB-A", textcolor=color.white, size=size.tiny)
plotshape(showLabels and ttb_signal, title="TT-B", style=shape.triangledown, location=location.abovebar, color=colorSell, text="TT-B", textcolor=color.white, size=size.tiny)
plotshape(showLabels and tbb_signal, title="TB-B", style=shape.triangleup,   location=location.belowbar, color=colorBuy,  text="TB-B", textcolor=color.white, size=size.tiny)

if showZone
    if tta_signal
        box.new(bar_index-1, high[1], bar_index, l1hi_A, border_color=color.new(color.red,30), bgcolor=color.new(color.red,80))
        line.new(bar_index-3, l1hi_A, bar_index, l1hi_A, color=color.new(color.red,40), style=line.style_dashed, width=1)
    if tba_signal
        box.new(bar_index-1, l1lo_A, bar_index, low[1], border_color=color.new(color.teal,30), bgcolor=color.new(color.teal,80))
        line.new(bar_index-3, l1lo_A, bar_index, l1lo_A, color=color.new(color.teal,40), style=line.style_dashed, width=1)
    if ttb_signal
        box.new(bar_index-2, high[0], bar_index, twinHi, border_color=color.new(color.maroon,30), bgcolor=color.new(color.maroon,85))
        line.new(bar_index-2, twinHi, bar_index, twinHi, color=color.new(color.maroon,30), style=line.style_dashed, width=1)
    if tbb_signal
        box.new(bar_index-2, twinLo, bar_index, low[0], border_color=color.new(color.green,30), bgcolor=color.new(color.green,85))
        line.new(bar_index-2, twinLo, bar_index, low[0], color=color.new(color.green,30), style=line.style_dashed, width=1)

if showSLLine
    if tta_signal
        line.new(bar_index, high[1]+pts(slBuf), bar_index+8, high[1]+pts(slBuf), color=color.new(color.red,20), style=line.style_dotted, width=2)
    if tba_signal
        line.new(bar_index, low[1]-pts(slBuf), bar_index+8, low[1]-pts(slBuf), color=color.new(color.teal,20), style=line.style_dotted, width=2)
    if ttb_signal
        line.new(bar_index, high[0]+pts(slBuf), bar_index+8, high[0]+pts(slBuf), color=color.new(color.maroon,20), style=line.style_dotted, width=2)
    if tbb_signal
        line.new(bar_index, low[0]-pts(slBuf), bar_index+8, low[0]-pts(slBuf), color=color.new(color.green,20), style=line.style_dotted, width=2)
