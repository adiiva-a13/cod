//@version=5
strategy("AdiivaTwezer",
         overlay              = true,
         default_qty_type     = strategy.percent_of_equity,
         default_qty_value    = 2,
         commission_type      = strategy.commission.percent,
         commission_value     = 0.02,
         slippage             = 2,
         max_bars_back        = 500)

// ════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════

// ── MTF ───────────────────────────────────────────────────────────────
grpMTF = "=== MULTI-TIMEFRAME LIQUIDITY ==="
tf4H      = input.timeframe("240", "Timeframe major (liq externa)",    group=grpMTF)
tf1H      = input.timeframe("60",  "Timeframe intern (liq interna)",   group=grpMTF)
pivot4H   = input.int(3,  "Pivot bars 4H  (swing lookback)",           group=grpMTF, minval=1, maxval=10)
pivot1H   = input.int(3,  "Pivot bars 1H  (swing lookback)",           group=grpMTF, minval=1, maxval=10)
maxLvl    = input.int(5,  "Niveluri max stocate per TF",               group=grpMTF, minval=1, maxval=10)
liqTol    = input.float(3.0, "Toleranta sweep → nivel MTF (puncte)",   group=grpMTF, minval=0.0, step=0.5,
                         tooltip="Wick-ul sweep trebuie sa ajunga in aceasta distanta fata de nivelul 4H/1H")
require4H = input.bool(true,  "Obliga sweep pe nivel 4H (liq majora)", group=grpMTF)
require1H = input.bool(true,  "Sau pe nivel 1H (liq interna)",         group=grpMTF)

// ── PATTERN TYPE A  (L1 → L2 sweep → L3 confirmare) ──────────────────
grp1 = "=== PATTERN TYPE A  (3-candle, entry pe L3) ==="
maxGapA   = input.int  (5,   "Bare maxime intre L1 si L2 (cluster)",   group=grp1, minval=1, maxval=30)
minSweepA = input.float(0.0, "Sweep minim L2 peste L1 (puncte)",       group=grp1, minval=0.0, step=0.5)

// ── PATTERN TYPE B  (L1 ≈ L2 twin → L3 sweep ambele, entry pe L3) ────
grp2 = "=== PATTERN TYPE B  (twin candle, entry pe L3) ==="
twinTol   = input.float(5.0, "Toleranta twin high/low L1≈L2 (puncte)", group=grp2, minval=0.0, step=0.5)
minSweepB = input.float(0.0, "Sweep minim L3 peste ambele (puncte)",   group=grp2, minval=0.0, step=0.5)

// ── ENTRY / EXIT ──────────────────────────────────────────────────────
grp3 = "=== ENTRY / EXIT ==="
rrRatio   = input.float(2.0, "Risk : Reward",                          group=grp3, minval=0.5, step=0.5)
slBuf     = input.float(2.0, "SL Buffer (puncte dupa wick extrem)",    group=grp3, minval=0.0, step=0.5)

// ── FILTRU ORE ────────────────────────────────────────────────────────
grp4 = "=== FILTRU ORE (server) ==="
useTime   = input.bool (false,"Filtru ore activ",                       group=grp4)
startH    = input.int  (9,   "Ora start",                              group=grp4, minval=0,  maxval=23)
endH      = input.int  (17,  "Ora end",                                group=grp4, minval=1,  maxval=24)

// ── VIZUALIZARE ───────────────────────────────────────────────────────
grp5 = "=== VIZUALIZARE ==="
showLabels = input.bool(true,  "Etichete TT / TB",       group=grp5)
showZone   = input.bool(true,  "Box zona sweep (5min)",   group=grp5)
showSLLine = input.bool(true,  "Linie SL",                group=grp5)
show4H     = input.bool(true,  "Niveluri 4H pe chart",    group=grp5)
show1H     = input.bool(true,  "Niveluri 1H pe chart",    group=grp5)

// ════════════════════════════════════════════════════════════════════
// HELPERS
// ════════════════════════════════════════════════════════════════════
inSession = not useTime or (hour >= startH and hour < endH)
pts(x)    => x * syminfo.mintick
noTrade   = strategy.position_size == 0

// ════════════════════════════════════════════════════════════════════
// MULTI-TIMEFRAME  — identificare niveluri de lichiditate
//
//  4H pivot HIGH  = Buy-Side Liquidity  (BSL) majora
//       → validare pentru pattern SELL (TT): sweep-ul trebuie sa atinga/depaseasca un pivot 4H high
//  4H pivot LOW   = Sell-Side Liquidity (SSL) majora
//       → validare pentru pattern BUY  (TB): sweep-ul trebuie sa atinga/depaseasca un pivot 4H low
//  1H pivot HIGH  = BSL interna
//  1H pivot LOW   = SSL interna
// ════════════════════════════════════════════════════════════════════

// ── Requesturi higher TF ──────────────────────────────────────────────
ph4H_raw = request.security(syminfo.tickerid, tf4H,
             ta.pivothigh(pivot4H, pivot4H),
             gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pl4H_raw = request.security(syminfo.tickerid, tf4H,
             ta.pivotlow (pivot4H, pivot4H),
             gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ph1H_raw = request.security(syminfo.tickerid, tf1H,
             ta.pivothigh(pivot1H, pivot1H),
             gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pl1H_raw = request.security(syminfo.tickerid, tf1H,
             ta.pivotlow (pivot1H, pivot1H),
             gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ── Stocare niveluri in array-uri ─────────────────────────────────────
var array<float> bsl4H = array.new_float(0)  // 4H pivot highs (BSL major)
var array<float> ssl4H = array.new_float(0)  // 4H pivot lows  (SSL major)
var array<float> bsl1H = array.new_float(0)  // 1H pivot highs (BSL intern)
var array<float> ssl1H = array.new_float(0)  // 1H pivot lows  (SSL intern)

addLevel(arr, val, maxSize) =>
    if not na(val)
        // Nu adauga duplicate (acelasi nivel)
        isDup = false
        for k = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, k) - val) < pts(0.5)
                isDup := true
                break
        if not isDup
            array.unshift(arr, val)
            if array.size(arr) > maxSize
                array.pop(arr)

addLevel(bsl4H, ph4H_raw, maxLvl)
addLevel(ssl4H, pl4H_raw, maxLvl)
addLevel(bsl1H, ph1H_raw, maxLvl)
addLevel(ssl1H, pl1H_raw, maxLvl)

// ── Validare: sweep-ul a atins un nivel MTF? ──────────────────────────
// Pentru TT (SELL): sweep wick (high) trebuie sa atinga un BSL 4H sau 1H
sweepsHighLiq(sweepWick) =>
    tol   = pts(liqTol)
    hit4H = false
    hit1H = false
    if require4H
        for k = 0 to array.size(bsl4H) - 1
            if sweepWick >= array.get(bsl4H, k) - tol
                hit4H := true
                break
    if require1H
        for k = 0 to array.size(bsl1H) - 1
            if sweepWick >= array.get(bsl1H, k) - tol
                hit1H := true
                break
    // Valid daca a atins cel putin un nivel activ
    (require4H and hit4H) or (require1H and hit1H) or (not require4H and not require1H)

// Pentru TB (BUY): sweep wick (low) trebuie sa atinga un SSL 4H sau 1H
sweepsLowLiq(sweepWick) =>
    tol   = pts(liqTol)
    hit4H = false
    hit1H = false
    if require4H
        for k = 0 to array.size(ssl4H) - 1
            if sweepWick <= array.get(ssl4H, k) + tol
                hit4H := true
                break
    if require1H
        for k = 0 to array.size(ssl1H) - 1
            if sweepWick <= array.get(ssl1H, k) + tol
                hit1H := true
                break
    (require4H and hit4H) or (require1H and hit1H) or (not require4H and not require1H)

// ════════════════════════════════════════════════════════════════════
// PATTERN TYPE A  (entry pe bara L3 — confirmare)
//   bar[0]=L3  bar[1]=L2(sweep)  bar[2..maxGapA+1]=L1 cluster
// ════════════════════════════════════════════════════════════════════
float l1hi_A = na
float l1lo_A = na
tta_sweep = false
tba_sweep = false

for i = 2 to maxGapA + 1
    // TT-A
    if high[1] > high[i] + pts(minSweepA) and close[1] < high[i]
        levelOk = true
        if i > 2
            for j = 2 to i - 1
                if high[j] >= high[i]
                    levelOk := false
                    break
        if levelOk
            if na(l1hi_A) or high[i] > l1hi_A
                l1hi_A    := high[i]
                tta_sweep := true
    // TB-A
    if low[1] < low[i] - pts(minSweepA) and close[1] > low[i]
        levelOk = true
        if i > 2
            for j = 2 to i - 1
                if low[j] <= low[i]
                    levelOk := false
                    break
        if levelOk
            if na(l1lo_A) or low[i] < l1lo_A
                l1lo_A    := low[i]
                tba_sweep := true

// Confirmare L3 + validare MTF
tta_signal = tta_sweep and (close < open) and sweepsHighLiq(high[1]) and inSession and noTrade
tba_signal = tba_sweep and (close > open) and sweepsLowLiq (low[1])  and inSession and noTrade

// ════════════════════════════════════════════════════════════════════
// PATTERN TYPE B  (entry pe bara L3 — sweep + entry)
//   bar[0]=L3(sweep+entry)  bar[1]=L2(twin)  bar[2]=L1(twin)
// ════════════════════════════════════════════════════════════════════
twinHi      = math.max(high[1], high[2])
twinLoRef   = math.min(high[1], high[2])
twinLo      = math.min(low[1],  low[2])
twinHiRef   = math.max(low[1],  low[2])

// TT-B
ttb_twins  = math.abs(high[2] - high[1]) <= pts(twinTol)
ttb_sweep  = high[0] > twinHi + pts(minSweepB)
ttb_close  = close   < twinLoRef
ttb_signal = ttb_twins and ttb_sweep and ttb_close and sweepsHighLiq(high[0]) and inSession and noTrade

// TB-B
tbb_twins  = math.abs(low[2] - low[1]) <= pts(twinTol)
tbb_sweep  = low[0]  < twinLo - pts(minSweepB)
tbb_close  = close   > twinHiRef
tbb_signal = tbb_twins and tbb_sweep and tbb_close and sweepsLowLiq(low[0]) and inSession and noTrade

// ════════════════════════════════════════════════════════════════════
// ENTRY LA INCHIDEREA L3
// ════════════════════════════════════════════════════════════════════
if tta_signal
    float sl = high[1] + pts(slBuf)
    float rk = sl - close
    float tp = close - rk * rrRatio
    if rk > 0 and tp < close
        strategy.entry("SELL A", strategy.short, comment="TT-A 4H/1H")
        strategy.exit("EX A",    "SELL A", stop=sl, limit=tp)

if tba_signal
    float sl = low[1] - pts(slBuf)
    float rk = close - sl
    float tp = close + rk * rrRatio
    if rk > 0 and tp > close
        strategy.entry("BUY A", strategy.long, comment="TB-A 4H/1H")
        strategy.exit("EX A2",  "BUY A", stop=sl, limit=tp)

if ttb_signal
    float sl = high[0] + pts(slBuf)
    float rk = sl - close
    float tp = close - rk * rrRatio
    if rk > 0 and tp < close
        strategy.entry("SELL B", strategy.short, comment="TT-B 4H/1H")
        strategy.exit("EX B",    "SELL B", stop=sl, limit=tp)

if tbb_signal
    float sl = low[0] - pts(slBuf)
    float rk = close - sl
    float tp = close + rk * rrRatio
    if rk > 0 and tp > close
        strategy.entry("BUY B", strategy.long, comment="TB-B 4H/1H")
        strategy.exit("EX B2",  "BUY B", stop=sl, limit=tp)

// ════════════════════════════════════════════════════════════════════
// VIZUALIZARE  —  niveluri MTF
//   4H BSL (highs) = linii rosii orizontale           → potential SELL
//   4H SSL (lows)  = linii verzi orizontale           → potential BUY
//   1H BSL (highs) = linii portocalii subtiri         → potential SELL intern
//   1H SSL (lows)  = linii albastre subtiri           → potential BUY intern
// ════════════════════════════════════════════════════════════════════
var array<line> lines4H = array.new_line(0)
var array<line> lines1H = array.new_line(0)

// Curata liniile vechi si redeseneaza la fiecare schimbare de nivel
// (dezavantaj: redeseneaza frecvent, dar pastreaza corectitudinea)
if barstate.islast
    // Sterge linii vechi
    while array.size(lines4H) > 0
        line.delete(array.pop(lines4H))
    while array.size(lines1H) > 0
        line.delete(array.pop(lines1H))

    // Niveluri 4H
    if show4H
        for k = 0 to array.size(bsl4H) - 1
            lvl = array.get(bsl4H, k)
            array.push(lines4H, line.new(bar_index - 200, lvl, bar_index + 50, lvl, color=color.new(color.red, 20), style=line.style_dashed, width=2))
            label.new(bar_index + 51, lvl, "4H BSL", color=color.new(color.red, 50), textcolor=color.red, style=label.style_label_left, size=size.tiny)
        for k = 0 to array.size(ssl4H) - 1
            lvl = array.get(ssl4H, k)
            array.push(lines4H, line.new(bar_index - 200, lvl, bar_index + 50, lvl, color=color.new(color.teal, 20), style=line.style_dashed, width=2))
            label.new(bar_index + 51, lvl, "4H SSL", color=color.new(color.teal, 50), textcolor=color.teal, style=label.style_label_left, size=size.tiny)

    // Niveluri 1H
    if show1H
        for k = 0 to array.size(bsl1H) - 1
            lvl = array.get(bsl1H, k)
            array.push(lines1H, line.new(bar_index - 100, lvl, bar_index + 50, lvl, color=color.new(color.orange, 40), style=line.style_dotted, width=1))
            label.new(bar_index + 51, lvl, "1H BSL", color=color.new(color.orange, 60), textcolor=color.orange, style=label.style_label_left, size=size.tiny)
        for k = 0 to array.size(ssl1H) - 1
            lvl = array.get(ssl1H, k)
            array.push(lines1H, line.new(bar_index - 100, lvl, bar_index + 50, lvl, color=color.new(color.blue, 40), style=line.style_dotted, width=1))
            label.new(bar_index + 51, lvl, "1H SSL", color=color.new(color.blue, 60), textcolor=color.blue, style=label.style_label_left, size=size.tiny)

// ════════════════════════════════════════════════════════════════════
// VIZUALIZARE  —  semnale 5min
// ════════════════════════════════════════════════════════════════════

// Etichete
if showLabels
    if tta_signal
        label.new(bar_index, high + pts(4),
                  "TT-A\n↓ SELL", style=label.style_label_down,
                  color=color.red, textcolor=color.white, size=size.small)
    if tba_signal
        label.new(bar_index, low - pts(4),
                  "TB-A\n↑ BUY", style=label.style_label_up,
                  color=color.teal, textcolor=color.white, size=size.small)
    if ttb_signal
        label.new(bar_index, high + pts(4),
                  "TT-B\n↓ SELL", style=label.style_label_down,
                  color=color.maroon, textcolor=color.white, size=size.small)
    if tbb_signal
        label.new(bar_index, low - pts(4),
                  "TB-B\n↑ BUY", style=label.style_label_up,
                  color=color.green, textcolor=color.white, size=size.small)

// Box zona sweep
if showZone
    if tta_signal
        // TT-A: wick L2 (high[1]) e DEASUPRA nivelului L1 → top=high[1], bottom=l1hi_A
        box.new(bar_index-1, high[1], bar_index, l1hi_A,
                border_color=color.new(color.red,30), bgcolor=color.new(color.red,80))
        line.new(bar_index-maxGapA-1, l1hi_A, bar_index, l1hi_A,
                 color=color.new(color.red,40), style=line.style_dashed, width=1)
    if tba_signal
        // TB-A: wick L2 (low[1]) e SUB nivelul L1 → top=l1lo_A, bottom=low[1]
        box.new(bar_index-1, l1lo_A, bar_index, low[1],
                border_color=color.new(color.teal,30), bgcolor=color.new(color.teal,80))
        line.new(bar_index-maxGapA-1, l1lo_A, bar_index, l1lo_A,
                 color=color.new(color.teal,40), style=line.style_dashed, width=1)
    if ttb_signal
        // TT-B: wick L3 (high[0]) e DEASUPRA twin → top=high[0], bottom=twinHi
        box.new(bar_index-2, high[0], bar_index, twinHi,
                border_color=color.new(color.maroon,30), bgcolor=color.new(color.maroon,85))
        line.new(bar_index-2, twinHi, bar_index, twinHi,
                 color=color.new(color.maroon,30), style=line.style_dashed, width=1)
    if tbb_signal
        // TB-B: wick L3 (low[0]) e SUB twin → top=twinLo, bottom=low[0]
        box.new(bar_index-2, twinLo, bar_index, low[0],
                border_color=color.new(color.green,30), bgcolor=color.new(color.green,85))
        line.new(bar_index-2, twinLo, bar_index, low[0],
                 color=color.new(color.green,30), style=line.style_dashed, width=1)

// Linie SL
if showSLLine
    if tta_signal
        line.new(bar_index, high[1]+pts(slBuf), bar_index+8, high[1]+pts(slBuf),
                 color=color.new(color.red,20), style=line.style_dotted, width=2)
    if tba_signal
        line.new(bar_index, low[1]-pts(slBuf), bar_index+8, low[1]-pts(slBuf),
                 color=color.new(color.teal,20), style=line.style_dotted, width=2)
    if ttb_signal
        line.new(bar_index, high[0]+pts(slBuf), bar_index+8, high[0]+pts(slBuf),
                 color=color.new(color.maroon,20), style=line.style_dotted, width=2)
    if tbb_signal
        line.new(bar_index, low[0]-pts(slBuf), bar_index+8, low[0]-pts(slBuf),
                 color=color.new(color.green,20), style=line.style_dotted, width=2)
