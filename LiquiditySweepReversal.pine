//@version=5
strategy("TT / TB – Liquidity Sweep 3 Candles [SMC]",
         overlay              = true,
         default_qty_type     = strategy.percent_of_equity,
         default_qty_value    = 2,
         commission_type      = strategy.commission.percent,
         commission_value     = 0.02,
         slippage             = 2,
         max_bars_back        = 500)

// ════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════
grp1 = "=== PATTERN ==="
minSweep = input.float(0.0,  "Sweep minim deasupra/sub L1 (puncte)",  group=grp1, minval=0.0, step=0.5,
                       tooltip="Bara 2 trebuie sa depaseasca high/low-ul barei 1 cu cel putin X puncte")
maxGap   = input.int  (3,    "Distanta maxima bara1 → bara2 (bare)",  group=grp1, minval=1, maxval=20,
                       tooltip="Cate bare inapoi cautam bara 1 fata de bara 2 (bara de sweep)")

grp2 = "=== ENTRY / EXIT ==="
rrRatio  = input.float(2.0,  "Risk : Reward",                         group=grp2, minval=0.5, step=0.5)
slBuf    = input.float(2.0,  "SL Buffer (puncte dupa wick extrem)",   group=grp2, minval=0.0, step=0.5)

grp3 = "=== FILTRU ORE (server) ==="
useTime  = input.bool (false, "Filtru ore activ",                     group=grp3)
startH   = input.int  (9,    "Ora start",                             group=grp3, minval=0, maxval=23)
endH     = input.int  (17,   "Ora end",                               group=grp3, minval=1, maxval=24)

grp4 = "=== VIZUALIZARE ==="
showLabels = input.bool(true, "Afiseaza etichete TT/TB pe chart",     group=grp4)
showBoxes  = input.bool(true, "Afiseaza zona sweep (box)",            group=grp4)

// ════════════════════════════════════════════════════════════════════
// TIME FILTER
// ════════════════════════════════════════════════════════════════════
inSession = not useTime or (hour >= startH and hour < endH)

// ════════════════════════════════════════════════════════════════════
// HELPER: pret in puncte
// ════════════════════════════════════════════════════════════════════
pts(x) => x * syminfo.mintick

// ════════════════════════════════════════════════════════════════════
// PATTERN DETECTION
//
// Indexarea barelor (perspectiva barei curente = bar[0]):
//   bar[0] = Lumanarea 3 (confirmare, cea pe care intram)
//   bar[1] = Lumanarea 2 (sweep / preluare lichiditate)
//   bar[2..n] = Lumanarea 1 (high sau low initial "twin")
//
// TT (Twin Tops) → SELL:
//   L1 high[n]  <  L2 high[1]  (L2 sweeps deasupra L1)
//   L2 close[1] <  L1 high[n]  (L2 inchide sub nivelul L1 → sweep confirmat)
//   L3 close    <  L3 open     (Lumanarea 3 este Bearish)
//
// TB (Twin Bottoms) → BUY:
//   L1 low[n]   >  L2 low[1]   (L2 sweeps sub L1)
//   L2 close[1] >  L1 low[n]   (L2 inchide deasupra nivelului L1 → sweep confirmat)
//   L3 close    >  L3 open     (Lumanarea 3 este Bullish)
// ════════════════════════════════════════════════════════════════════

var bool tt_found   = false
var bool tb_found   = false
var float tt_sl     = na    // SL SELL = high[1] + buffer
var float tb_sl     = na    // SL BUY  = low[1]  - buffer
var float tt_hi     = na    // high-ul extrem al sweep (pentru vizualizare)
var float tb_lo     = na
var float l1_hi     = na    // nivelul initial L1 (pentru vizualizare)
var float l1_lo     = na

// Bara de sweep = bar[1], cauta L1 in bar[2..maxGap+1]
tt_sweep_ok = false
tb_sweep_ok = false

float best_l1_hi = na
float best_l1_lo = na

for i = 2 to maxGap + 1
    // ─── TT: L2 (bar[1]) a depasit high-ul L1 (bar[i]) ───────────────
    if high[1] > high[i] + pts(minSweep) and close[1] < high[i]
        if na(best_l1_hi) or high[i] > best_l1_hi
            best_l1_hi  := high[i]
            tt_sweep_ok := true

    // ─── TB: L2 (bar[1]) a spart low-ul L1 (bar[i]) ──────────────────
    if low[1] < low[i] - pts(minSweep) and close[1] > low[i]
        if na(best_l1_lo) or low[i] < best_l1_lo
            best_l1_lo  := low[i]
            tb_sweep_ok := true

// ─── Confirmare cu bara 3 (bar[0]) ────────────────────────────────────
// TT → bara 3 Bearish
tt_confirm = close < open

// TB → bara 3 Bullish
tb_confirm = close > open

// ─── Semnale finale ────────────────────────────────────────────────────
tt_signal = tt_sweep_ok and tt_confirm and inSession and strategy.position_size == 0
tb_signal = tb_sweep_ok and tb_confirm and inSession and strategy.position_size == 0

if tt_signal
    tt_found := true
    tt_sl    := high[1] + pts(slBuf)
    tt_hi    := high[1]
    l1_hi    := best_l1_hi

if tb_signal
    tb_found := true
    tb_sl    := low[1]  - pts(slBuf)
    tb_lo    := low[1]
    l1_lo    := best_l1_lo

// ════════════════════════════════════════════════════════════════════
// ENTRY TRADES  (la inchiderea lumanarii 3)
// ════════════════════════════════════════════════════════════════════

// ─── SELL TT ──────────────────────────────────────────────────────────
if tt_signal
    float risk = tt_sl - close
    float tp   = close - risk * rrRatio
    if risk > 0 and tp < close
        strategy.entry("SELL TT", strategy.short, comment="TT → SHORT")
        strategy.exit("EXIT TT", "SELL TT", stop=tt_sl, limit=tp)

// ─── BUY TB ───────────────────────────────────────────────────────────
if tb_signal
    float risk = close - tb_sl
    float tp   = close + risk * rrRatio
    if risk > 0 and tp > close
        strategy.entry("BUY TB", strategy.long, comment="TB → LONG")
        strategy.exit("EXIT TB", "BUY TB", stop=tb_sl, limit=tp)

// ════════════════════════════════════════════════════════════════════
// VIZUALIZARE
// ════════════════════════════════════════════════════════════════════

// Etichete pe lumanarea 3
if showLabels
    if tt_signal
        label.new(bar_index, high + pts(5),
                  text    = "TT\n↓ SELL",
                  style   = label.style_label_down,
                  color   = color.red,
                  textcolor = color.white,
                  size    = size.small)

    if tb_signal
        label.new(bar_index, low - pts(5),
                  text    = "TB\n↑ BUY",
                  style   = label.style_label_up,
                  color   = color.teal,
                  textcolor = color.white,
                  size    = size.small)

// Box zona sweep (de la nivelul L1 pana la wick-ul extrem al L2)
if showBoxes
    if tt_signal
        box.new(bar_index - 1, tt_hi, bar_index, l1_hi,
                border_color = color.new(color.red, 40),
                bgcolor      = color.new(color.red, 80))

    if tb_signal
        box.new(bar_index - 1, l1_lo, bar_index, tb_lo,
                border_color = color.new(color.teal, 40),
                bgcolor      = color.new(color.teal, 80))

// Linie orizontala la nivelul SL
if tt_signal
    line.new(bar_index - 1, tt_sl, bar_index + 5, tt_sl,
             color = color.new(color.red, 30),
             style = line.style_dashed, width = 1)

if tb_signal
    line.new(bar_index - 1, tb_sl, bar_index + 5, tb_sl,
             color = color.new(color.teal, 30),
             style = line.style_dashed, width = 1)
