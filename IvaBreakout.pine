//@version=5
strategy("IvaBreakout", overlay=true,
         default_qty_type=strategy.fixed, default_qty_value=1,
         max_bars_back=500, calc_on_every_tick=false,
         process_orders_on_close=true, max_labels_count=500,
         pyramiding=1,
         commission_type=strategy.commission.cash_per_order, commission_value=0)

// ═══════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════
i_preset      = input.string("Auto", "Instrument Preset", options=["Auto","Custom","NQ","CL","6E"], group="Preset")
i_vaPercent   = input.float(68.0, "Value Area %",                minval=1, maxval=99, step=1,  group="Volume Profile (SVP)")
i_ticksPerRow = input.int(10,     "Row Size (ticks) [Custom]",   minval=1,                      group="Volume Profile (SVP)")
i_slBuf       = input.float(0.0,  "SL Buffer (pts)",             minval=0.0, step=0.25,         group="Risk")
i_tpR         = input.float(1.0,  "TP la (R)",                   minval=0.5, step=0.5,          group="Exit Strategy")

i_nyEnabled = input.bool(true,  "Enable New York Session",              group="New York Session")
i_nyRSH  = input.int(9,  "Range Start Hour (NY) [Custom]",   minval=0, maxval=23, group="New York Session")
i_nyRSM  = input.int(30, "Range Start Minute (NY) [Custom]", minval=0, maxval=59, group="New York Session")
i_nyREH  = input.int(9,  "Range End Hour (NY) [Custom]",     minval=0, maxval=23, group="New York Session")
i_nyREM  = input.int(45, "Range End Minute (NY) [Custom]",   minval=0, maxval=59, group="New York Session")
i_nyEEH  = input.int(11, "Entry cutoff Hour (NY) [Custom]",  minval=0, maxval=23, group="New York Session")
i_nyEEM  = input.int(0,  "Entry cutoff Min (NY) [Custom]",   minval=0, maxval=59, group="New York Session")
i_eodH   = input.int(16, "EOD Close Hour (NY)",              minval=9, maxval=22, group="New York Session")
i_eodMin = input.int(0,  "EOD Close Minute (NY)",            minval=0, maxval=59, group="New York Session")

i_lonEnabled = input.bool(false, "Enable London Session",             group="London Session")
i_lonRSH = input.int(3,  "Range Start Hour (NY)",    minval=0, maxval=23, group="London Session")
i_lonRSM = input.int(0,  "Range Start Minute (NY)",  minval=0, maxval=59, group="London Session")
i_lonREH = input.int(3,  "Range End Hour (NY)",      minval=0, maxval=23, group="London Session")
i_lonREM = input.int(15, "Range End Minute (NY)",    minval=0, maxval=59, group="London Session")
i_lonEEH = input.int(5,  "Entry cutoff Hour (NY)",   minval=0, maxval=23, group="London Session")
i_lonEEM = input.int(0,  "Entry cutoff Minute (NY)", minval=0, maxval=59, group="London Session")

i_pmtEnabled = input.bool(false,     "Activeaza PMT Alerts",    group="Pick My Trade")
i_pmtToken   = input.string("",      "PMT Token",               group="Pick My Trade")
i_pmtSymbol  = input.string("MNQ1!", "Simbol Tradovate",        group="Pick My Trade")
i_riskUSD    = input.float(200.0,    "Risc per tranzactie ($)", minval=10, step=10, group="Pick My Trade")

// ═══════════════════════════════════════════════════════════
//  TIMEFRAME GUARD
// ═══════════════════════════════════════════════════════════
if timeframe.period != "1"
    runtime.error("⚠️ Acest script functioneaza DOAR pe graficul de 1 MINUT!")

// ═══════════════════════════════════════════════════════════
//  PRESET RESOLUTION
// ═══════════════════════════════════════════════════════════
autoInstr = str.contains(syminfo.root, "NQ") or syminfo.root == "MNQ" ? "NQ" : str.contains(syminfo.root, "CL") or syminfo.root == "MCL" ? "CL" : str.contains(syminfo.root, "6E") ? "6E" : "NQ"
effPreset = i_preset == "Auto" ? autoInstr : i_preset

effTicks  = effPreset == "NQ" ? 10 : effPreset == "CL" ? 5  : effPreset == "6E" ? 2  : i_ticksPerRow
effNyRSH  = effPreset == "NQ" ? 9  : effPreset == "CL" ? 9  : effPreset == "6E" ? 9  : i_nyRSH
effNyRSM  = effPreset == "NQ" ? 30 : effPreset == "CL" ? 30 : effPreset == "6E" ? 30 : i_nyRSM
effNyREH  = effPreset == "NQ" ? 9  : effPreset == "CL" ? 9  : effPreset == "6E" ? 9  : i_nyREH
effNyREM  = effPreset == "NQ" ? 45 : effPreset == "CL" ? 45 : effPreset == "6E" ? 45 : i_nyREM
effNyEEH  = effPreset == "NQ" ? 11 : effPreset == "CL" ? 11 : effPreset == "6E" ? 11 : i_nyEEH
effNyEEM  = effPreset == "NQ" ? 0  : effPreset == "CL" ? 0  : effPreset == "6E" ? 0  : i_nyEEM

pmtTickVal = effPreset == "NQ" ? 0.50 : effPreset == "CL" ? 1.00 : effPreset == "6E" ? 6.25 : 0.50

pmtQty(slDist) =>
    ticks  = math.round(slDist / syminfo.mintick)
    rawQty = math.floor(i_riskUSD / (ticks * pmtTickVal))
    maxQty = effPreset == "6E" ? 6 : 999
    math.min(maxQty, rawQty)

entryQty(riskAmt) =>
    _base    = pmtQty(riskAmt)
    _oneRisk = (riskAmt / syminfo.mintick) * pmtTickVal
    if _base >= 2
        _base
    else if 2.0 * _oneRisk <= i_riskUSD + 60.0
        2
    else if _oneRisk <= i_riskUSD + 60.0
        1
    else
        0

// ═══════════════════════════════════════════════════════════
//  5-MIN CANDLE TRACKING (pe graficul de 1 min)
//  La fiecare bar, acumulam H/L curent.
//  Cand incepe un nou interval de 5 min, salvam bara anterioara
//  in p5H/p5L/p5C si resetam acumulatorul.
// ═══════════════════════════════════════════════════════════
var float _c5H = na
var float _c5L = na
var float p5H  = na
var float p5L  = na
var float p5C  = na

new5 = timeframe.change("5")

if new5
    p5H  := _c5H
    p5L  := _c5L
    p5C  := close[1]
    _c5H := high
    _c5L := low
else
    _c5H := na(_c5H) ? high : math.max(_c5H, high)
    _c5L := na(_c5L) ? low  : math.min(_c5L, low)

// ═══════════════════════════════════════════════════════════
//  NEW YORK TIME
// ═══════════════════════════════════════════════════════════
nyH    = hour(time,   "America/New_York")
nyM    = minute(time, "America/New_York")
nyMins = nyH * 60 + nyM

newDay  = ta.change(dayofmonth) != 0
eodMins = i_eodH * 60 + i_eodMin
eod     = nyMins >= eodMins

// ═══════════════════════════════════════════════════════════
//  ██  NY SESSION – PHASE 1 (logica 1 min, identica cu AdiivaBreakout)  ██
// ═══════════════════════════════════════════════════════════
nyRSMins = effNyRSH * 60 + effNyRSM
nyREMins = effNyREH * 60 + effNyREM
nyEEMins = effNyEEH * 60 + effNyEEM

inRangeNY = nyMins >= nyRSMins and nyMins <= nyREMins

var float nyRH     = na
var float nyRL     = na
var bool  nyRReady = false

if newDay
    nyRH     := na
    nyRL     := na
    nyRReady := false

if inRangeNY
    nyRH := na(nyRH) ? high : math.max(nyRH, high)
    nyRL := na(nyRL) ? low  : math.min(nyRL, low)

var bool _nyRED = false
if newDay
    _nyRED := false

nyRangeJustEnd = i_nyEnabled and not _nyRED and not na(nyRH) and not inRangeNY and
                 nyMins > nyREMins and nyMins < eodMins
if nyRangeJustEnd
    _nyRED := true

nyTradeActive  = i_nyEnabled and nyMins > nyREMins and nyMins < eodMins
nyEntryAllowed = nyTradeActive and nyMins < nyEEMins

if nyRangeJustEnd and not na(nyRH)
    nyRReady := true

var array<float> _nyBH = array.new_float(0)
var array<float> _nyBL = array.new_float(0)
var array<float> _nyBV = array.new_float(0)

if newDay
    array.clear(_nyBH)
    array.clear(_nyBL)
    array.clear(_nyBV)

if inRangeNY
    array.push(_nyBH, high)
    array.push(_nyBL, low)
    array.push(_nyBV, volume)

var float nyPoc  = na
var float nyVah  = na
var float nyVal  = na
var bool  nyVpOk = false

if newDay
    nyPoc  := na
    nyVah  := na
    nyVal  := na
    nyVpOk := false

if nyRangeJustEnd and not nyVpOk and not na(nyRH) and nyRH != nyRL
    rowSize  = effTicks * syminfo.mintick
    gridBase = math.floor(nyRL / rowSize) * rowSize
    rows     = math.max(2, int(math.ceil((nyRH - gridBase) / rowSize)))
    volBins  = array.new_float(rows, 0.0)
    n = array.size(_nyBH)
    for i = 0 to n - 1
        bH = math.min(array.get(_nyBH, i), nyRH)
        bL = math.max(array.get(_nyBL, i), nyRL)
        bV = array.get(_nyBV, i)
        if bH <= bL
            continue
        loBin = math.max(0, math.min(rows - 1, int(math.floor((bL - gridBase) / rowSize))))
        hiBin = math.max(0, math.min(rows - 1, int(math.floor((bH - gridBase) / rowSize))))
        nBins = hiBin - loBin + 1
        vpp   = bV / nBins
        for b = loBin to hiBin
            array.set(volBins, b, array.get(volBins, b) + vpp)
    maxVol   = array.max(volBins)
    pocBin   = array.indexof(volBins, maxVol)
    nyPoc   := gridBase + (pocBin + 0.5) * rowSize
    totalVol = array.sum(volBins)
    vaTarget = totalVol * i_vaPercent / 100.0
    vaLo = pocBin
    vaHi = pocBin
    vaVol = maxVol
    for _i = 0 to rows - 1
        if vaVol >= vaTarget or (vaHi >= rows - 1 and vaLo <= 0)
            break
        addUp   = vaHi < rows - 1 ? array.get(volBins, vaHi + 1) : 0.0
        addDown = vaLo > 0         ? array.get(volBins, vaLo - 1) : 0.0
        if addUp >= addDown
            vaHi  += 1
            vaVol += addUp
        else
            vaLo  -= 1
            vaVol += addDown
    nyVah  := gridBase + (vaHi + 1) * rowSize
    nyVal  := gridBase + vaLo * rowSize
    nyVpOk := true

var float nyPrH = na
var float nyPrL = na
if newDay
    nyPrH := na
    nyPrL := na
if nyTradeActive and nyVpOk
    if high > nyVah
        nyPrH := na(nyPrH) ? high : math.max(nyPrH, high)
    if low < nyVal
        nyPrL := na(nyPrL) ? low  : math.min(nyPrL, low)

nyHalfRange  = not na(nyRH) and not na(nyRL) ? (nyRH + nyRL) / 2.0 : na
nyAllInUpper = nyVpOk and not na(nyHalfRange) and nyVal >= nyHalfRange
nyAllInLower = nyVpOk and not na(nyHalfRange) and nyVah <= nyHalfRange
nyIsVolatile = nyAllInUpper or nyAllInLower

var int  nyState     = 0
var bool nyTradeDone = false

if newDay
    nyState     := 0
    nyTradeDone := false

bool nyBrkUp = nyState == 0 and not nyTradeDone and nyEntryAllowed and nyRReady and close > nyRH
bool nyBrkDn = nyState == 0 and not nyTradeDone and nyEntryAllowed and nyRReady and close < nyRL

if nyBrkUp
    nyState := 1
if nyBrkDn
    nyState := 2

bool nyRetestL = nyState == 1 and nyEntryAllowed and close >= nyRL and close <= nyRH
bool nyRetestS = nyState == 2 and nyEntryAllowed and close >= nyRL and close <= nyRH

var float nyWaitLow  = na
var float nyWaitHigh = na
if newDay
    nyWaitLow  := na
    nyWaitHigh := na

if nyVpOk and nyTradeActive and not nyTradeDone and not na(nyVal)
    if low < nyVal and low > nyRL
        nyWaitLow := na(nyWaitLow) ? low : math.min(nyWaitLow, low)

if nyVpOk and nyTradeActive and not nyTradeDone and not na(nyVah)
    if high > nyVah and high < nyRH
        nyWaitHigh := na(nyWaitHigh) ? high : math.max(nyWaitHigh, high)

nySlLong() =>
    float sl = not na(nyWaitLow) ? nyWaitLow - i_slBuf : not na(nyVal) and nyVpOk ? nyVal - i_slBuf : not na(nyRL) ? nyRL - i_slBuf : close - 10 * syminfo.mintick
    if nyVpOk and not na(nyVal)
        sl := math.min(sl, nyVal - i_slBuf)
    if na(sl) or sl >= close
        sl := not na(nyVal) and not na(nyRL) ? close - (nyVal - nyRL) / 2 : not na(nyRL) ? nyRL - i_slBuf : close - 10 * syminfo.mintick
    if na(sl) or sl >= close
        sl := close - 10 * syminfo.mintick
    sl

nySlShort() =>
    float sl = not na(nyWaitHigh) ? nyWaitHigh + i_slBuf : not na(nyVah) and nyVpOk ? nyVah + i_slBuf : not na(nyRH) ? nyRH + i_slBuf : close + 10 * syminfo.mintick
    if nyVpOk and not na(nyVah)
        sl := math.max(sl, nyVah + i_slBuf)
    if na(sl) or sl <= close
        sl := not na(nyRH) ? nyRH + i_slBuf : close + 10 * syminfo.mintick
    sl

// Trade tracking – NY phase 1
var float nyEntryPx  = na
var float nyRiskAmt  = na
var int   nyDir      = 0
var int   nyEntryBar = na
var int   nyEntryQty = 0
var float nyP1SL     = na   // SL price la intrarea in phase 1

if newDay
    nyEntryPx  := na
    nyRiskAmt  := na
    nyDir      := 0
    nyEntryBar := na
    nyEntryQty := 0
    nyP1SL     := na

// ─── NY Phase 2 (recovery) ────────────────────────────────
// nyRecPhase: 0=inactiv, 1=cauta lumânare 5min, 2=range gata,
//             3=trade P2 activ, 4=sesiune terminata
var int   nyRecPhase   = 0
var float nyRecRH      = na
var float nyRecRL      = na
var bool  nyP2Done     = false
var int   nyP2EntryBar = na

if newDay
    nyRecPhase   := 0
    nyRecRH      := na
    nyRecRL      := na
    nyP2Done     := false
    nyP2EntryBar := na

// ── Stare deschisa per-sesiune ────────────────────────────
var bool nyOpen  = false
var bool lonOpen = false
var bool nyOpen2 = false
var bool lonOpen2 = false
nyOpen   := false
lonOpen  := false
nyOpen2  := false
lonOpen2 := false
for _i = 0 to strategy.opentrades - 1
    _id = strategy.opentrades.entry_id(_i)
    if _id == "NY Long"   or _id == "NY Short"
        nyOpen  := true
    if _id == "NY Long 2" or _id == "NY Short 2"
        nyOpen  := true
        nyOpen2 := true
    if _id == "LON Long"   or _id == "LON Short"
        lonOpen  := true
    if _id == "LON Long 2" or _id == "LON Short 2"
        lonOpen  := true
        lonOpen2 := true

// LON→NY overlap protection
if (nyRetestL or nyRetestS) and not nyOpen and not nyTradeDone and lonOpen
    strategy.close("LON Long",  comment="LON→NY")
    strategy.close("LON Short", comment="LON→NY")
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"cancelall","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}',     alert.freq_once_per_bar_close)

// ─── PHASE 1 ENTRIES ─────────────────────────────────────
if nyRetestL and not nyOpen and not nyTradeDone
    sl       = nySlLong()
    _riskAmt = close - sl
    eqty     = entryQty(_riskAmt)
    if eqty > 0
        tp         = close + _riskAmt * i_tpR
        nyEntryPx  := close
        nyRiskAmt  := _riskAmt
        nyDir      := 1
        nyEntryQty := eqty
        nyP1SL     := sl
        strategy.entry("NY Long",  strategy.long,  qty=eqty, comment="NY RT L")
        strategy.exit("NY XL", "NY Long",  stop=sl, limit=tp)
        if i_pmtEnabled and i_pmtToken != ""
            alert('{"symbol":"' + i_pmtSymbol + '","data":"buy","quantity":' + str.tostring(eqty) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        nyState     := 0
        nyTradeDone := true
        nyEntryBar  := bar_index
        nyWaitLow   := na

if nyRetestS and not nyOpen and not nyTradeDone
    sl       = nySlShort()
    _riskAmt = sl - close
    eqty     = entryQty(_riskAmt)
    if eqty > 0
        tp         = close - _riskAmt * i_tpR
        nyEntryPx  := close
        nyRiskAmt  := _riskAmt
        nyDir      := -1
        nyEntryQty := eqty
        nyP1SL     := sl
        strategy.entry("NY Short", strategy.short, qty=eqty, comment="NY RT S")
        strategy.exit("NY XS", "NY Short", stop=sl, limit=tp)
        if i_pmtEnabled and i_pmtToken != ""
            alert('{"symbol":"' + i_pmtSymbol + '","data":"sell","quantity":' + str.tostring(eqty) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        nyState     := 0
        nyTradeDone := true
        nyEntryBar  := bar_index
        nyWaitHigh  := na

// ─── PHASE 1 RESET + ACTIVARE RECOVERY ──────────────────
if nyTradeDone and not nyOpen and not na(nyEntryPx) and not eod and bar_index > nz(nyEntryBar, -1)
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"cancelall","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}',     alert.freq_once_per_bar_close)
    // Daca phase 1 a luat SL → activam recovery
    if nyRecPhase == 0 and strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        nyRecPhase := 1
    nyEntryPx := na
    nyRiskAmt := na

// ─── PHASE 2: CAUTA LUMÂNARE 5MIN CARE ATINGE SL-UL ─────
// nyRecPhase==1: asteaptam prima lumânare de 5min al carei H/L atinge nivelul SL din phase 1
if nyRecPhase == 1 and new5 and not na(p5H) and not na(nyP1SL) and nyTradeActive and not eod
    touchedSL = (nyDir == 1 and p5L <= nyP1SL) or (nyDir == -1 and p5H >= nyP1SL)
    if touchedSL
        nyRecRH    := p5H
        nyRecRL    := p5L
        nyRecPhase := 2

// ─── PHASE 2: ENTRY CAND LUMÂNARE 5MIN IESE DIN RANGE ───
// nyRecPhase==2: asteaptam o lumânare de 5min care inchide in afara range-ului de recovery
if nyRecPhase == 2 and new5 and not na(p5C) and not na(nyRecRH) and not nyOpen and not nyP2Done and nyTradeActive and not eod
    if p5C > nyRecRH
        sl       = nyRecRL - i_slBuf
        _riskAmt = close - sl
        eqty     = entryQty(_riskAmt)
        if eqty > 0
            tp           = close + _riskAmt * i_tpR
            nyP2EntryBar := bar_index
            nyP2Done     := true
            nyRecPhase   := 3
            strategy.entry("NY Long 2",  strategy.long,  qty=eqty, comment="NY REC L")
            strategy.exit("NY XL2", "NY Long 2",  stop=sl, limit=tp)
            if i_pmtEnabled and i_pmtToken != ""
                alert('{"symbol":"' + i_pmtSymbol + '","data":"buy","quantity":' + str.tostring(eqty) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
    else if p5C < nyRecRL
        sl       = nyRecRH + i_slBuf
        _riskAmt = sl - close
        eqty     = entryQty(_riskAmt)
        if eqty > 0
            tp           = close - _riskAmt * i_tpR
            nyP2EntryBar := bar_index
            nyP2Done     := true
            nyRecPhase   := 3
            strategy.entry("NY Short 2", strategy.short, qty=eqty, comment="NY REC S")
            strategy.exit("NY XS2", "NY Short 2", stop=sl, limit=tp)
            if i_pmtEnabled and i_pmtToken != ""
                alert('{"symbol":"' + i_pmtSymbol + '","data":"sell","quantity":' + str.tostring(eqty) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)

// ─── PHASE 2 RESET ────────────────────────────────────────
if nyP2Done and not nyOpen2 and not eod and bar_index > nz(nyP2EntryBar, -1)
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"cancelall","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}',     alert.freq_once_per_bar_close)
    nyRecPhase := 4   // sesiune terminata

// ═══════════════════════════════════════════════════════════
//  ██  LONDON SESSION – PHASE 1 (identica cu AdiivaBreakout)  ██
// ═══════════════════════════════════════════════════════════
lonRSMins = i_lonRSH * 60 + i_lonRSM
lonREMins = i_lonREH * 60 + i_lonREM
lonEEMins = i_lonEEH * 60 + i_lonEEM

inRangeLon = i_lonEnabled and nyMins >= lonRSMins and nyMins <= lonREMins

var float lonRH     = na
var float lonRL     = na
var bool  lonRReady = false

if newDay
    lonRH     := na
    lonRL     := na
    lonRReady := false

if inRangeLon
    lonRH := na(lonRH) ? high : math.max(lonRH, high)
    lonRL := na(lonRL) ? low  : math.min(lonRL, low)

var bool _lonRED = false
if newDay
    _lonRED := false

lonRangeJustEnd = i_lonEnabled and not _lonRED and not na(lonRH) and not inRangeLon and
                  nyMins > lonREMins and nyMins < eodMins
if lonRangeJustEnd
    _lonRED := true

lonTradeActive  = i_lonEnabled and nyMins > lonREMins and nyMins < eodMins
lonEntryAllowed = lonTradeActive and nyMins < lonEEMins

if lonRangeJustEnd and not na(lonRH)
    lonRReady := true

var array<float> _lonBH = array.new_float(0)
var array<float> _lonBL = array.new_float(0)
var array<float> _lonBV = array.new_float(0)

if newDay
    array.clear(_lonBH)
    array.clear(_lonBL)
    array.clear(_lonBV)

if inRangeLon
    array.push(_lonBH, high)
    array.push(_lonBL, low)
    array.push(_lonBV, volume)

var float lonPoc  = na
var float lonVah  = na
var float lonVal  = na
var bool  lonVpOk = false

if newDay
    lonPoc  := na
    lonVah  := na
    lonVal  := na
    lonVpOk := false

if lonRangeJustEnd and not lonVpOk and not na(lonRH) and lonRH != lonRL
    rowSize  = effTicks * syminfo.mintick
    gridBase = math.floor(lonRL / rowSize) * rowSize
    rows     = math.max(2, int(math.ceil((lonRH - gridBase) / rowSize)))
    volBins  = array.new_float(rows, 0.0)
    n = array.size(_lonBH)
    for i = 0 to n - 1
        bH = math.min(array.get(_lonBH, i), lonRH)
        bL = math.max(array.get(_lonBL, i), lonRL)
        bV = array.get(_lonBV, i)
        if bH <= bL
            continue
        loBin = math.max(0, math.min(rows - 1, int(math.floor((bL - gridBase) / rowSize))))
        hiBin = math.max(0, math.min(rows - 1, int(math.floor((bH - gridBase) / rowSize))))
        nBins = hiBin - loBin + 1
        vpp   = bV / nBins
        for b = loBin to hiBin
            array.set(volBins, b, array.get(volBins, b) + vpp)
    maxVol   = array.max(volBins)
    pocBin   = array.indexof(volBins, maxVol)
    lonPoc  := gridBase + (pocBin + 0.5) * rowSize
    totalVol = array.sum(volBins)
    vaTarget = totalVol * i_vaPercent / 100.0
    vaLo = pocBin
    vaHi = pocBin
    vaVol = maxVol
    for _i = 0 to rows - 1
        if vaVol >= vaTarget or (vaHi >= rows - 1 and vaLo <= 0)
            break
        addUp   = vaHi < rows - 1 ? array.get(volBins, vaHi + 1) : 0.0
        addDown = vaLo > 0         ? array.get(volBins, vaLo - 1) : 0.0
        if addUp >= addDown
            vaHi  += 1
            vaVol += addUp
        else
            vaLo  -= 1
            vaVol += addDown
    lonVah  := gridBase + (vaHi + 1) * rowSize
    lonVal  := gridBase + vaLo * rowSize
    lonVpOk := true

var float lonPrH = na
var float lonPrL = na
if newDay
    lonPrH := na
    lonPrL := na
if lonTradeActive and lonVpOk
    if high > lonVah
        lonPrH := na(lonPrH) ? high : math.max(lonPrH, high)
    if low < lonVal
        lonPrL := na(lonPrL) ? low  : math.min(lonPrL, low)

lonHalfRange  = not na(lonRH) and not na(lonRL) ? (lonRH + lonRL) / 2.0 : na
lonAllInUpper = lonVpOk and not na(lonHalfRange) and lonVal >= lonHalfRange
lonAllInLower = lonVpOk and not na(lonHalfRange) and lonVah <= lonHalfRange
lonIsVolatile = lonAllInUpper or lonAllInLower

var int  lonState     = 0
var bool lonTradeDone = false

if newDay
    lonState     := 0
    lonTradeDone := false

bool lonBrkUp = lonState == 0 and not lonTradeDone and lonEntryAllowed and lonRReady and close > lonRH
bool lonBrkDn = lonState == 0 and not lonTradeDone and lonEntryAllowed and lonRReady and close < lonRL

if lonBrkUp
    lonState := 1
if lonBrkDn
    lonState := 2

bool lonRetestL = lonState == 1 and lonEntryAllowed and close >= lonRL and close <= lonRH
bool lonRetestS = lonState == 2 and lonEntryAllowed and close >= lonRL and close <= lonRH

var float lonWaitLow  = na
var float lonWaitHigh = na
if newDay
    lonWaitLow  := na
    lonWaitHigh := na

if lonVpOk and lonTradeActive and not lonTradeDone and not na(lonVal)
    if low < lonVal and low > lonRL
        lonWaitLow := na(lonWaitLow) ? low : math.min(lonWaitLow, low)

if lonVpOk and lonTradeActive and not lonTradeDone and not na(lonVah)
    if high > lonVah and high < lonRH
        lonWaitHigh := na(lonWaitHigh) ? high : math.max(lonWaitHigh, high)

lonSlLong() =>
    float sl = not na(lonWaitLow) ? lonWaitLow - i_slBuf : not na(lonVal) and lonVpOk ? lonVal - i_slBuf : not na(lonRL) ? lonRL - i_slBuf : close - 10 * syminfo.mintick
    if lonVpOk and not na(lonVal)
        sl := math.min(sl, lonVal - i_slBuf)
    if na(sl) or sl >= close
        sl := not na(lonVal) and not na(lonRL) ? close - (lonVal - lonRL) / 2 : not na(lonRL) ? lonRL - i_slBuf : close - 10 * syminfo.mintick
    if na(sl) or sl >= close
        sl := close - 10 * syminfo.mintick
    sl

lonSlShort() =>
    float sl = not na(lonWaitHigh) ? lonWaitHigh + i_slBuf : not na(lonVah) and lonVpOk ? lonVah + i_slBuf : not na(lonRH) ? lonRH + i_slBuf : close + 10 * syminfo.mintick
    if lonVpOk and not na(lonVah)
        sl := math.max(sl, lonVah + i_slBuf)
    if na(sl) or sl <= close
        sl := not na(lonRH) ? lonRH + i_slBuf : close + 10 * syminfo.mintick
    sl

var float lonEntryPx  = na
var float lonRiskAmt  = na
var int   lonDir      = 0
var int   lonEntryBar = na
var int   lonEntryQty = 0
var float lonP1SL     = na

if newDay
    lonEntryPx  := na
    lonRiskAmt  := na
    lonDir      := 0
    lonEntryBar := na
    lonEntryQty := 0
    lonP1SL     := na

// ─── LON Phase 2 (recovery) ───────────────────────────────
var int   lonRecPhase   = 0
var float lonRecRH      = na
var float lonRecRL      = na
var bool  lonP2Done     = false
var int   lonP2EntryBar = na

if newDay
    lonRecPhase   := 0
    lonRecRH      := na
    lonRecRL      := na
    lonP2Done     := false
    lonP2EntryBar := na

// ─── LONDON PHASE 1 ENTRIES ──────────────────────────────
if lonRetestL and not lonOpen and not lonTradeDone
    sl       = lonSlLong()
    _riskAmt = close - sl
    eqty     = entryQty(_riskAmt)
    if eqty > 0
        tp          = close + _riskAmt * i_tpR
        lonEntryPx  := close
        lonRiskAmt  := _riskAmt
        lonDir      := 1
        lonEntryQty := eqty
        lonP1SL     := sl
        strategy.entry("LON Long",  strategy.long,  qty=eqty, comment="LON RT L")
        strategy.exit("LON XL", "LON Long",  stop=sl, limit=tp)
        if i_pmtEnabled and i_pmtToken != ""
            alert('{"symbol":"' + i_pmtSymbol + '","data":"buy","quantity":' + str.tostring(eqty) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        lonState     := 0
        lonTradeDone := true
        lonEntryBar  := bar_index
        lonWaitLow   := na

if lonRetestS and not lonOpen and not lonTradeDone
    sl       = lonSlShort()
    _riskAmt = sl - close
    eqty     = entryQty(_riskAmt)
    if eqty > 0
        tp          = close - _riskAmt * i_tpR
        lonEntryPx  := close
        lonRiskAmt  := _riskAmt
        lonDir      := -1
        lonEntryQty := eqty
        lonP1SL     := sl
        strategy.entry("LON Short", strategy.short, qty=eqty, comment="LON RT S")
        strategy.exit("LON XS", "LON Short", stop=sl, limit=tp)
        if i_pmtEnabled and i_pmtToken != ""
            alert('{"symbol":"' + i_pmtSymbol + '","data":"sell","quantity":' + str.tostring(eqty) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        lonState     := 0
        lonTradeDone := true
        lonEntryBar  := bar_index
        lonWaitHigh  := na

// ─── LONDON PHASE 1 RESET + ACTIVARE RECOVERY ────────────
if lonTradeDone and not lonOpen and not na(lonEntryPx) and not eod and bar_index > nz(lonEntryBar, -1)
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"cancelall","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}',     alert.freq_once_per_bar_close)
    if lonRecPhase == 0 and strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        lonRecPhase := 1
    lonEntryPx := na
    lonRiskAmt := na

// ─── LONDON PHASE 2: CAUTA LUMÂNARE 5MIN ─────────────────
if lonRecPhase == 1 and new5 and not na(p5H) and not na(lonP1SL) and lonTradeActive and not eod
    touchedSL = (lonDir == 1 and p5L <= lonP1SL) or (lonDir == -1 and p5H >= lonP1SL)
    if touchedSL
        lonRecRH    := p5H
        lonRecRL    := p5L
        lonRecPhase := 2

// ─── LONDON PHASE 2: ENTRY ───────────────────────────────
if lonRecPhase == 2 and new5 and not na(p5C) and not na(lonRecRH) and not lonOpen and not lonP2Done and lonTradeActive and not eod
    if p5C > lonRecRH
        sl       = lonRecRL - i_slBuf
        _riskAmt = close - sl
        eqty     = entryQty(_riskAmt)
        if eqty > 0
            tp            = close + _riskAmt * i_tpR
            lonP2EntryBar := bar_index
            lonP2Done     := true
            lonRecPhase   := 3
            strategy.entry("LON Long 2",  strategy.long,  qty=eqty, comment="LON REC L")
            strategy.exit("LON XL2", "LON Long 2",  stop=sl, limit=tp)
            if i_pmtEnabled and i_pmtToken != ""
                alert('{"symbol":"' + i_pmtSymbol + '","data":"buy","quantity":' + str.tostring(eqty) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
    else if p5C < lonRecRL
        sl       = lonRecRH + i_slBuf
        _riskAmt = sl - close
        eqty     = entryQty(_riskAmt)
        if eqty > 0
            tp            = close - _riskAmt * i_tpR
            lonP2EntryBar := bar_index
            lonP2Done     := true
            lonRecPhase   := 3
            strategy.entry("LON Short 2", strategy.short, qty=eqty, comment="LON REC S")
            strategy.exit("LON XS2", "LON Short 2", stop=sl, limit=tp)
            if i_pmtEnabled and i_pmtToken != ""
                alert('{"symbol":"' + i_pmtSymbol + '","data":"sell","quantity":' + str.tostring(eqty) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)

// ─── LONDON PHASE 2 RESET ─────────────────────────────────
if lonP2Done and not lonOpen2 and not eod and bar_index > nz(lonP2EntryBar, -1)
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"cancelall","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}',     alert.freq_once_per_bar_close)
    lonRecPhase := 4

// ═══════════════════════════════════════════════════════════
//  EOD CLOSE
// ═══════════════════════════════════════════════════════════
if eod and (nyOpen or lonOpen)
    strategy.close_all(comment="EOD")
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"cancelall","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}',     alert.freq_once_per_bar_close)
    nyState    := 0
    lonState   := 0
    nyRecPhase := 0
    lonRecPhase := 0

// ═══════════════════════════════════════════════════════════
//  VISUALS
// ═══════════════════════════════════════════════════════════
bgcolor(inRangeNY  ? color.new(color.blue,   88) : na, title="NY Range Window")
bgcolor(inRangeLon ? color.new(color.purple, 88) : na, title="LON Range Window")

// Trade activ: verde=phase1, teal=phase2
bgcolor((nyOpen and not nyOpen2) or (lonOpen and not lonOpen2) ? color.new(color.green, 88) : na, title="P1 Trade Activ")
bgcolor(nyOpen2 or lonOpen2 ? color.new(color.teal, 85) : na, title="P2 Trade Activ")

// SL bars
nySlBar   = (nyOpen[1]  and not nyOpen  and nyTradeDone  and not nyP2Done)  and strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
lonSlBar  = (lonOpen[1] and not lonOpen and lonTradeDone and not lonP2Done) and strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
nyP2SlBar = nyOpen2[1]  and not nyOpen2  and nyP2Done  and strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
lonP2SlBar= lonOpen2[1] and not lonOpen2 and lonP2Done and strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
bgcolor(nySlBar or lonSlBar or nyP2SlBar or lonP2SlBar ? color.new(color.red, 85) : na, title="SL Hit")

// NY Range + SVP
plot(not na(nyRH) ? nyRH : na, "NY Range H", color.new(color.blue, 0),   2, plot.style_linebr)
plot(not na(nyRL) ? nyRL : na, "NY Range L", color.new(color.blue, 0),   2, plot.style_linebr)
plot(nyVpOk ? nyVah : na,      "NY VAH",     color.new(color.lime,   0), 2, plot.style_linebr)
plot(nyVpOk ? nyPoc : na,      "NY POC",     color.new(color.yellow, 0), 2, plot.style_linebr)
plot(nyVpOk ? nyVal : na,      "NY VAL",     color.new(color.red,    0), 2, plot.style_linebr)

// NY Recovery Range (portocaliu)
plot(nyRecPhase >= 2 and not na(nyRecRH) ? nyRecRH : na, "NY Rec H", color.new(color.orange, 0), 1, plot.style_linebr)
plot(nyRecPhase >= 2 and not na(nyRecRL) ? nyRecRL : na, "NY Rec L", color.new(color.orange, 0), 1, plot.style_linebr)

// LON Range + SVP
plot(not na(lonRH) ? lonRH : na, "LON Range H", color.new(color.purple, 0), 2, plot.style_stepline)
plot(not na(lonRL) ? lonRL : na, "LON Range L", color.new(color.purple, 0), 2, plot.style_stepline)
plot(lonVpOk ? lonVah : na,      "LON VAH",     color.new(color.teal,   0), 2, plot.style_stepline)
plot(lonVpOk ? lonPoc : na,      "LON POC",     color.new(color.silver, 0), 2, plot.style_stepline_diamond)
plot(lonVpOk ? lonVal : na,      "LON VAL",     color.new(color.maroon, 0), 2, plot.style_stepline)

// LON Recovery Range (galben)
plot(lonRecPhase >= 2 and not na(lonRecRH) ? lonRecRH : na, "LON Rec H", color.new(color.yellow, 0), 1, plot.style_stepline)
plot(lonRecPhase >= 2 and not na(lonRecRL) ? lonRecRL : na, "LON Rec L", color.new(color.yellow, 0), 1, plot.style_stepline)

// Shapes – phase 1
plotshape(nyBrkUp,   "NY BRK UP",   shape.triangleup,   location.belowbar, color.new(color.lime,    0), size=size.small)
plotshape(nyBrkDn,   "NY BRK DN",   shape.triangledown, location.abovebar, color.new(color.red,     0), size=size.small)
plotshape(nyRetestL, "NY RT Long",  shape.circle,       location.belowbar, color.new(color.green,   0), size=size.tiny)
plotshape(nyRetestS, "NY RT Short", shape.circle,       location.abovebar, color.new(color.orange,  0), size=size.tiny)
plotshape(lonBrkUp,   "LON BRK UP",   shape.triangleup,   location.belowbar, color.new(color.aqua,    0), size=size.small)
plotshape(lonBrkDn,   "LON BRK DN",   shape.triangledown, location.abovebar, color.new(color.fuchsia, 0), size=size.small)
plotshape(lonRetestL, "LON RT Long",  shape.circle,       location.belowbar, color.new(color.aqua,    0), size=size.tiny)
plotshape(lonRetestS, "LON RT Short", shape.circle,       location.abovebar, color.new(color.fuchsia, 0), size=size.tiny)

// ═══════════════════════════════════════════════════════════
//  INFO TABLE
// ═══════════════════════════════════════════════════════════
var table infoT = table.new(position.top_right, 2, 15,
     bgcolor=color.new(color.black, 70),
     border_color=color.gray, border_width=1,
     frame_color=color.gray, frame_width=1)

if barstate.islast
    tnYear  = year(timenow,       "America/New_York")
    tnMonth = month(timenow,      "America/New_York")
    tnDay   = dayofmonth(timenow, "America/New_York")

    nyRSTs  = timestamp("America/New_York", tnYear, tnMonth, tnDay, effNyRSH, effNyRSM)
    nyRETs  = timestamp("America/New_York", tnYear, tnMonth, tnDay, effNyREH, effNyREM)
    roNyRSH = hour(nyRSTs,   "Europe/Bucharest")
    roNyRSM = minute(nyRSTs, "Europe/Bucharest")
    roNyREH = hour(nyRETs,   "Europe/Bucharest")
    roNyREM = minute(nyRETs, "Europe/Bucharest")

    lonRSTs  = timestamp("America/New_York", tnYear, tnMonth, tnDay, i_lonRSH, i_lonRSM)
    lonRETs  = timestamp("America/New_York", tnYear, tnMonth, tnDay, i_lonREH, i_lonREM)
    roLonRSH = hour(lonRSTs,   "Europe/Bucharest")
    roLonRSM = minute(lonRSTs, "Europe/Bucharest")
    roLonREH = hour(lonRETs,   "Europe/Bucharest")
    roLonREM = minute(lonRETs, "Europe/Bucharest")

    presetLabel  = "Preset: " + (i_preset == "Auto" ? "Auto(" + autoInstr + ")" : i_preset) + "  |  " + str.tostring(effTicks) + " ticks/row"
    nyRangeLabel = str.tostring(effNyRSH,"00") + ":" + str.tostring(effNyRSM,"00") +
                   "-" + str.tostring(effNyREH,"00") + ":" + str.tostring(effNyREM,"00") + " NY" +
                   "  (" + str.tostring(roNyRSH,"00") + ":" + str.tostring(roNyRSM,"00") +
                   "-" + str.tostring(roNyREH,"00") + ":" + str.tostring(roNyREM,"00") + " RO)"

    nyP2Status = nyRecPhase == 0 ? "—" : nyRecPhase == 1 ? "Cauta 5min" : nyRecPhase == 2 ? "Range gata" : nyRecPhase == 3 ? "P2 activ" : "Done"
    lonP2Status = lonRecPhase == 0 ? "—" : lonRecPhase == 1 ? "Cauta 5min" : lonRecPhase == 2 ? "Range gata" : lonRecPhase == 3 ? "P2 activ" : "Done"

    table.cell(infoT, 0, 0, "IvaBreakout",  text_color=color.white,  text_size=size.small, bgcolor=color.new(color.blue, 50))
    table.cell(infoT, 1, 0, presetLabel,    text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.blue, 50))

    nyHeader = i_nyEnabled ? "── NY ──" : "── NY (OFF) ──"
    table.cell(infoT, 0, 1, nyHeader,       text_color=i_nyEnabled ? color.blue : color.gray, text_size=size.small, bgcolor=color.new(color.blue, 85))
    table.cell(infoT, 1, 1, nyRangeLabel,   text_color=color.white,  text_size=size.small, bgcolor=color.new(color.blue, 85))
    table.cell(infoT, 0, 2, "Range H",      text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 2, not na(nyRH)  ? str.tostring(nyRH,  "#.##") : "—", text_color=color.white,  text_size=size.small)
    table.cell(infoT, 0, 3, "Range L",      text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 3, not na(nyRL)  ? str.tostring(nyRL,  "#.##") : "—", text_color=color.white,  text_size=size.small)
    table.cell(infoT, 0, 4, "VAH",          text_color=color.lime,   text_size=size.small)
    table.cell(infoT, 1, 4, not na(nyVah) ? str.tostring(nyVah, "#.##") : "—", text_color=color.lime,   text_size=size.small)
    table.cell(infoT, 0, 5, "POC",          text_color=color.yellow, text_size=size.small)
    table.cell(infoT, 1, 5, not na(nyPoc) ? str.tostring(nyPoc, "#.##") : "—", text_color=color.yellow, text_size=size.small)
    table.cell(infoT, 0, 6, "VAL",          text_color=color.red,    text_size=size.small)
    table.cell(infoT, 1, 6, not na(nyVal) ? str.tostring(nyVal, "#.##") : "—", text_color=color.red,    text_size=size.small)
    table.cell(infoT, 0, 7, "NY Mode",      text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 7, i_nyEnabled ? (nyIsVolatile ? "VOLATILE" : "NORMAL") : "—",
               text_color=i_nyEnabled ? (nyIsVolatile ? color.orange : color.green) : color.gray, text_size=size.small)
    table.cell(infoT, 0, 8, "NY Recovery",  text_color=color.orange, text_size=size.small)
    table.cell(infoT, 1, 8, nyP2Status,     text_color=nyRecPhase >= 2 ? color.orange : color.gray, text_size=size.small)

    lonHeader = i_lonEnabled ? "── LON ──" : "── LON (OFF) ──"
    lonTimeLabel = i_lonEnabled
         ? str.tostring(i_lonRSH,"00") + ":" + str.tostring(i_lonRSM,"00") +
           "-" + str.tostring(i_lonREH,"00") + ":" + str.tostring(i_lonREM,"00") + " NY" +
           "  (" + str.tostring(roLonRSH,"00") + ":" + str.tostring(roLonRSM,"00") +
           "-" + str.tostring(roLonREH,"00") + ":" + str.tostring(roLonREM,"00") + " RO)"
         : "dezactivat"
    table.cell(infoT, 0, 9,  lonHeader,     text_color=color.purple, text_size=size.small, bgcolor=color.new(color.purple, 88))
    table.cell(infoT, 1, 9,  lonTimeLabel,  text_color=i_lonEnabled ? color.white : color.gray, text_size=size.small, bgcolor=color.new(color.purple, 88))
    table.cell(infoT, 0, 10, "VAH",         text_color=color.teal,   text_size=size.small)
    table.cell(infoT, 1, 10, not na(lonVah) ? str.tostring(lonVah, "#.##") : "—", text_color=color.teal,   text_size=size.small)
    table.cell(infoT, 0, 11, "POC",         text_color=color.silver, text_size=size.small)
    table.cell(infoT, 1, 11, not na(lonPoc) ? str.tostring(lonPoc, "#.##") : "—", text_color=color.silver, text_size=size.small)
    table.cell(infoT, 0, 12, "VAL",         text_color=color.maroon, text_size=size.small)
    table.cell(infoT, 1, 12, not na(lonVal) ? str.tostring(lonVal, "#.##") : "—", text_color=color.maroon, text_size=size.small)
    table.cell(infoT, 0, 13, "LON Mode",    text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 13, i_lonEnabled ? (lonIsVolatile ? "VOLATILE" : "NORMAL") : "—",
               text_color=i_lonEnabled ? (lonIsVolatile ? color.orange : color.green) : color.gray, text_size=size.small)
    table.cell(infoT, 0, 14, "LON Recovery", text_color=color.yellow, text_size=size.small)
    table.cell(infoT, 1, 14, lonP2Status,    text_color=lonRecPhase >= 2 ? color.yellow : color.gray, text_size=size.small)

// ═══════════════════════════════════════════════════════════
//  ALERTS
// ═══════════════════════════════════════════════════════════
alertcondition(nyRetestL,  "NY LONG Entry P1",  "IvaBreakout NY ↑ Long retest @ {{close}}")
alertcondition(nyRetestS,  "NY SHORT Entry P1", "IvaBreakout NY ↓ Short retest @ {{close}}")
alertcondition(nyBrkUp,    "NY Breakout UP",    "IvaBreakout NY: Range spart sus")
alertcondition(nyBrkDn,    "NY Breakout DOWN",  "IvaBreakout NY: Range spart jos")
alertcondition(lonRetestL, "LON LONG Entry P1", "IvaBreakout LON ↑ Long retest @ {{close}}")
alertcondition(lonRetestS, "LON SHORT Entry P1","IvaBreakout LON ↓ Short retest @ {{close}}")
alertcondition(lonBrkUp,   "LON Breakout UP",   "IvaBreakout LON: Range spart sus")
alertcondition(lonBrkDn,   "LON Breakout DOWN", "IvaBreakout LON: Range spart jos")
