//@version=5
strategy("DAX Range 915", overlay=true,
         default_qty_type=strategy.fixed, default_qty_value=1,
         max_bars_back=500, calc_on_every_tick=false,
         process_orders_on_close=true, max_labels_count=500,
         pyramiding=1,
         commission_type=strategy.commission.cash_per_order, commission_value=0)

// ═══════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════
i_offset     = input.float(5.0,     "Offset stop (puncte)",      minval=0.5, step=0.5,  group="Strategie")
i_tpR        = input.float(3.0,     "TP Ratio T1 (R)",            minval=0.5, step=0.5,  group="Strategie")
i_qty        = input.int  (1,       "Contracte",                   minval=1,              group="Strategie")
i_eodH       = input.int  (22,      "EOD ora (RO)",                minval=9, maxval=23,   group="Strategie")
i_eodMin     = input.int  (0,       "EOD minut (RO)",              minval=0, maxval=59,   group="Strategie")

i_pmtEnabled = input.bool(false,    "Activeaza PMT Alerts",       group="Pick My Trade")
i_pmtToken   = input.string("",     "PMT Token",                   group="Pick My Trade")
i_pmtSymbol  = input.string("DE40!", "Simbol Tradovate",          group="Pick My Trade")

// ═══════════════════════════════════════════════════════════
//  TIMEFRAME GUARD
// ═══════════════════════════════════════════════════════════
if timeframe.period != "15"
    runtime.error("⚠️ Acest script functioneaza DOAR pe graficul de 15 MINUTE!")

// ═══════════════════════════════════════════════════════════
//  TIME – ora Romania
// ═══════════════════════════════════════════════════════════
RO      = "Europe/Bucharest"
roH     = hour(time, RO)
roM     = minute(time, RO)
roMins  = roH * 60 + roM

newDay  = nz(ta.change(dayofmonth(time, RO))) != 0
eodMins = i_eodH * 60 + i_eodMin
eod     = roMins >= eodMins

// ═══════════════════════════════════════════════════════════
//  SESSION STATE
// ═══════════════════════════════════════════════════════════
// phase: 0=astept range, 1=T1 pending, 2=T1 activ,
//        3=T1 SL→T2,    4=T2 activ,   5=T2 SL→T3,
//        6=T3 activ,    9=done

var int   phase      = 0
var float rngH       = na
var float rngL       = na
var int   dir        = 0      // 1=long, -1=short
var int   entryBar   = na
var float curEntryPx = na
var float curSL      = na
var float curTP      = na

// T1 stop levels
var float t1BuyStop  = na
var float t1SellStop = na
var float t1LSL      = na
var float t1LTP      = na
var float t1SSL      = na
var float t1STP      = na

if newDay
    phase       := 0
    rngH        := na
    rngL        := na
    dir         := 0
    entryBar    := na
    curEntryPx  := na
    curSL       := na
    curTP       := na
    t1BuyStop   := na
    t1SellStop  := na
    t1LSL       := na
    t1LTP       := na
    t1SSL       := na
    t1STP       := na
    strategy.cancel_all()

// ═══════════════════════════════════════════════════════════
//  OPEN TRADE DETECTOR
// ═══════════════════════════════════════════════════════════
var bool tradeOpen = false
tradeOpen := false
for _i = 0 to strategy.opentrades - 1
    _id = strategy.opentrades.entry_id(_i)
    if str.startswith(_id, "T1") or str.startswith(_id, "T2") or str.startswith(_id, "T3")
        tradeOpen := true

// ═══════════════════════════════════════════════════════════
//  RANGE CAPTURE + T1 PENDING ORDERS  (bara 9:15 RO)
// ═══════════════════════════════════════════════════════════
// Plasam ordinele la INCHIDEREA barei de 9:15 (= 9:30 deschidere)
// → ordinele sunt active de la prima bara de 9:30
rangeActive = roH == 9 and roM == 15

if rangeActive and na(rngH) and phase == 0 and not eod
    rngH        := high
    rngL        := low
    t1BuyStop   := rngH + i_offset
    t1SellStop  := rngL - i_offset
    _t1Risk      = t1BuyStop - t1SellStop
    t1LSL       := t1SellStop
    t1LTP       := t1BuyStop + _t1Risk * i_tpR
    t1SSL       := t1BuyStop
    t1STP       := t1SellStop - _t1Risk * i_tpR
    strategy.entry("T1 Long",  strategy.long,  qty=i_qty, stop=t1BuyStop,  comment="DAX T1 L")
    strategy.entry("T1 Short", strategy.short, qty=i_qty, stop=t1SellStop, comment="DAX T1 S")
    strategy.exit("T1L X", "T1 Long",  stop=t1LSL, limit=t1LTP)
    strategy.exit("T1S X", "T1 Short", stop=t1SSL, limit=t1STP)
    phase := 1

// ═══════════════════════════════════════════════════════════
//  PHASE 1: detecteaza umplere T1
// ═══════════════════════════════════════════════════════════
if phase == 1 and tradeOpen
    for _i = 0 to strategy.opentrades - 1
        _id = strategy.opentrades.entry_id(_i)
        if _id == "T1 Long"
            dir        := 1
            curEntryPx := strategy.opentrades.entry_price(_i)
            curSL      := t1LSL
            curTP      := t1LTP
            entryBar   := bar_index
            phase      := 2
            strategy.cancel("T1 Short")
        if _id == "T1 Short"
            dir        := -1
            curEntryPx := strategy.opentrades.entry_price(_i)
            curSL      := t1SSL
            curTP      := t1STP
            entryBar   := bar_index
            phase      := 2
            strategy.cancel("T1 Long")

// ═══════════════════════════════════════════════════════════
//  PHASE 2: T1 activ → detecteaza inchidere
// ═══════════════════════════════════════════════════════════
if phase == 2 and not tradeOpen and not na(curEntryPx) and bar_index > nz(entryBar, -1)
    wasLoss = strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
    curEntryPx := na
    phase      := wasLoss ? 3 : 9

// ═══════════════════════════════════════════════════════════
//  PHASE 3: T1 SL hit → plaseaza T2 in DIRECTIE OPUSA T1
// ═══════════════════════════════════════════════════════════
if phase == 3 and not tradeOpen and not eod
    if dir == 1  // T1 Long → T2 Short (oglinda: SL = t1SSL, TP = t1STP)
        strategy.entry("T2 Short", strategy.short, qty=i_qty, comment="DAX T2 S")
        strategy.exit("T2S X", "T2 Short", stop=t1SSL, limit=t1STP)
        if i_pmtEnabled and i_pmtToken != ""
            alert('{"symbol":"' + i_pmtSymbol + '","data":"sell","quantity":' + str.tostring(i_qty) + ',"sl":' + str.tostring(t1SSL) + ',"tp":' + str.tostring(t1STP) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        curSL := t1SSL
        curTP := t1STP
    else if dir == -1  // T1 Short → T2 Long (oglinda: SL = t1LSL, TP = t1LTP)
        strategy.entry("T2 Long", strategy.long,  qty=i_qty, comment="DAX T2 L")
        strategy.exit("T2L X", "T2 Long",  stop=t1LSL, limit=t1LTP)
        if i_pmtEnabled and i_pmtToken != ""
            alert('{"symbol":"' + i_pmtSymbol + '","data":"buy","quantity":' + str.tostring(i_qty) + ',"sl":' + str.tostring(t1LSL) + ',"tp":' + str.tostring(t1LTP) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        curSL := t1LSL
        curTP := t1LTP
    curEntryPx := close
    entryBar   := bar_index
    phase      := 4

// ═══════════════════════════════════════════════════════════
//  PHASE 4: T2 activ → detecteaza inchidere
// ═══════════════════════════════════════════════════════════
if phase == 4 and not tradeOpen and not na(curEntryPx) and bar_index > nz(entryBar, -1)
    wasLoss = strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
    curEntryPx := na
    phase      := wasLoss ? 5 : 9

// ═══════════════════════════════════════════════════════════
//  PHASE 5: T2 SL hit → plaseaza T3 in DIRECTIE OPUSA T2 (= ca T1)
// ═══════════════════════════════════════════════════════════
if phase == 5 and not tradeOpen and not eod
    if dir == 1  // T1 Long, T2 Short → T3 Long (= exact ca T1 Long)
        strategy.entry("T3 Long", strategy.long,  qty=i_qty, comment="DAX T3 L")
        strategy.exit("T3L X", "T3 Long",  stop=t1LSL, limit=t1LTP)
        if i_pmtEnabled and i_pmtToken != ""
            alert('{"symbol":"' + i_pmtSymbol + '","data":"buy","quantity":' + str.tostring(i_qty) + ',"sl":' + str.tostring(t1LSL) + ',"tp":' + str.tostring(t1LTP) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        curSL := t1LSL
        curTP := t1LTP
    else if dir == -1  // T1 Short, T2 Long → T3 Short (= exact ca T1 Short)
        strategy.entry("T3 Short", strategy.short, qty=i_qty, comment="DAX T3 S")
        strategy.exit("T3S X", "T3 Short", stop=t1SSL, limit=t1STP)
        if i_pmtEnabled and i_pmtToken != ""
            alert('{"symbol":"' + i_pmtSymbol + '","data":"sell","quantity":' + str.tostring(i_qty) + ',"sl":' + str.tostring(t1SSL) + ',"tp":' + str.tostring(t1STP) + ',"token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        curSL := t1SSL
        curTP := t1STP
    curEntryPx := close
    entryBar   := bar_index
    phase      := 6

// ═══════════════════════════════════════════════════════════
//  PHASE 6: T3 activ → sesiune done dupa inchidere
// ═══════════════════════════════════════════════════════════
if phase == 6 and not tradeOpen and not na(curEntryPx) and bar_index > nz(entryBar, -1)
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
    curEntryPx := na
    phase      := 9

// ═══════════════════════════════════════════════════════════
//  EOD CLOSE
// ═══════════════════════════════════════════════════════════
if eod and (tradeOpen or phase == 1)
    strategy.close_all(comment="EOD")
    strategy.cancel_all()
    if i_pmtEnabled and i_pmtToken != ""
        alert('{"symbol":"' + i_pmtSymbol + '","data":"cancelall","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
        alert('{"symbol":"' + i_pmtSymbol + '","data":"close","token":"' + i_pmtToken + '"}', alert.freq_once_per_bar_close)
    phase := 9

// ═══════════════════════════════════════════════════════════
//  VISUALS
// ═══════════════════════════════════════════════════════════
bgcolor(rangeActive                    ? color.new(color.blue,  88) : na, title="Range Candle 9:15 RO")
bgcolor(tradeOpen                      ? color.new(color.green, 88) : na, title="Trade Activ")

slHitBar = tradeOpen[1] and not tradeOpen and strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
bgcolor(slHitBar                       ? color.new(color.red,   85) : na, title="SL Hit")

// Range lines
plot(phase >= 1 and phase < 9 and not na(rngH) ? rngH : na, "Range H", color.new(color.blue, 0), 2, plot.style_linebr)
plot(phase >= 1 and phase < 9 and not na(rngL) ? rngL : na, "Range L", color.new(color.blue, 0), 2, plot.style_linebr)

// T1 pending entry levels
plot(phase == 1 and not na(t1BuyStop)  ? t1BuyStop  : na, "T1 Buy Stop",  color.new(color.lime, 0), 1, plot.style_linebr)
plot(phase == 1 and not na(t1SellStop) ? t1SellStop : na, "T1 Sell Stop", color.new(color.red,  0), 1, plot.style_linebr)

// Active SL / TP
plot(phase >= 2 and phase <= 6 and not na(curSL) ? curSL : na, "SL Activ", color.new(color.red,  0), 1, plot.style_linebr)
plot(phase >= 2 and phase <= 6 and not na(curTP) ? curTP : na, "TP Activ", color.new(color.lime, 0), 1, plot.style_linebr)

// ═══════════════════════════════════════════════════════════
//  INFO TABLE
// ═══════════════════════════════════════════════════════════
var table infoT = table.new(position.top_right, 2, 7,
     bgcolor=color.new(color.black, 70),
     border_color=color.gray, border_width=1,
     frame_color=color.gray, frame_width=1)

if barstate.islast
    table.cell(infoT, 0, 0, "DAX Range 915",  text_color=color.white,  text_size=size.small, bgcolor=color.new(color.blue, 50))
    table.cell(infoT, 1, 0, "15 min · RO",    text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.blue, 50))
    table.cell(infoT, 0, 1, "Range H",         text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 1, not na(rngH) ? str.tostring(rngH, "#.#") : "—", text_color=color.white, text_size=size.small)
    table.cell(infoT, 0, 2, "Range L",         text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 2, not na(rngL) ? str.tostring(rngL, "#.#") : "—", text_color=color.white, text_size=size.small)
    _pl = phase == 0 ? "astept range" : phase == 1 ? "T1 pending" : phase == 2 ? "T1 activ" : phase == 3 ? "T1 SL → T2" : phase == 4 ? "T2 activ" : phase == 5 ? "T2 SL → T3" : phase == 6 ? "T3 activ" : "done"
    table.cell(infoT, 0, 3, "Faza",            text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 3, _pl,               text_color=color.white,  text_size=size.small)
    _dl = dir == 1 ? "Long ↑" : dir == -1 ? "Short ↓" : "—"
    table.cell(infoT, 0, 4, "Directie",        text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 4, _dl,               text_color=dir == 1 ? color.lime : dir == -1 ? color.red : color.gray, text_size=size.small)
    table.cell(infoT, 0, 5, "Offset / RR",    text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 5, str.tostring(i_offset, "#.#") + " pts  |  1:" + str.tostring(i_tpR, "#.#"), text_color=color.yellow, text_size=size.small)
    table.cell(infoT, 0, 6, "Qty",             text_color=color.gray,   text_size=size.small)
    table.cell(infoT, 1, 6, str.tostring(i_qty) + " contract(e)",       text_color=color.white, text_size=size.small)

// ═══════════════════════════════════════════════════════════
//  ALERTS
// ═══════════════════════════════════════════════════════════
alertcondition(phase[1] == 1 and phase == 2 and dir ==  1, "T1 Long Entry",  "DAX 915 ↑ T1 Long @ {{close}}")
alertcondition(phase[1] == 1 and phase == 2 and dir == -1, "T1 Short Entry", "DAX 915 ↓ T1 Short @ {{close}}")
alertcondition(phase[1] == 3 and phase == 4,               "T2 Entry",       "DAX 915 T2 Entry @ {{close}}")
alertcondition(phase[1] == 5 and phase == 6,               "T3 Entry",       "DAX 915 T3 Entry @ {{close}}")
