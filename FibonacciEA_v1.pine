// ============================================================
//  FibonacciEA v1  –  TradingView Pine Script v5
//  Strategie Fibonacci Retracement
//
//  Logica:
//    • Directie  : EMA 200 pe 4H
//    • Confirmare: EMA 50  pe 1H   (ambele trebuie sa confirme)
//    • Setup     : swing M1 de 1-3%, detectat prin pivot high/low
//    • Entry 1   : zona 0.750-0.786  |  SL dincolo de 0.886
//    • Entry 2   : nivel 0.886       |  SL dincolo de 1.0
//    • TP        : RR 1:2 (configurabil)
//    • Sesiune   : 11:00-16:00 UTC (13:00-18:00 ora Romaniei EET)  |  Max 2 trades/zi
//
//  Ruleaza pe timeframe M1 (sau orice TF sub 1H).
// ============================================================
//@version=5
strategy(
  title             = "FibonacciEA v1 – Retracement 0.786/0.886",
  overlay           = true,
  initial_capital   = 10000,
  default_qty_type  = strategy.cash,
  default_qty_value = 1000,
  commission_type   = strategy.commission.percent,
  commission_value  = 0.01,
  max_bars_back     = 1000)

// ============================================================
// 1. INPUTS
// ============================================================
var string G_RISK = "Risk Management"
var string G_FIB  = "Fibonacci Nivele"
var string G_SWG  = "Swing Detectie (M1)"
var string G_TRD  = "Trend Filter"
var string G_SES  = "Sesiune"

rr_ratio    = input.float(2.0,  "RR Ratio",                      group=G_RISK, minval=0.5,  step=0.5)

fib_e1_bot  = input.float(0.750,"Entry 1 – nivel inferior (%)",  group=G_FIB,  step=0.001)
fib_e1_top  = input.float(0.786,"Entry 1 – nivel superior (%)",  group=G_FIB,  step=0.001)
fib_e2      = input.float(0.886,"Entry 2 – nivel (%)",           group=G_FIB,  step=0.001)
sl_buf_tck  = input.int(20,     "Buffer SL (ticks dincolo)",     group=G_FIB,  minval=1)

piv_bars    = input.int(5,      "Pivot Bars (confirmare)",       group=G_SWG,  minval=2, maxval=20)
min_sw_pct  = input.float(1.0,  "Range minim swing (%)",         group=G_SWG,  minval=0.1, step=0.1)
max_sw_pct  = input.float(3.0,  "Range maxim swing (%)",         group=G_SWG,  minval=0.5, step=0.1)

ema_4h_len  = input.int(200,    "EMA 4H Period",                 group=G_TRD,  minval=10)
ema_1h_len  = input.int(50,     "EMA 1H Period",                 group=G_TRD,  minval=5)

sess_start  = input.int(11,     "Ora start sesiune UTC (13:00 RO)",  group=G_SES,  minval=0,  maxval=23)
sess_end    = input.int(16,     "Ora sfarsit sesiune UTC (18:00 RO)", group=G_SES,  minval=1,  maxval=24)
max_daily   = input.int(2,      "Max tranzactii/zi",             group=G_SES,  minval=1)

// ============================================================
// 2. HELPER: pret la nivel fibonacci
//   dir= 1 (BUY):  fib_price = hi - level*(hi-lo)   [0=hi, 1=lo]
//   dir=-1 (SELL): fib_price = lo + level*(hi-lo)   [0=lo, 1=hi]
// ============================================================
f_lvl(dir, hi, lo, lvl) => dir == 1 ? hi - lvl*(hi-lo) : lo + lvl*(hi-lo)

// ============================================================
// 3. TREND DIRECTION – EMA 200 (4H) + EMA 50 (1H)
//    1=uptrend, -1=downtrend, 0=conflict (nu tranzactionam)
// ============================================================
[ema4h, c4h] = request.security(syminfo.tickerid, "240",
               [ta.ema(close, ema_4h_len), close],
               lookahead = barmerge.lookahead_off)

[ema1h, c1h] = request.security(syminfo.tickerid, "60",
               [ta.ema(close, ema_1h_len), close],
               lookahead = barmerge.lookahead_off)

_up   = c4h > ema4h and c1h > ema1h
_down = c4h < ema4h and c1h < ema1h
trend_dir = _up ? 1 : _down ? -1 : 0

// ============================================================
// 4. SESSION FILTER
// ============================================================
in_sess = hour >= sess_start and hour < sess_end

// ============================================================
// 5. DAILY RESET
// ============================================================
var int  day_trades = 0
var int  last_date  = 0

cur_date  = year * 10000 + month * 100 + dayofmonth
is_new_day = cur_date != last_date
if is_new_day
    day_trades := 0
    last_date  := cur_date

// ============================================================
// 6. PIVOT HIGH / LOW STORAGE (array)
//    Stocam ultimele MAX_P pivoti detectati pe bara curenta.
//    ph_raw / pl_raw sunt disponibile cu intarziere de piv_bars bare.
// ============================================================
MAX_P   = 30
ph_raw  = ta.pivothigh(high, piv_bars, piv_bars)
pl_raw  = ta.pivotlow (low,  piv_bars, piv_bars)

var float[] a_ph_p = array.new_float(0)   // preturi pivot high
var int[]   a_ph_b = array.new_int(0)     // bar_index pivot high
var float[] a_pl_p = array.new_float(0)   // preturi pivot low
var int[]   a_pl_b = array.new_int(0)     // bar_index pivot low

if not na(ph_raw)
    array.unshift(a_ph_p, ph_raw)
    array.unshift(a_ph_b, bar_index - piv_bars)
    if array.size(a_ph_p) > MAX_P
        array.pop(a_ph_p)
        array.pop(a_ph_b)

if not na(pl_raw)
    array.unshift(a_pl_p, pl_raw)
    array.unshift(a_pl_b, bar_index - piv_bars)
    if array.size(a_pl_p) > MAX_P
        array.pop(a_pl_p)
        array.pop(a_pl_b)

// ============================================================
// 7. SWING FINDER
//
//  BUY  (dir=1):
//    Cel mai recent pivot HIGH + pivot LOW PRECEDENT (mai vechi).
//    Range (hi-lo)/lo intre min_sw_pct si max_sw_pct.
//    Pret curent sub HIGH (in retracement activ).
//
//  SELL (dir=-1):
//    Cel mai recent pivot LOW + pivot HIGH PRECEDENT (mai vechi).
//    Pret curent peste LOW (in bounce activ).
//
//  Returneaza [found_hi, found_lo] sau [na, na].
// ============================================================
find_swing(dir) =>
    r_hi  = float(na)
    r_lo  = float(na)
    min_r = min_sw_pct / 100.0
    max_r = max_sw_pct / 100.0
    n_ph  = array.size(a_ph_p)
    n_pl  = array.size(a_pl_p)

    if dir == 1 and n_ph > 0 and n_pl > 0
        // Iteram prin pivot HIGH-uri de la cel mai recent
        done = false
        for i = 0 to n_ph - 1
            if done
                break
            sh  = array.get(a_ph_p, i)
            shb = array.get(a_ph_b, i)
            // Cautam pivot LOW precedent (bar_index mai mic = mai vechi)
            for j = 0 to n_pl - 1
                sl  = array.get(a_pl_p, j)
                slb = array.get(a_pl_b, j)
                if slb < shb and sh > sl
                    r = (sh - sl) / sl
                    if r >= min_r and r <= max_r and close < sh
                        r_hi := sh
                        r_lo := sl
                        done := true
                        break
                    if r > max_r
                        // Swing prea mare – trecem la urmatorul pivot HIGH
                        break
                    // r < min_r → continuam cu un LOW mai vechi (range mai mare)

    else if dir == -1 and n_ph > 0 and n_pl > 0
        // Iteram prin pivot LOW-uri de la cel mai recent
        done = false
        for i = 0 to n_pl - 1
            if done
                break
            sl  = array.get(a_pl_p, i)
            slb = array.get(a_pl_b, i)
            // Cautam pivot HIGH precedent
            for j = 0 to n_ph - 1
                sh  = array.get(a_ph_p, j)
                shb = array.get(a_ph_b, j)
                if shb < slb and sh > sl
                    r = (sh - sl) / sl
                    if r >= min_r and r <= max_r and close > sl
                        r_hi := sh
                        r_lo := sl
                        done := true
                        break
                    if r > max_r
                        break

    [r_hi, r_lo]

[sw_hi, sw_lo] = find_swing(trend_dir)

// ============================================================
// 8. FIB STATE MANAGEMENT
//    Actualizeaza g_hi/g_lo cand swing-ul se schimba.
//    Reseteaza state la zi noua sau la invalidare (pret trece de 1.0).
// ============================================================
var float g_hi    = na
var float g_lo    = na
var int   g_dir   = 0
var bool  e1_done = false
var bool  e2_done = false

if is_new_day
    g_hi    := na
    g_lo    := na
    g_dir   := 0
    e1_done := false
    e2_done := false

setup_changed = false
buf_p = sl_buf_tck * syminfo.mintick

if not na(sw_hi) and not na(sw_lo)
    changed = na(g_hi) or g_dir != trend_dir or math.abs(sw_hi - g_hi) > syminfo.mintick or math.abs(sw_lo - g_lo) > syminfo.mintick
    if changed
        g_hi          := sw_hi
        g_lo          := sw_lo
        g_dir         := trend_dir
        e1_done       := false
        e2_done       := false
        setup_changed := true
else if not na(g_hi)
    // Invalideaza daca pretul a trecut dincolo de nivelul 1.0
    if g_dir == 1 and low < g_lo - buf_p
        g_hi := na
        g_lo := na
    else if g_dir == -1 and high > g_hi + buf_p
        g_hi := na
        g_lo := na

// ============================================================
// 9. ENTRY LOGIC
//
//  BUY  (g_dir=1):
//    Nivele fib (masurat de la HIGH in jos):
//      f_750 = hi - 0.750*(hi-lo)   [mai sus pe chart]
//      f_786 = hi - 0.786*(hi-lo)   [mai jos ca f_750]
//      f_886 = hi - 0.886*(hi-lo)   [SL entry1, nivel entry2]
//      f_100 = lo                   [SL entry2]
//    Entry 1: f_786 <= close <= f_750  →  SL=f_886-buf  TP=+RR*risk
//    Entry 2: close <= f_886           →  SL=f_100-buf  TP=+RR*risk
//
//  SELL (g_dir=-1):
//    Nivele fib (masurat de la LOW in sus):
//      f_750 = lo + 0.750*(hi-lo)   [mai jos pe chart]
//      f_786 = lo + 0.786*(hi-lo)   [mai sus ca f_750]
//      f_886 = lo + 0.886*(hi-lo)
//      f_100 = hi
//    Entry 1: f_750 <= close <= f_786  →  SL=f_886+buf  TP=-RR*risk
//    Entry 2: close >= f_886           →  SL=f_100+buf  TP=-RR*risk
// ============================================================
can_trade = not na(g_hi) and in_sess and trend_dir != 0 and day_trades < max_daily

if can_trade
    f_750 = f_lvl(g_dir, g_hi, g_lo, fib_e1_bot)   // 0.750
    f_786 = f_lvl(g_dir, g_hi, g_lo, fib_e1_top)   // 0.786
    f_886 = f_lvl(g_dir, g_hi, g_lo, fib_e2)       // 0.886
    f_100 = f_lvl(g_dir, g_hi, g_lo, 1.000)        // 1.000

    // ── ENTRY 1: zona 0.750-0.786 ──────────────────────────────
    if not e1_done
        if g_dir == 1
            // BUY: f_786 (mai jos) <= close <= f_750 (mai sus)
            if close <= f_750 and close >= f_786
                sl_1  = f_886 - buf_p
                risk1 = math.abs(close - sl_1)
                tp_1  = close + risk1 * rr_ratio
                strategy.entry("E1L", strategy.long,  comment="E1 BUY  0.786")
                strategy.exit ("E1Lx", "E1L", stop=sl_1, limit=tp_1)
                e1_done    := true
                day_trades := day_trades + 1
        else
            // SELL: f_750 (mai jos) <= close <= f_786 (mai sus)
            if close >= f_750 and close <= f_786
                sl_1  = f_886 + buf_p
                risk1 = math.abs(sl_1 - close)
                tp_1  = close - risk1 * rr_ratio
                strategy.entry("E1S", strategy.short, comment="E1 SELL 0.786")
                strategy.exit ("E1Sx", "E1S", stop=sl_1, limit=tp_1)
                e1_done    := true
                day_trades := day_trades + 1

    // ── ENTRY 2: nivel 0.886 ───────────────────────────────────
    if not e2_done and day_trades < max_daily
        if g_dir == 1
            if close <= f_886
                sl_2  = f_100 - buf_p
                risk2 = math.abs(close - sl_2)
                tp_2  = close + risk2 * rr_ratio
                strategy.entry("E2L", strategy.long,  comment="E2 BUY  0.886")
                strategy.exit ("E2Lx", "E2L", stop=sl_2, limit=tp_2)
                e2_done    := true
                day_trades := day_trades + 1
        else
            if close >= f_886
                sl_2  = f_100 + buf_p
                risk2 = math.abs(sl_2 - close)
                tp_2  = close - risk2 * rr_ratio
                strategy.entry("E2S", strategy.short, comment="E2 SELL 0.886")
                strategy.exit ("E2Sx", "E2S", stop=sl_2, limit=tp_2)
                e2_done    := true
                day_trades := day_trades + 1

// ============================================================
// 10. VIZUALIZARE
// ============================================================

// ── Fundal sesiune ──────────────────────────────────────────
bgcolor(in_sess ? color.new(color.blue, 95) : na, title="Sesiune activa")

// ── EMA-uri pe chart ───────────────────────────────────────
plot(ema4h, "EMA 200 (4H)", color=color.new(color.blue,   40), linewidth=2)
plot(ema1h, "EMA 50  (1H)", color=color.new(color.teal,   40), linewidth=1)

// ── Swing extreme (Hi/Lo) ──────────────────────────────────
var line ln_shi = line.new(na, na, na, na, extend=extend.none, color=color.new(color.gray, 60), style=line.style_solid,  width=1)
var line ln_slo = line.new(na, na, na, na, extend=extend.none, color=color.new(color.gray, 60), style=line.style_solid,  width=1)

// ── Nivele fibonacci ──────────────────────────────────────
var line ln_750 = line.new(na, na, na, na, extend=extend.right, color=color.new(color.orange, 30), style=line.style_dashed, width=1)
var line ln_786 = line.new(na, na, na, na, extend=extend.right, color=color.orange,               style=line.style_dashed, width=2)
var line ln_886 = line.new(na, na, na, na, extend=extend.right, color=color.new(color.red,    20), style=line.style_dashed, width=2)
var line ln_100 = line.new(na, na, na, na, extend=extend.right, color=color.new(color.gray,   40), style=line.style_dotted, width=1)

// ── Zona Entry 1 (0.750-0.786) ca box ──────────────────────
var box bx_zone = box.new(na, na, na, na,
                          bgcolor      = color.new(color.orange, 85),
                          border_color = color.new(color.orange, 50),
                          border_width = 1)

// ── Etichete nivele ────────────────────────────────────────
var label lbl_750 = label.new(na, na, "", color=color.new(color.orange, 80), textcolor=color.orange, style=label.style_label_left, size=size.tiny)
var label lbl_786 = label.new(na, na, "", color=color.new(color.orange, 80), textcolor=color.orange, style=label.style_label_left, size=size.tiny)
var label lbl_886 = label.new(na, na, "", color=color.new(color.red,    80), textcolor=color.red,    style=label.style_label_left, size=size.tiny)

// Actualizeaza liniile si box-ul cand exista un setup valid
if not na(g_hi) and not na(g_lo)
    f_750v = f_lvl(g_dir, g_hi, g_lo, fib_e1_bot)
    f_786v = f_lvl(g_dir, g_hi, g_lo, fib_e1_top)
    f_886v = f_lvl(g_dir, g_hi, g_lo, fib_e2)
    f_100v = f_lvl(g_dir, g_hi, g_lo, 1.000)
    look   = 50

    // Swing extreme
    line.set_xy1(ln_shi, bar_index - look, g_hi)
    line.set_xy2(ln_shi, bar_index,        g_hi)
    line.set_xy1(ln_slo, bar_index - look, g_lo)
    line.set_xy2(ln_slo, bar_index,        g_lo)

    // Fibonacci
    line.set_xy1(ln_750, bar_index - look, f_750v)
    line.set_xy2(ln_750, bar_index,        f_750v)
    line.set_xy1(ln_786, bar_index - look, f_786v)
    line.set_xy2(ln_786, bar_index,        f_786v)
    line.set_xy1(ln_886, bar_index - look, f_886v)
    line.set_xy2(ln_886, bar_index,        f_886v)
    line.set_xy1(ln_100, bar_index - look, f_100v)
    line.set_xy2(ln_100, bar_index,        f_100v)

    // Entry zone box
    z_top = math.max(f_750v, f_786v)
    z_bot = math.min(f_750v, f_786v)
    box.set_lefttop    (bx_zone, bar_index - look, z_top)
    box.set_rightbottom(bx_zone, bar_index + 30,   z_bot)

    // Etichete
    label.set_xy  (lbl_750, bar_index + 1, f_750v)
    label.set_text(lbl_750, "0.750")
    label.set_xy  (lbl_786, bar_index + 1, f_786v)
    label.set_text(lbl_786, "0.786")
    label.set_xy  (lbl_886, bar_index + 1, f_886v)
    label.set_text(lbl_886, "0.886")

// ── Status table ─────────────────────────────────────────
var table tbl = table.new(position.top_right, 1, 4,
                           bgcolor      = color.new(color.black, 75),
                           border_color = color.new(color.gray, 60),
                           border_width = 1)

trend_clr  = trend_dir ==  1 ? color.lime : trend_dir == -1 ? color.red : color.gray
trend_txt  = trend_dir ==  1 ? "▲ UPTREND  (4H+1H)" : trend_dir == -1 ? "▼ DOWNTREND (4H+1H)" : "─ NEUTRU (conflict)"
sess_txt   = in_sess ? "✅ Sesiune activa" : "⏸ Afara sesiune"
_fib_dir   = g_dir == 1 ? "BUY" : "SELL"
_fib_hi    = str.tostring(g_hi, "#.##")
_fib_lo    = str.tostring(g_lo, "#.##")
fib_txt    = not na(g_hi) ? _fib_dir + " | Hi: " + _fib_hi + " Lo: " + _fib_lo : "— fara setup —"
trade_txt  = str.tostring(day_trades) + "/" + str.tostring(max_daily) + " trades azi"

table.cell(tbl, 0, 0, trend_txt,  text_color=trend_clr,         text_size=size.small)
table.cell(tbl, 0, 1, sess_txt,   text_color=color.white,       text_size=size.small)
table.cell(tbl, 0, 2, fib_txt,    text_color=color.orange,      text_size=size.small)
table.cell(tbl, 0, 3, trade_txt,  text_color=color.white,       text_size=size.small)
