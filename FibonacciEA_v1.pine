//@version=5
// ============================================================
//  AdiivaGold v4  -  LuxAlgo 3-level CHoCH + MSS Strategy
//
//  Detectie: ST → IT → LT (copiat din LuxAlgo)
//  Fibonacci: FIXED pe swing CHoCH (nu se muta)
//  Nivele:  0.0 / 0.5 / 0.75 / 0.886 / 1.0 / 1.123
//  Entry 1: 0.75  | SL sub/peste 0.886
//  Entry 2: 0.886 | SL sub/peste 1.0  (doar daca E1 SL)
//  TP: RR 1:2  |  Sesiune Londra→NY  |  Max 2 trades/zi
//  Filtru: doar swing-uri >= 1%
// ============================================================
strategy(
  title                  = "AdiivaGold",
  overlay                = true,
  initial_capital        = 10000,
  default_qty_type       = strategy.cash,
  default_qty_value      = 1000,
  commission_type        = strategy.commission.percent,
  commission_value       = 0.01,
  process_orders_on_close = true,
  max_bars_back          = 500)

// ============================================================
// 1. INPUTS
// ============================================================
G_RISK = "Risk Management"
G_FIB  = "Fibonacci"
G_SES  = "Sesiune"
G_VIZ  = "Vizualizare"

rr_ratio   = input.float(2.0,  "RR Ratio",           group=G_RISK, minval=0.5, step=0.5)
fib_e1     = input.float(0.75, "Entry 1 (0.75)",      group=G_FIB,  step=0.001)
fib_e2     = input.float(0.886,"Entry 2 (0.886)",     group=G_FIB,  step=0.001)
sl_buf_tck = input.int(20,     "Buffer SL (ticks)",   group=G_FIB,  minval=1)
min_sw_pct = input.float(1.0,  "Range minim (%)",     group=G_FIB,  minval=0.1, step=0.1)

sess_h_s = input.int(8,  "Start ora Londra",  group=G_SES, minval=0, maxval=23)
sess_m_s = input.int(0,  "Start minut",       group=G_SES, minval=0, maxval=59)
sess_h_e = input.int(21, "Sfarsit ora NY",    group=G_SES, minval=0, maxval=23)
sess_m_e = input.int(0,  "Sfarsit minut",     group=G_SES, minval=0, maxval=59)

C_BULL       = input.color(#089981, "Culoare Bull",       group=G_VIZ)
C_BEAR       = input.color(#f23645, "Culoare Bear",       group=G_VIZ)
show_fib_05  = input.bool(true,     "Arata nivel 0.5",   group=G_VIZ)
show_fib_ref = input.bool(true,     "Linie swing ref",   group=G_VIZ)
show_aoi_box = input.bool(true,     "AOI box",           group=G_VIZ)
choch_style  = input.string("Solid","Stil CHoCH",        group=G_VIZ, options=["Solid","Dashed","Dotted"])
choch_width  = input.int(2,         "Grosime CHoCH",     group=G_VIZ, minval=1, maxval=4)

// ============================================================
// 2. HELPERS
// ============================================================
f_lvl(dir, hi, lo, lvl) => dir == 1 ? hi - lvl*(hi-lo) : lo + lvl*(hi-lo)

ln_s(s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        =>          line.style_dotted

// ============================================================
// 3. DST EU (ora Londra auto)
// ============================================================
_ts31m     = timestamp(year, 3, 31, 12, 0)
_dst_s_day = dayofweek(_ts31m) == 1 ? 31 : 31 - (dayofweek(_ts31m) - 1)
_ts31o     = timestamp(year, 10, 31, 12, 0)
_dst_e_day = dayofweek(_ts31o) == 1 ? 31 : 31 - (dayofweek(_ts31o) - 1)
_is_summer = ((month > 3) or (month == 3  and dayofmonth >= _dst_s_day)) and
             ((month < 10) or (month == 10 and dayofmonth <  _dst_e_day))
_dst_off   = _is_summer ? -60 : 0

// ============================================================
// 4. SESSION + DAILY RESET
// ============================================================
_cm     = hour * 60 + minute
_sess_s = sess_h_s * 60 + sess_m_s + _dst_off
_sess_e = sess_h_e * 60 + sess_m_e
in_sess = _cm >= _sess_s and _cm < _sess_e

var int day_trades = 0
var int last_date  = 0
cur_date   = year * 10000 + month * 100 + dayofmonth
is_new_day = cur_date != last_date
if is_new_day
    day_trades := 0
    last_date  := cur_date

buf_p = sl_buf_tck * syminfo.mintick

// ============================================================
// 5. SWING TYPE — 3 nivele (LuxAlgo)
//    p0=prev  p1=mid(pivot confirmat)  p2=last
// ============================================================
type SW
    float p0 = na
    float p1 = na
    float p2 = na
    int   i0 = na
    int   i1 = na
    int   i2 = na

var SW stL = SW.new()
var SW stH = SW.new()
var SW itL = SW.new()
var SW itH = SW.new()
var SW ltL = SW.new()
var SW ltH = SW.new()

sw_up(SW s, float p, int i) =>
    s.p0 := s.p1,  s.p1 := s.p2,  s.p2 := p
    s.i0 := s.i1,  s.i1 := s.i2,  s.i2 := i

// pivot high: mid > vecini
sw_h(SW s) => not na(s.p0) and s.p0 < s.p1 and s.p1 >= s.p2
// pivot low: mid < vecini
sw_l(SW s) => not na(s.p0) and s.p0 > s.p1 and s.p1 <= s.p2

// ============================================================
// 6. DIRECTIE PIATA LT
// ============================================================
var int  ltDir    = 0   // 1=bull, -1=bear, 0=nedefinit
var bool ltHcross = false
var bool ltLcross = false

// ============================================================
// 7. SETUP ARRAYS (max 5 simultan)
// ============================================================
MAX_S = 5

var float[]  s_hi  = array.new_float(0)
var float[]  s_lo  = array.new_float(0)
var int[]    s_dir = array.new_int(0)
var int[]    s_pb  = array.new_int(0)    // bara pivot (linia CHoCH)
var int[]    s_ab  = array.new_int(0)    // bara ancora
var bool[]   s_e1  = array.new_bool(0)
var bool[]   s_e2  = array.new_bool(0)
var string[] s_id  = array.new_string(0)
var bool[]   s_del = array.new_bool(0)

if is_new_day
    array.clear(s_hi),  array.clear(s_lo),  array.clear(s_dir)
    array.clear(s_pb),  array.clear(s_ab)
    array.clear(s_e1),  array.clear(s_e2)
    array.clear(s_id),  array.clear(s_del)
    day_trades := 0
    ltHcross   := false
    ltLcross   := false

// Verifica daca setup-ul exista deja
setup_dup(hi, lo, dir) =>
    found = false
    n = array.size(s_hi)
    if n > 0
        for i = 0 to n - 1
            if math.abs(array.get(s_hi, i) - hi) < buf_p * 5 and
               math.abs(array.get(s_lo, i) - lo) < buf_p * 5 and
               array.get(s_dir, i) == dir
                found := true
                break
    found

// Adauga setup nou
add_setup(hi, lo, dir, piv_bar, anc_bar) =>
    array.push(s_hi,  hi)
    array.push(s_lo,  lo)
    array.push(s_dir, dir)
    array.push(s_pb,  piv_bar)
    array.push(s_ab,  anc_bar)
    array.push(s_e1,  false)
    array.push(s_e2,  false)
    array.push(s_id,  "")
    array.push(s_del, false)

rem_setup(i) =>
    array.remove(s_hi,  i),  array.remove(s_lo,  i)
    array.remove(s_dir, i),  array.remove(s_pb,  i)
    array.remove(s_ab,  i),  array.remove(s_e1,  i)
    array.remove(s_e2,  i),  array.remove(s_id,  i)
    array.remove(s_del, i)

// ============================================================
// 8. DETECTIE 3 NIVELE — copiat din LuxAlgo
// ============================================================

// NIVEL 1 — Short Term: pattern 3 bare brute
if not na(low[2])
    if low[2] > low[1] and low[1] <= low[0]
        sw_up(stL, low[1], bar_index[1])
if not na(high[2])
    if high[2] < high[1] and high[1] >= high[0]
        sw_up(stH, high[1], bar_index[1])

// NIVEL 2 — Intermediate: pattern din pivotii ST
cITL = sw_l(stL)
if cITL and not cITL[1]
    sw_up(itL, stL.p1, stL.i1)

cITH = sw_h(stH)
if cITH and not cITH[1]
    sw_up(itH, stH.p1, stH.i1)

// NIVEL 3 — Long Term: pattern din pivotii IT
cLTL = sw_l(itL)
if cLTL and not cLTL[1]
    ltLcross := false
    sw_up(ltL, itL.p1, itL.i1)

cLTH = sw_h(itH)
if cLTH and not cLTH[1]
    ltHcross := false
    sw_up(ltH, itH.p1, itH.i1)

// ============================================================
// 9. CHoCH DETECTIE + PLASARE FIB
// ============================================================

// BULL CHoCH: close sparge deasupra ultimului LT high
if not na(ltH.p2) and close > ltH.p2 and not ltHcross
    ltHcross := true
    if ltDir == -1  // era bearish → CHoCH bullish
        ltDir := 1
        // Gaseste lowest low intre ltH.i2 si acum
        lo_v = low
        lo_b = bar_index
        if not na(ltH.i2)
            lim = math.min(bar_index - ltH.i2, 498)
            if lim > 0
                for i = 1 to lim
                    if low[i] < lo_v
                        lo_v := low[i]
                        lo_b := bar_index - i
        // Filtru: range >= 1%
        rng_ok = (ltH.p2 - lo_v) / lo_v >= min_sw_pct / 100.0
        if rng_ok and array.size(s_hi) < MAX_S and not setup_dup(ltH.p2, lo_v, 1)
            add_setup(ltH.p2, lo_v, 1, ltH.i2, lo_b)
            // CHoCH marker (LuxAlgo style)
            line.new(ltH.i2, ltH.p2, bar_index, ltH.p2,
                 color=C_BULL, style=ln_s(choch_style), width=choch_width)
            box.new(ltH.i2, ltH.p2, bar_index, ltH.p2,
                 border_color=color(na), bgcolor=color(na),
                 text="CHoCH", text_size=size.tiny,
                 text_halign=text.align_left, text_valign=text.align_bottom,
                 text_color=color.new(C_BULL, 17))
    else if ltDir == 0
        ltDir := 1

// BEAR CHoCH: close sparge sub ultimul LT low
if not na(ltL.p2) and close < ltL.p2 and not ltLcross
    ltLcross := true
    if ltDir == 1  // era bullish → CHoCH bearish
        ltDir := -1
        // Gaseste highest high intre ltL.i2 si acum
        hi_v = high
        hi_b = bar_index
        if not na(ltL.i2)
            lim = math.min(bar_index - ltL.i2, 498)
            if lim > 0
                for i = 1 to lim
                    if high[i] > hi_v
                        hi_v := high[i]
                        hi_b := bar_index - i
        // Filtru: range >= 1%
        rng_ok = (hi_v - ltL.p2) / ltL.p2 >= min_sw_pct / 100.0
        if rng_ok and array.size(s_hi) < MAX_S and not setup_dup(hi_v, ltL.p2, -1)
            add_setup(hi_v, ltL.p2, -1, ltL.i2, hi_b)
            line.new(ltL.i2, ltL.p2, bar_index, ltL.p2,
                 color=C_BEAR, style=ln_s(choch_style), width=choch_width)
            box.new(ltL.i2, ltL.p2, bar_index, ltL.p2,
                 border_color=color(na), bgcolor=color(na),
                 text="CHoCH", text_size=size.tiny,
                 text_halign=text.align_left, text_valign=text.align_top,
                 text_color=color.new(C_BEAR, 17))
    else if ltDir == 0
        ltDir := -1

// ============================================================
// 10. INVALIDARE SETUP-URI
// ============================================================
if array.size(s_hi) > 0
    i = array.size(s_hi) - 1
    while i >= 0
        _d  = array.get(s_dir, i)
        _hi = array.get(s_hi,  i)
        _lo = array.get(s_lo,  i)
        if (_d == 1 and close < _lo - buf_p) or (_d == -1 and close > _hi + buf_p)
            rem_setup(i)
        i := i - 1

// ============================================================
// 11. DETECTIE INCHIDERE TRADE
// ============================================================
var int prev_cl = 0
if strategy.closedtrades > prev_cl
    for i = prev_cl to strategy.closedtrades - 1
        _eid  = strategy.closedtrades.entry_id(i)
        _prof = strategy.closedtrades.profit(i)
        _exp  = strategy.closedtrades.exit_price(i)
        _dc   = strategy.closedtrades.size(i) > 0 ? 1 : -1
        label.new(bar_index, _dc == 1 ? high : low,
             (_prof >= 0 ? "TP " : "SL ") + str.tostring(_exp, format.mintick),
             color  = _prof >= 0 ? color.new(C_BULL, 10) : color.new(C_BEAR, 10),
             textcolor = color.white,
             style  = _dc == 1 ? label.style_label_down : label.style_label_up,
             size   = size.small)
        if _prof > 0
            ns = array.size(s_id)
            if ns > 0
                for si = 0 to ns - 1
                    if array.get(s_id, si) == _eid
                        array.set(s_del, si, true)
                        break
    prev_cl := strategy.closedtrades

// ============================================================
// 12. ENTRY LOGIC
// ============================================================
n_s = array.size(s_hi)
if in_sess and day_trades < 2 and n_s > 0
    for idx = 0 to n_s - 1
        if day_trades >= 2
            break
        _hi = array.get(s_hi,  idx)
        _lo = array.get(s_lo,  idx)
        _d  = array.get(s_dir, idx)
        _e1 = array.get(s_e1,  idx)
        _e2 = array.get(s_e2,  idx)

        f75  = f_lvl(_d, _hi, _lo, fib_e1)
        f886 = f_lvl(_d, _hi, _lo, fib_e2)
        f100 = f_lvl(_d, _hi, _lo, 1.0)

        // ── ENTRY 1 @ 0.75 — fill la atingerea nivelului ────
        if not _e1 and day_trades < 2
            if _d == 1 and low <= f75 and close > f886
                sl  = f886 - buf_p
                tp  = f75 + math.abs(f75 - sl) * rr_ratio
                eid = "E1L_" + str.tostring(idx)
                strategy.entry(eid, strategy.long,  limit=f75, comment="E1 BUY @" + str.tostring(f75, format.mintick))
                strategy.exit("X" + eid, eid, stop=sl, limit=tp)
                array.set(s_e1, idx, true)
                array.set(s_id, idx, eid)
                day_trades := day_trades + 1
                label.new(bar_index, low,
                     "E1 BUY\n" + str.tostring(f75, format.mintick),
                     color=color.new(C_BULL,10), textcolor=color.white,
                     style=label.style_label_up, size=size.small)

            else if _d == -1 and high >= f75 and close < f886
                sl  = f886 + buf_p
                tp  = f75 - math.abs(sl - f75) * rr_ratio
                eid = "E1S_" + str.tostring(idx)
                strategy.entry(eid, strategy.short, limit=f75, comment="E1 SELL @" + str.tostring(f75, format.mintick))
                strategy.exit("X" + eid, eid, stop=sl, limit=tp)
                array.set(s_e1, idx, true)
                array.set(s_id, idx, eid)
                day_trades := day_trades + 1
                label.new(bar_index, high,
                     "E1 SELL\n" + str.tostring(f75, format.mintick),
                     color=color.new(C_BEAR,10), textcolor=color.white,
                     style=label.style_label_down, size=size.small)

        // ── ENTRY 2 @ 0.886 — fill la atingere (doar daca E1 SL) ──
        if not _e2 and _e1 and day_trades < 2
            if _d == 1 and low <= f886 and close > f100
                sl  = f100 - buf_p
                tp  = f886 + math.abs(f886 - sl) * rr_ratio
                eid = "E2L_" + str.tostring(idx)
                strategy.entry(eid, strategy.long,  limit=f886, comment="E2 BUY @" + str.tostring(f886, format.mintick))
                strategy.exit("X" + eid, eid, stop=sl, limit=tp)
                array.set(s_e2, idx, true)
                day_trades := day_trades + 1
                label.new(bar_index, low,
                     "E2 BUY\n" + str.tostring(close, format.mintick),
                     color=color.new(C_BULL,10), textcolor=color.white,
                     style=label.style_label_up, size=size.small)

            else if _d == -1 and high >= f886 and close < f100
                sl  = f100 + buf_p
                tp  = f886 - math.abs(sl - f886) * rr_ratio
                eid = "E2S_" + str.tostring(idx)
                strategy.entry(eid, strategy.short, limit=f886, comment="E2 SELL @" + str.tostring(f886, format.mintick))
                strategy.exit("X" + eid, eid, stop=sl, limit=tp)
                array.set(s_e2, idx, true)
                day_trades := day_trades + 1
                label.new(bar_index, high,
                     "E2 SELL\n" + str.tostring(close, format.mintick),
                     color=color.new(C_BEAR,10), textcolor=color.white,
                     style=label.style_label_down, size=size.small)

// ============================================================
// 13. CURATARE SETUP
// ============================================================
if array.size(s_hi) > 0
    i = array.size(s_hi) - 1
    while i >= 0
        if array.get(s_del, i) or (array.get(s_e1, i) and array.get(s_e2, i))
            rem_setup(i)
        i := i - 1

// ============================================================
// 14. VIZUALIZARE (stil LuxAlgo)
// ============================================================
bgcolor(in_sess ? color.new(color.blue, 95) : na, title="Sesiune")

var line[]  vl = array.new_line(0)
var label[] vb = array.new_label(0)
var box[]   vx = array.new_box(0)

// Sterge obiectele dinamice din bara anterioara
if array.size(vl) > 0
    for i = 0 to array.size(vl) - 1
        line.delete(array.get(vl, i))
array.clear(vl)

if array.size(vb) > 0
    for i = 0 to array.size(vb) - 1
        label.delete(array.get(vb, i))
array.clear(vb)

if array.size(vx) > 0
    for i = 0 to array.size(vx) - 1
        box.delete(array.get(vx, i))
array.clear(vx)

nd = array.size(s_hi)
if nd > 0
    for idx = 0 to nd - 1
        _hi = array.get(s_hi,  idx)
        _lo = array.get(s_lo,  idx)
        _d  = array.get(s_dir, idx)
        _pb = array.get(s_pb,  idx)
        _ab = array.get(s_ab,  idx)

        f0   = f_lvl(_d, _hi, _lo, 0.0)
        f05  = f_lvl(_d, _hi, _lo, 0.5)
        f75  = f_lvl(_d, _hi, _lo, fib_e1)
        f886 = f_lvl(_d, _hi, _lo, fib_e2)
        f1   = f_lvl(_d, _hi, _lo, 1.0)
        f112 = f_lvl(_d, _hi, _lo, 1.123)
        ext  = bar_index + 40
        c    = _d == 1 ? C_BULL : C_BEAR

        // Linie diagonala swing (ancora→pivot)
        if show_fib_ref
            array.push(vl, line.new(
                 _ab, _d == 1 ? _lo : _hi,
                 _pb, _d == 1 ? _hi : _lo,
                 color=color.new(c, 55), style=line.style_dashed, width=1))

        // AOI box (0.0 → 0.886)
        if show_aoi_box
            zt = _d == 1 ? f0 : f886
            zb = _d == 1 ? f886 : f0
            array.push(vx, box.new(_pb, zt, ext, zb,
                 bgcolor=color.new(c, 89), border_color=color(na)))

        // 0.0 — solid
        array.push(vl, line.new(_pb, f0, ext, f0,
             color=c, style=line.style_solid, width=2))
        array.push(vb, label.new(ext, f0,
             "0 · " + str.tostring(f0, format.mintick),
             color=color(na), textcolor=c,
             style=label.style_label_left, size=size.small))

        // 0.5 — optional
        if show_fib_05
            array.push(vl, line.new(_pb, f05, ext, f05,
                 color=color.new(c, 55), style=line.style_dotted, width=1))
            array.push(vb, label.new(ext, f05,
                 "0.5 · " + str.tostring(f05, format.mintick),
                 color=color(na), textcolor=color.new(c, 40),
                 style=label.style_label_left, size=size.small))

        // 0.75 — Entry 1 (portocaliu)
        array.push(vl, line.new(_pb, f75, ext, f75,
             color=color.orange, style=line.style_dashed, width=2))
        array.push(vb, label.new(ext, f75,
             "0.75 · " + str.tostring(f75, format.mintick),
             color=color(na), textcolor=color.orange,
             style=label.style_label_left, size=size.small))

        // 0.886 — SL E1 / Entry 2
        array.push(vl, line.new(_pb, f886, ext, f886,
             color=color.new(C_BEAR, 20), style=line.style_dotted, width=2))
        array.push(vb, label.new(ext, f886,
             "0.886 · " + str.tostring(f886, format.mintick),
             color=color(na), textcolor=color.new(C_BEAR, 10),
             style=label.style_label_left, size=size.small))

        // 1.0 — ancora, solid
        array.push(vl, line.new(_ab, f1, ext, f1,
             color=c, style=line.style_solid, width=2))
        array.push(vb, label.new(ext, f1,
             "1 · " + str.tostring(f1, format.mintick),
             color=color(na), textcolor=c,
             style=label.style_label_left, size=size.small))

        // 1.123 — SL E2
        array.push(vl, line.new(_ab, f112, ext, f112,
             color=color.new(C_BEAR, 60), style=line.style_dotted, width=1))
        array.push(vb, label.new(ext, f112,
             "1.123 · " + str.tostring(f112, format.mintick),
             color=color(na), textcolor=color.new(C_BEAR, 40),
             style=label.style_label_left, size=size.small))

// ============================================================
// 15. STATUS TABLE
// ============================================================
var table tbl = table.new(position.top_right, 1, 5,
     bgcolor=color.new(color.black, 75),
     border_color=color.new(color.gray, 60), border_width=1)

_n  = array.size(s_hi)
_bu = 0
_be = 0
if _n > 0
    for i = 0 to _n - 1
        if array.get(s_dir, i) == 1
            _bu := _bu + 1
        else
            _be := _be + 1

table.cell(tbl, 0, 0,
     _n == 0 ? "MSS: ASTEPTAM" : "MSS ▲:" + str.tostring(_bu) + "  ▼:" + str.tostring(_be),
     text_color = _n == 0 ? color.gray : _bu > _be ? C_BULL : C_BEAR,
     text_size  = size.small)
table.cell(tbl, 0, 1, in_sess ? "Sesiune activa" : "Afara sesiunii",
     text_color=color.white,  text_size=size.small)
table.cell(tbl, 0, 2, str.tostring(_n) + " setup-uri active",
     text_color=color.orange, text_size=size.small)
table.cell(tbl, 0, 3, str.tostring(day_trades) + "/2 trades azi",
     text_color=color.white,  text_size=size.small)
table.cell(tbl, 0, 4, _is_summer ? "BST UTC+1" : "GMT UTC+0",
     text_color=_is_summer ? color.yellow : color.new(color.white, 40),
     text_size=size.tiny)
